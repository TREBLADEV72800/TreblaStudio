---
import { businessTypes, businessCategories, featuresByType, pageOptions, socialPlatforms, siteExtrasAll, socialExtrasAll, designExtrasAll, photoPrices, socialNeedsList, designNeedsList, socialByType, designByType, goals, whatsapp } from '../data/configuratore.js';
const CFG = { businessTypes, businessCategories, featuresByType, pageOptions, socialPlatforms, siteExtrasAll, socialExtrasAll, designExtrasAll, photoPrices, socialNeedsList, designNeedsList, socialByType, designByType, goals, whatsapp };
---
<section id="cx-root" aria-label="Domande preventivo">
  <div class="cx-appbar">
    <p class="cx-kicker">La tua proposta</p>
    <span id="cx-step">Domanda 1</span>
    <span id="cx-pill" aria-live="polite">€ 0</span>
  </div>
  <div class="cx-bar" aria-hidden="true"><div id="cx-fill"></div></div>
  <div id="cx-chat"></div>
  <div id="cx-dock"></div>
  <div class="cx-nav">
    <button type="button" class="button button-quiet" id="cx-back" style="display:none">← Torna indietro</button>
    <p class="cx-muted" id="cx-hint" aria-live="polite"></p>
  </div>
</section>

<script define:vars={{ CFG }}>
const { businessTypes, businessCategories, featuresByType, pageOptions, socialPlatforms, siteExtrasAll, socialExtrasAll, designExtrasAll, photoPrices, socialNeedsList, designNeedsList, socialByType, designByType, goals, whatsapp } = CFG;

/* Stato unico della conversazione */
const S = { name:'', type:'', typeOther:'', services:[], structure:'', features:[], pages:[], photos:'', plats:[], needs:[], mats:[], goals:[], timing:'', notes:'', privacy:false };
let idx = 0, revealed = false, revealAt = 0, sent = false;

const $ = (id) => document.getElementById(id);
const has = (s) => S.services.includes(s);
const altro = () => S.type === 'Altro';
const names = (l) => (l || []).map((x) => (typeof x === 'string' ? x : x.name));
const siteFeats = () => [...(featuresByType[S.type] || []), ...siteExtrasAll];
const socialNeeds = () => [...(socialByType[S.type] || socialNeedsList), ...socialExtrasAll];
const designNeeds = () => [...(designByType[S.type] || designNeedsList), ...designExtrasAll];
const euro = (p) => (p ? ' (+' + p + ' €)' : '');
const okName = () => S.name.trim().length >= 2;
const okType = () => !!S.type && (!altro() || S.typeOther.trim().length >= 2);
const typeLabel = () => (!S.type ? '' : (S.type === 'Altro' && S.typeOther.trim() ? 'Altro (' + S.typeOther.trim() + ')' : S.type));
const svcName = (id) => (id === 'site' ? 'Sito Web' : id === 'social' ? 'Social Media' : 'Design e Grafiche');
const focusIt = (e2) => { if (e2 && e2.focus) { try { e2.focus({ preventScroll: true }); } catch (err) { try { e2.focus(); } catch (e3) {} } } };

/* Percorso: solo le domande utili in base alle risposte */
function flow() {
  const f = ['name', 'type', 'services'];
  if (has('site')) {
    if (!altro()) f.push('struct');
    f.push('feats');
    if (S.structure === 'Sito completo a più pagine') f.push('pages');
    if (!altro()) f.push('photos');
  }
  if (has('social')) f.push('plats', 'needs');
  if (has('design')) f.push('mats');
  if (!altro()) f.push('goals');
  f.push('timing', 'notes', 'review');
  return f;
}

function total() {
  let t = 0;
  if (has('site')) {
    t = S.structure === 'Sito completo a più pagine' ? 400 : 350;
    const fl = siteFeats();
    S.features.forEach((n) => { const f = fl.find((x) => x.name === n); if (f) t += f.price; });
    S.pages.forEach((n) => { const p = pageOptions.find((x) => x.name === n); if (p) t += p.price; });
    if (!altro() && S.photos && photoPrices[S.photos]) t += photoPrices[S.photos];
  }
  if (has('social')) {
    const nl = socialNeeds();
    S.needs.forEach((n) => { const f = nl.find((x) => x.name === n); if (f) t += f.price; });
  }
  if (has('design')) {
    const dl = designNeeds();
    S.mats.forEach((n) => { const f = dl.find((x) => x.name === n); if (f) t += f.price; });
  }
  return Math.max(0, Math.round(t));
}

function missing() {
  const m = [];
  if (!okName()) m.push("il nome della tua attività");
  if (!okType()) m.push('il tipo di attività');
  if (!S.services.length) m.push('un servizio (Sito, Social o Design)');
  if (has('site') && !altro() && !S.structure) m.push('la struttura del sito');
  if (has('site') && !altro() && !S.photos) m.push('le foto');
  if (has('social') && !(S.plats.length && S.needs.length)) m.push('le scelte Social Media');
  if (has('design') && !S.mats.length) m.push('i materiali grafici');
  if (!altro() && !S.goals.length) m.push('un obiettivo');
  if (!S.timing) m.push('i tempi desiderati');
  return m;
}

const NODES = {
  name: { q: 'Come si chiama la tua attività?', ok: okName },
  type: { q: 'Che tipo di attività è?', ok: okType },
  services: { q: 'Di cosa hai bisogno? Puoi scegliere più cose.', ok: () => S.services.length > 0 },
  struct: { q: 'Meglio una pagina singola (350 €) o un sito completo a più pagine (400 €)?', ok: () => !!S.structure },
  feats: { q: 'Quali funzioni servono sul sito? Solo se utili, altrimenti vai avanti.', ok: () => true },
  pages: { q: 'Quali pagine vuoi nel sito? Solo se utili.', ok: () => true },
  photos: { q: 'E le foto da mettere sul sito?', ok: () => !!S.photos },
  plats: { q: 'Su quali canali pubblichiamo?', ok: () => S.plats.length > 0 },
  needs: { q: () => 'Cosa prepariamo per i tuoi social' + (S.type ? ' (' + S.type + ')' : '') + '?', ok: () => S.needs.length > 0 },
  mats: { q: () => 'Quali materiali grafici ti servono' + (S.type ? ' (' + S.type + ')' : '') + '?', ok: () => S.mats.length > 0 },
  goals: { q: 'Cosa vuoi ottenere soprattutto?', ok: () => S.goals.length > 0 },
  timing: { q: 'Quando vorresti iniziare?', ok: () => !!S.timing },
  notes: { q: 'Vuoi aggiungere note? Colori, esempi, esigenze particolari.', ok: () => true },
  review: { q: 'Ecco il riepilogo! Controlla e invia.', ok: () => true },
};
const ask = (id) => (typeof NODES[id].q === 'function' ? NODES[id].q() : NODES[id].q);

/* Costruttori */
function el(tag, cls, text) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text !== undefined) e.textContent = text;
  return e;
}
function paint(b, on) { b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on)); }
function flip(arr, k) { const i = arr.indexOf(k); if (i >= 0) arr.splice(i, 1); else arr.push(k); return i < 0; }
function chip(key, label, on, extra) {
  const b = el('button', 'cx-chip' + (on ? ' on' : ''));
  b.type = 'button'; b.textContent = label;
  b.setAttribute('data-k', key);
  if (extra) Object.entries(extra).forEach(([a, v]) => b.setAttribute(a, v));
  b.setAttribute('aria-pressed', String(!!on));
  return b;
}
function goBtn(label) {
  const b = el('button', 'button button-main cx-go', label || 'Continua →');
  b.type = 'button'; b.setAttribute('data-act', 'go');
  return b;
}
function allBtn() {
  const b = el('button', 'cx-all', 'Seleziona tutto');
  b.type = 'button'; b.setAttribute('data-act', 'all');
  return b;
}
function setType(t) {
  S.type = t; S.features = []; S.pages = [];
  const sv = new Set(names(socialNeeds())), dv = new Set(names(designNeeds()));
  S.needs = S.needs.filter((n) => sv.has(n));
  S.mats = S.mats.filter((n) => dv.has(n));
}
function packLabel() {
  return ['site', 'social', 'design'].every((x) => S.services.includes(x)) ? '✓ Pacchetto completo selezionato' : 'Pacchetto completo: Sito + Social + Design';
}

/* Una domanda per pagina: solo la domanda corrente, niente cronologia */
function renderChat(f) {
  const chat = $('cx-chat');
  chat.innerHTML = '';
  chat.appendChild(el('p', 'cx-q', ask(f[idx])));
}

function catsInto(box) {
  box.innerHTML = '';
  Object.entries(businessCategories).forEach(([cat, types]) => {
    const d = document.createElement('details');
    if (types.includes(S.type)) d.open = true;
    const sm = document.createElement('summary'); sm.textContent = cat + ', ' + types.length;
    d.appendChild(sm);
    const g = el('div', 'cx-chips');
    types.forEach((t) => {
      const b = chip(t, t, S.type === t, { 'data-t': t });
      if (t === 'Professionista') b.innerHTML = '<span style="font-weight:700">Professionista</span><span style="font-weight:400;margin-left:6px;color:var(--muted)">, geometra, commercialista...</span>';
      g.appendChild(b);
    });
    d.appendChild(g); box.appendChild(d);
  });
}

function renderDock(id) {
  const dock = $('cx-dock');
  dock.innerHTML = '';
  if (id === 'name') {
    const w = el('div', 'cx-line');
    const inp = document.createElement('input');
    inp.id = 'cx-name'; inp.placeholder = 'Es. Pasticceria Rossi'; inp.maxLength = 80;
    inp.setAttribute('aria-label', 'Nome della tua attività'); inp.autocomplete = 'organization';
    inp.value = S.name;
    inp.addEventListener('input', () => {
      const v = inp.value.slice(0, 80);
      if (inp.value !== v) inp.value = v;
      S.name = v; update(false);
    });
    inp.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); goNext(); } });
    w.appendChild(inp); w.appendChild(goBtn('Avanti →')); dock.appendChild(w);
    setTimeout(() => focusIt(inp), 60);
  } else if (id === 'type') {
    const s = document.createElement('input');
    s.id = 'cx-search'; s.placeholder = 'Cerca... (es. pizzeria, barbiere)'; s.autocomplete = 'off';
    s.setAttribute('aria-label', 'Cerca tipo attività');
    s.addEventListener('input', () => {
      const q = s.value.trim().toLowerCase();
      const res = $('cx-results'), cats = $('cx-cats'), a = $('cx-altro');
      if (!q) { res.style.display = 'none'; res.innerHTML = ''; cats.style.display = 'block'; a.style.display = ''; catsInto(cats); return; }
      res.style.display = 'flex'; cats.style.display = 'none'; a.style.display = 'none';
      res.innerHTML = '';
      businessTypes.filter((t) => t.toLowerCase().includes(q)).forEach((t) => {
        const b = chip(t, t, S.type === t, { 'data-t': t });
        res.appendChild(b);
      });
      if (!res.children.length) {
        const p = el('p', 'cx-muted', 'Nessun risultato per questa ricerca.');
        const b = el('button', 'cx-all', 'Usa “Altro” e descrivi la tua attività');
        b.type = 'button'; b.setAttribute('data-act', 'altro');
        res.appendChild(p); res.appendChild(b);
      }
    });
    const res = el('div', 'cx-chips'); res.id = 'cx-results'; res.style.display = 'none';
    const cats = el('div'); cats.id = 'cx-cats';
    catsInto(cats);
    const a = el('button', 'cx-chip', 'Altro');
    a.type = 'button'; a.id = 'cx-altro'; a.setAttribute('data-act', 'altro');
    paint(a, false);
    const ow = el('label', 'cx-other');
    ow.id = 'cx-other-wrap'; ow.setAttribute('for', 'cx-other');
    ow.style.display = S.type === 'Altro' ? 'block' : 'none';
    ow.appendChild(el('span', '', 'Che attività fai? Descrivici la tua attività'));
    const oi = document.createElement('input');
    oi.id = 'cx-other'; oi.placeholder = 'Es. venditori ambulanti, associazione...'; oi.maxLength = 80; oi.value = S.typeOther;
    oi.addEventListener('input', () => {
      const v = oi.value.slice(0, 80);
      if (oi.value !== v) oi.value = v;
      S.typeOther = v; update(false);
    });
    oi.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); goNext(); } });
    ow.appendChild(oi);
    const c = goBtn('Continua →');
    dock.appendChild(s); dock.appendChild(res); dock.appendChild(cats); dock.appendChild(a); dock.appendChild(ow); dock.appendChild(c);
  } else if (id === 'services') {
    const g = el('div', 'cx-cards');
    [['site', 'Sito Web', 'Presenza online completa e veloce su tutti i dispositivi.'], ['social', 'Social Media', 'Profili, pubblicazioni e grafiche su misura.'], ['design', 'Design e Grafiche', 'Logo, locandine, volantini e materiali coordinati.']].forEach(([v, t, d]) => {
      const b = el('button', 'cx-card' + (S.services.includes(v) ? ' on' : ''));
      b.type = 'button'; b.setAttribute('data-s', v); b.setAttribute('aria-pressed', String(S.services.includes(v)));
      const ic = el('span', '', S.services.includes(v) ? '✓' : '+'); ic.setAttribute('aria-hidden', 'true');
      b.appendChild(ic); b.appendChild(el('b', '', t)); b.appendChild(el('small', '', d));
      g.appendChild(b);
    });
    const pk = el('button', 'cx-all', packLabel());
    pk.type = 'button'; pk.id = 'cx-pack'; pk.setAttribute('data-act', 'pack');
    dock.appendChild(g); dock.appendChild(pk); dock.appendChild(goBtn('Continua →'));
  } else if (id === 'struct' || id === 'photos' || id === 'timing') {
    const opts = id === 'struct'
      ? [['Pagina singola', 'Pagina singola (350 €)'], ['Sito completo a più pagine', 'Sito completo a più pagine (400 €)']]
      : id === 'photos'
      ? [['Ho già le foto', 'Ho già le foto (le invio io)'], ['Servono le foto (le scattate voi)', 'Scattate voi sul posto (+40 €)'], ['Parto da zero', 'Archivio immagini (+10 €)']]
      : [['Appena possibile', 'Appena possibile'], ['Entro un mese', 'Entro un mese'], ['Sto valutando', 'Sto valutando']];
    const cur = id === 'struct' ? S.structure : id === 'photos' ? S.photos : S.timing;
    const g = el('div', 'cx-chips');
    opts.forEach(([v, l]) => {
      const b = chip(v, l, cur === v, { 'data-g': id });
      g.appendChild(b);
    });
    dock.appendChild(g);
  } else if (id === 'feats' || id === 'pages' || id === 'plats' || id === 'needs' || id === 'mats' || id === 'goals') {
    const conf = id === 'feats' ? { list: siteFeats(), arr: S.features, g: 'feats', priced: true }
      : id === 'pages' ? { list: pageOptions, arr: S.pages, g: 'pages', priced: true }
      : id === 'plats' ? { list: socialPlatforms.map((p) => ({ name: p, price: 0 })), arr: S.plats, g: 'plats', priced: false }
      : id === 'needs' ? { list: socialNeeds(), arr: S.needs, g: 'needs', priced: true }
      : id === 'mats' ? { list: designNeeds(), arr: S.mats, g: 'mats', priced: true }
      : { list: goals.map((x) => ({ name: x, price: 0 })), arr: S.goals, g: 'goals', priced: false };
    const g = el('div', 'cx-chips');
    conf.list.forEach((f) => {
      const b = chip(f.name, f.name + (conf.priced ? euro(f.price) : ''), conf.arr.includes(f.name), { 'data-g': conf.g });
      g.appendChild(b);
    });
    dock.appendChild(g);
    const al = allBtn(); al.setAttribute('data-g', conf.g);
    dock.appendChild(al);     dock.appendChild(goBtn());
  } else if (id === 'notes') {
    const t = document.createElement('textarea');
    t.id = 'cx-notes'; t.rows = 3; t.maxLength = 800;
    t.placeholder = 'Es. vorrei prenotazioni online e colori chiari... (facoltativo)';
    t.setAttribute('aria-label', 'Note per il progetto'); t.value = S.notes;
    t.addEventListener('input', () => {
      const v = t.value.slice(0, 800);
      if (t.value !== v) t.value = v;
      S.notes = v;
    });
    const row = el('div', 'cx-line');
    const skip = el('button', 'button button-quiet', 'Salta');
    skip.type = 'button'; skip.setAttribute('data-act', 'skip');
    row.appendChild(t); dock.appendChild(row);
    const btns = el('div', 'cx-line');
    btns.appendChild(skip); btns.appendChild(goBtn());
    dock.appendChild(btns);
  } else if (id === 'review') {
    const sum = el('div', 'cx-sum');
    const r2 = (k, v) => {
      if (!v) return;
      const r = el('div', 'cx-row');
      r.appendChild(el('strong', '', k)); r.appendChild(el('span', '', v));
      sum.appendChild(r);
    };
    r2('Attività', S.name + (typeLabel() ? ' · ' + typeLabel() : ''));
    r2('Servizi', S.services.map(svcName).join(' + '));
    if (has('site') && !altro()) {
      r2('Sito', S.structure || 'Da definire');
      if (S.features.length) r2('Funzioni', S.features.length + ' selezionate');
      if (S.pages.length) r2('Pagine', S.pages.length + ' selezionate');
      if (S.photos) r2('Foto', S.photos);
    }
    if (has('social')) r2('Social', (S.plats.join(', ') || 'Canali da decidere') + ' · ' + S.needs.length + ' contenuti');
    if (has('design') && S.mats.length) r2('Design', S.mats.length + ' materiali');
    if (!altro() && S.goals.length) r2('Obiettivi', S.goals.join(', '));
    r2('Tempi', S.timing || 'Da definire');
    dock.appendChild(sum);
    const pv = el('label', 'cx-priv');
    pv.setAttribute('for', 'cx-privacy');
    const cb = document.createElement('input');
    cb.type = 'checkbox'; cb.id = 'cx-privacy'; cb.checked = S.privacy;
    cb.addEventListener('change', () => { S.privacy = cb.checked; update(true); });
    pv.appendChild(cb); pv.appendChild(el('span', '', 'Ho letto l’informativa privacy e acconsento al trattamento dei dati per ricevere il preventivo. *'));
    dock.appendChild(pv);
    const box = el('div', 'cx-total');
    const left = el('div', '');
    const k = el('span', '', 'Preventivo'), v = el('strong', '', 'Completa i campi'), d = el('p', '', 'Manca il consenso privacy.');
    k.id = 'cx-total-k'; v.id = 'cx-total-v'; d.id = 'cx-total-d';
    left.appendChild(k); left.appendChild(v); left.appendChild(d);
    box.appendChild(left);
    const show = el('button', 'wa-cta', 'Mostra il totale');
    show.type = 'button'; show.id = 'cx-show'; show.style.display = 'none'; show.setAttribute('data-act', 'show');
    const sendA = el('a', 'wa-cta', 'Scrivici su WhatsApp');
    sendA.id = 'cx-send'; sendA.target = '_blank'; sendA.rel = 'noopener noreferrer';
    sendA.href = 'https://wa.me/393518924471?text=' + encodeURIComponent('Ciao Trebla! Non so cosa scegliere per il preventivo, mi aiutate su WhatsApp?');
    box.appendChild(show); box.appendChild(sendA);
    dock.appendChild(box);
    const done = el('div', 'cx-sent'); done.id = 'cx-sent'; done.style.display = sent ? 'block' : 'none';
    if (sent) done.innerHTML = '<strong>Grazie, richiesta inviata su WhatsApp.</strong><p>Ti interessa anche un evento di inaugurazione con musica dal vivo? <a href="/eventi">Vedi Eventi →</a></p>';
    dock.appendChild(done);
    estimate();
  }
  refreshAllLink();
}

/* Router centrale: UN solo listener, registrato una volta */
function onDock(e) {
  const t = e.target, b = t && t.closest ? t.closest('button') : null;
  if (!b || !$('cx-dock').contains(b)) return;
  const id = flow()[idx];
  const tv = b.getAttribute('data-t');
  if (tv) {
    setType(tv);
    if (tv === 'Altro') {
      const s = $('cx-search');
      if (s) s.value = '';
      update(true);
      focusIt($('cx-other'));
    } else {
      update(true); goNext();
    }
    return;
  }
  if (b.getAttribute('data-act') === 'altro') {
    setType('Altro');
    const s = $('cx-search');
    if (s) s.value = '';
    update(true); focusIt($('cx-other'));
    return;
  }
  if (b.hasAttribute('data-s')) {
    const v = b.getAttribute('data-s');
    flip(S.services, v);
    const on = S.services.includes(v);
    b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on));
    const ic = b.querySelector('span'); if (ic) ic.textContent = on ? '✓' : '+';
    const pk = $('cx-pack'); if (pk) pk.textContent = packLabel();
    update(false);
    return;
  }
  if (b.getAttribute('data-act') === 'pack') {
    S.services = ['site', 'social', 'design'].every((x) => S.services.includes(x)) ? [] : ['site', 'social', 'design'];
    update(true);
    return;
  }
  if (b.getAttribute('data-act') === 'all') {
    const g = b.getAttribute('data-g');
    const arr = g === 'feats' ? S.features : g === 'pages' ? S.pages : g === 'plats' ? S.plats : g === 'needs' ? S.needs : g === 'mats' ? S.mats : S.goals;
    const list = g === 'feats' ? siteFeats() : g === 'pages' ? pageOptions : g === 'plats' ? socialPlatforms.map((p) => ({ name: p })) : g === 'needs' ? socialNeeds() : g === 'mats' ? designNeeds() : goals.map((x) => ({ name: x }));
    if (!list.length) return;
    const full = arr.length >= list.length;
    arr.length = 0;
    if (!full) names(list).forEach((x) => arr.push(x));
    update(true);
    return;
  }
  if (b.getAttribute('data-act') === 'go') { goNext(); return; }
  if (b.getAttribute('data-act') === 'skip') { idx++; update(true); return; }
  if (b.getAttribute('data-act') === 'show') {
    if (!missing().length && S.privacy) { revealAt = Date.now(); revealed = true; update(true); }
    return;
  }
  if (b.id === 'cx-send' && revealed) {
    e.preventDefault();
    if (Date.now() - revealAt < 1000) return;
    send();
    return;
  }
  if (b.hasAttribute('data-k')) {
    const g = b.getAttribute('data-g'), k = b.getAttribute('data-k');
    if (g === 'struct') {
      S.structure = k;
      if (k === 'Pagina singola') S.pages = [];
      update(true); goNext(); return;
    }
    if (g === 'photos') { S.photos = k; update(true); goNext(); return; }
    if (g === 'timing') { S.timing = k; update(true); goNext(); return; }
    const arr = g === 'feats' ? S.features : g === 'pages' ? S.pages : g === 'plats' ? S.plats : g === 'needs' ? S.needs : g === 'mats' ? S.mats : S.goals;
    paint(b, flip(arr, k));
    refreshAllInDock(g);
    update(false);
  }
}
function refreshAllInDock(g) {
  const map = { feats: () => ({ n: names(siteFeats()), a: S.features }), pages: () => ({ n: names(pageOptions), a: S.pages }), needs: () => ({ n: names(socialNeeds()), a: S.needs }), mats: () => ({ n: names(designNeeds()), a: S.mats }), goals: () => ({ n: [...goals], a: S.goals }) };
  if (!map[g]) return;
  const d = map[g]();
  document.querySelectorAll('#cx-dock [data-act="all"]').forEach((x) => {
    x.textContent = d.n.length > 0 && d.a.length >= d.n.length ? 'Deseleziona tutto' : 'Seleziona tutto';
  });
}
function refreshAllLink() {
  document.querySelectorAll('#cx-dock [data-all]').forEach(() => {});
  refreshAllInDock('feats'); refreshAllInDock('pages'); refreshAllInDock('needs'); refreshAllInDock('mats'); refreshAllInDock('goals');
}

/* Navigazione */
function goNext() {
  const f = flow();
  if (NODES[f[idx]].ok()) { idx = Math.min(f.length - 1, idx + 1); update(true); }
  else hint('Rispondi alla domanda per continuare.');
}
function hint(t) { $('cx-hint').textContent = t || ''; }

/* Box totale */
function estimate() {
  const v = $('cx-total-v');
  if (!v) return;
  const k = $('cx-total-k'), d = $('cx-total-d'), show = $('cx-show'), sendA = $('cx-send');
  if (revealed) {
    k.textContent = 'Totale indicativo'; v.textContent = '€ ' + total(); d.textContent = 'Prezzo concordato insieme prima di iniziare.';
    show.style.display = 'none'; sendA.style.display = 'flex'; sendA.textContent = 'Invia su WhatsApp';
    sendA.href = 'https://wa.me/' + whatsapp + '?text=' + encodeURIComponent(buildMsg());
  } else {
    const m = missing(), ok = !m.length && S.privacy;
    k.textContent = 'Preventivo'; v.textContent = ok ? 'Pronto' : 'Completa i campi';
    d.textContent = !S.privacy ? 'Manca il consenso privacy.' : ok ? 'Hai risposto a tutto.' : 'Manca: ' + m.join(', ') + '.';
    show.style.display = ok ? 'flex' : 'none';
    sendA.style.display = ok ? 'none' : 'flex'; sendA.textContent = 'Scrivici su WhatsApp';
    sendA.href = 'https://wa.me/393518924471?text=' + encodeURIComponent('Ciao Trebla! Non so cosa scegliere per il preventivo, mi aiutate su WhatsApp?');
  }
}

/* Messaggio WhatsApp */
function buildMsg() {
  const L = ['*Ciao Trebla Studio!*', 'Vorrei richiedere un preventivo per la mia attività.', '', '━━━━━━━━━━━━━━━━━━━', '*DATI ATTIVITÀ*', '• *Nome:* ' + (S.name || 'Non specificato'), '• *Settore:* ' + (S.type === 'Altro' && S.typeOther.trim() ? 'Altro (' + S.typeOther.trim() + ')' : S.type), '• *Servizi scelti:* ' + S.services.map(svcName).join(' + '), '━━━━━━━━━━━━━━━━━━━'];
  if (has('site')) {
    L.push('', '*SITO WEB*', '• *Struttura:* ' + (S.structure || 'Da definire insieme'));
    if (altro()) L.push('• *Esigenze specifiche:* da definire insieme');
    else L.push('• *Funzioni:* ' + (S.features.length ? S.features.join(', ') : 'Standard'), '• *Pagine:* ' + (S.pages.length ? S.pages.join(', ') : 'Standard'), '• *Foto:* ' + S.photos);
  }
  if (has('social')) L.push('', '*SOCIAL MEDIA*', '• *Canali:* ' + (S.plats.join(', ') || 'Da decidere'), '• *Opzioni:* ' + (S.needs.join(', ') || 'Da decidere'));
  if (has('design')) L.push('', '*DESIGN & GRAFICHE*', '• *Materiali:* ' + (S.mats.join(', ') || 'Da decidere'));
  L.push('', '━━━━━━━━━━━━━━━━━━━', '*PIANIFICAZIONE*');
  if (!altro()) L.push('• *Obiettivi:* ' + S.goals.join(', '));
  L.push('• *Tempi desiderati:* ' + (S.timing || 'Da definire'), '', '*TOTALE INDICATIVO:* ' + total() + ' €', '━━━━━━━━━━━━━━━━━━━');
  if (S.notes && S.notes.trim()) L.push('', '*NOTE AGGIUNTIVE:*', S.notes.trim());
  let msg = L.join('\n');
  if (msg.length > 1800) msg = msg.slice(0, 1780) + '\n... (testo troncato)';
  return msg;
}
function send() {
  if (!S.services.length) { alert('Seleziona almeno un servizio (Sito, Social o Design).'); return; }
  window.open('https://wa.me/' + whatsapp + '?text=' + encodeURIComponent(buildMsg()), '_blank', 'noopener,noreferrer');
  sent = true;
  update(true);
}

/* Update: full = ricostruisce chat+dock; chrome sempre */
function update(full) {
  const f = flow();
  if (idx >= f.length) idx = f.length - 1;
  if (full !== false) { renderChat(f); renderDock(f[idx]); const ch = $('cx-chat'); ch.scrollTop = ch.scrollHeight; }
  $('cx-step').textContent = 'Domanda ' + (idx + 1) + ' di ' + f.length;
  $('cx-fill').style.width = ((idx + 1) / f.length * 100) + '%';
  $('cx-pill').textContent = '€ ' + total();
  $('cx-back').style.display = idx > 0 ? '' : 'none';
  const ok = NODES[f[idx]].ok();
  document.querySelectorAll('#cx-dock [data-act="go"]').forEach((b) => { b.disabled = !ok; });
  hint(ok || f[idx] === 'review' ? '' : 'Rispondi alla domanda per continuare.');
  refreshAllLink();
}

function init() {
  const q = new URLSearchParams(window.location.search);
  const pre = [...new Set(String(q.get('services') || q.get('service') || '').split(',').map((s) => s.trim().toLowerCase()).map((s) => {
    if (['site', 'sito', 'siti-web', 'sito-web', 'siti'].includes(s)) return 'site';
    if (['social', 'social-media', 'sm'].includes(s)) return 'social';
    if (['design', 'grafiche', 'grafica'].includes(s)) return 'design';
    return null;
  }).filter(Boolean))];
  if (pre.length) S.services = pre;
  $('cx-dock').addEventListener('click', onDock);
  $('cx-back').addEventListener('click', () => { if (idx > 0) { idx--; update(true); } });
  update(true);
  window.__treblaPreventivo = { state: S, currentTotal: total, getMissing: missing, flow, go: (n) => { idx = n; update(true); }, step: () => idx };
}
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
else init();
</script>
