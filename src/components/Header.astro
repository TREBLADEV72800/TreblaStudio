---
const path = Astro.url.pathname;
const active = (href: string) =>
  href === '/' ? (path === '/' ? 'page' : undefined) : path.startsWith(href) ? 'page' : undefined;
---

<header class="sopra">
  <div class="sopra-riga">
    <span class="marchio">
      <img src="/trebla-logo.webp" alt="Trebla, Studio web ad Asti" width="1360" height="768" fetchpriority="high" decoding="async" />
      <span class="marchio-luogo">studio · Asti</span>
    </span>
    <nav class="nav" aria-label="Navigazione principale">
      <a href="/" aria-current={active('/')}>Home</a>
      <a href="/servizi" aria-current={active('/servizi')}>Servizi</a>
      <a href="/prezzi" aria-current={active('/prezzi')}>Prezzi</a>
      <a href="/chi-siamo" aria-current={active('/chi-siamo')}>Studio</a>
      <a href="/faq" aria-current={active('/faq')}>Domande</a>
      <a href="/contatti" aria-current={active('/contatti')}>Contatti</a>
    </nav>
    <a class="btn btn-mattone btn-piccolo" href="/preventivo">Preventivo in 2 minuti</a>
    <button
      type="button"
      class="menu-bottone"
      id="menu-bottone"
      aria-expanded="false"
      aria-controls="menu-mobile"
      aria-label="Apri il menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="nav-mobile" id="menu-mobile" aria-label="Navigazione mobile">
    <a href="/" aria-current={active('/')}>Home</a>
    <a href="/servizi" aria-current={active('/servizi')}>Servizi</a>
    <a href="/prezzi" aria-current={active('/prezzi')}>Prezzi</a>
    <a href="/chi-siamo" aria-current={active('/chi-siamo')}>Studio</a>
    <a href="/faq" aria-current={active('/faq')}>Domande</a>
    <a href="/contatti" aria-current={active('/contatti')}>Contatti</a>
    <a class="btn btn-mattone" href="/preventivo">Preventivo in 2 minuti</a>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-bottone');
  const menu = document.getElementById('menu-mobile');
  let aperto = false;
  let scrollY = 0;

  function bloccaScroll(v: boolean) {
    // Blocco vero: su iOS `overflow:hidden` da solo non basta,
    // la pagina dietro continuerebbe a scorrere e si vedrebbe sotto il menu.
    // Fissiamo il body e ripristiniamo la posizione alla chiusura.
    if (v) {
      scrollY = window.scrollY || document.documentElement.scrollTop || 0;
      document.body.classList.add('menu-aperto');
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
      document.documentElement.style.overflow = 'hidden';
      if (menu) menu.scrollTop = 0;
    } else {
      document.body.classList.remove('menu-aperto');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      document.documentElement.style.overflow = '';
      window.scrollTo(0, scrollY);
    }
  }

  function imposta(v: boolean) {
    aperto = v;
    btn?.setAttribute('aria-expanded', String(v));
    btn?.setAttribute('aria-label', v ? 'Chiudi il menu' : 'Apri il menu');
    menu?.classList.toggle('aperto', v);
    bloccaScroll(v);
    if (v) menu?.querySelector('a')?.focus();
  }

  btn?.addEventListener('click', () => imposta(!aperto));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => imposta(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && aperto) {
      imposta(false);
      (btn as HTMLElement | null)?.focus();
    }
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 960 && aperto) imposta(false);
  });
</script>
