---
// Piede del sito: fascia scura con griglia (presentazione, navigazione, contatti, note legali),
// bottom bar con copyright e "Torna su", e in fondo il wordmark TREBLA tagliato dal bordo della pagina.
// Le lettere salgono una alla volta quando il wordmark entra in vista (reveal con classe "visibile").
// I link con data-* sono riempiti da ContattiDinamici: gli attributi restano come sono.
import Freccia from './ui/Freccia.astro';

const adesso = new Date();
const anno = adesso.getFullYear();
const aggiornato = adesso.toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });

const path = Astro.url.pathname;
const active = (href: string) =>
  href === '/' ? (path === '/' ? 'page' : undefined) : path.startsWith(href) ? 'page' : undefined;

// Stesse voci della nav dell'header: se cambiano, cambiano in entrambi i componenti.
const voci = [
  { href: '/', testo: 'Home' },
  { href: '/servizi/', testo: 'Servizi' },
  { href: '/metodo/', testo: 'Metodo' },
  { href: '/prezzi/', testo: 'Prezzi' },
  { href: '/chi-siamo/', testo: 'Studio' },
  { href: '/faq/', testo: 'FAQ' },
  { href: '/contatti/', testo: 'Contatti' },
];
const lettere = 'TREBLA'.split('');
---

<footer class="pie fascia-scura">
  <div class="contenitore">
    <div class="pie__griglia">
      <div class="pie__bloc pie__presentazione">
        <h2 class="pie__etichetta">Studio</h2>
        <p class="pie__lead">Studio indipendente ad Asti.<br />Siti web per piccole attività.</p>
      </div>

      <nav class="pie__bloc pie__nav" aria-labelledby="pie-nav">
        <h2 class="pie__etichetta" id="pie-nav">Navigazione principale</h2>
        <ul class="pie__voci-grandi">
          {
            voci.map((v) => (
              <li>
                <a href={v.href} aria-current={active(v.href)} data-cursore={v.testo}>{v.testo}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="pie__destra">
        <div class="pie__bloc pie__contatti">
          <h2 class="pie__etichetta">Contatti diretti</h2>
          <ul class="pie__elenco">
            <li><a data-wa="Ciao Trebla! Vorrei un sito per la mia attività, parliamone." target="_blank" rel="noopener noreferrer" href="#">WhatsApp</a></li>
            <li><a data-tel href="#">Chiamaci</a></li>
            <li><a data-mail data-mostra href="#">email</a></li>
          </ul>
          <p class="pie__nota">Asti, su appuntamento.</p>
        </div>

        <nav class="pie__bloc pie__legali" aria-labelledby="pie-legali">
          <h2 class="pie__etichetta" id="pie-legali">Note legali</h2>
          <ul class="pie__elenco pie__elenco--piccolo">
            <li><a href="/accessibilita/">Accessibilità</a></li>
            <li><a href="/note-legali/#privacy">Privacy</a></li>
            <li><a href="/note-legali/#cookie">Cookie</a></li>
            <li><a href="/note-legali/#termini">Termini</a></li>
          </ul>
        </nav>
      </div>
    </div>

    <div class="pie__fondo">
      <span>© {anno} Trebla · Asti · Aggiornato a {aggiornato}</span>
      <a class="pie__torna" id="torna-su" href="#cima">
        <span>Torna su</span>
        <span class="pie__torna-icona"><Freccia /></span>
      </a>
    </div>
  </div>

  <div class="pie__marchio contenitore" data-reveal aria-hidden="true">
    <span class="pie__wordmark">
      {
        lettere.map((l, i) => (
          <span class="pie__lettera"><span style={`--i:${i}`}>{l}</span></span>
        ))
      }
    </span>
  </div>
</footer>

<style>
  .pie {
    padding-block-start: var(--sezione);
  }

  /* ---------- Griglia: 1 colonna, 6 da 640px, 12 da 960px ---------- */
  .pie__griglia {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-7) var(--gap);
  }

  /* Su mobile il wrapper dei contatti sparisce: contatti, navigazione e note legali
     entrano nella griglia in quest'ordine. */
  .pie__destra {
    display: contents;
  }

  .pie__bloc {
    min-inline-size: 0;
    border-block-start: 1px solid var(--linea);
    padding-block-start: var(--s-4);
  }

  .pie__presentazione {
    order: 0;
  }

  .pie__contatti {
    order: 1;
  }

  .pie__nav {
    order: 2;
  }

  .pie__legali {
    order: 3;
  }

  .pie__etichetta {
    margin: 0 0 var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    font-stretch: normal;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--morbido-scuro);
  }

  .pie__lead {
    max-inline-size: 36ch;
    font: 400 var(--fs-lead) / 1.45 var(--font-testo);
    color: var(--carta);
  }

  .pie__nota {
    margin-block-start: var(--s-2);
    font: 400 var(--fs-small) / 1.45 var(--font-testo);
    color: var(--morbido-scuro);
  }

  /* ---------- Navigazione grande: display, maiuscolo ---------- */
  .pie__voci-grandi {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--linea);
  }

  .pie__voci-grandi li {
    border-block-end: 1px solid var(--linea);
  }

  .pie__voci-grandi a {
    display: block;
    padding-block: var(--s-2) var(--s-3);
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 44px);
    font-stretch: 64%;
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--carta);
    text-decoration: none;
    transition: color var(--t-2) var(--ease-std), transform var(--t-2) var(--ease-std);
  }

  .pie__voci-grandi a[aria-current="page"] {
    color: var(--morbido-scuro);
  }

  /* ---------- Contatti e note legali ---------- */
  .pie__elenco {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pie__elenco a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-block-size: 40px;
    overflow-wrap: anywhere;
    font: 400 var(--fs-body) / 1.3 var(--font-testo);
    color: var(--carta);
    text-decoration: none;
    transition: transform var(--t-2) var(--ease-std);
  }

  .pie__elenco--piccolo a {
    font-size: var(--fs-small);
  }

  /* Hover dei link piccoli: la barra è mattone, il testo resta carta (il mattone pieno è riservato al testo grande). */
  .pie__elenco a::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 6px;
    block-size: 1px;
    background: var(--mattone);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--t-2) var(--ease-expo);
  }

  /* ---------- Bottom bar: copyright e "Torna su" ---------- */
  .pie__fondo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    margin-block: var(--s-8) var(--s-6);
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--linea);
    font: 400 var(--fs-label) / 1.5 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--morbido-scuro);
  }

  .pie__torna {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-block-size: 44px;
    color: var(--carta);
    text-decoration: none;
  }

  .pie__torna-icona {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 32px;
    block-size: 32px;
    border: 1px solid var(--linea);
    border-radius: 50%;
    transition: background-color var(--t-2) var(--ease-std), color var(--t-2) var(--ease-std);
  }

  /* La freccia è ruotata di 45° in senso antiorario: ↗ diventa ↑. */
  .pie__torna-icona :global(.icona-freccia) {
    transform: rotate(-45deg);
  }

  /* ---------- Wordmark TREBLA: tagliato dal bordo della pagina ---------- */
  .pie__marchio {
    overflow: hidden;
  }

  .pie__wordmark {
    display: block;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-wordmark);
    font-stretch: 64%;
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--carta);
    /* Spostato in basso: la parte bassa delle lettere esce dal bordo della pagina. */
    transform: translate3d(0, 16%, 0);
  }

  /* Ogni lettera ha la sua maschera (overflow hidden) e sale da sotto. */
  .pie__lettera {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-block: 0.06em;
    margin-block: -0.06em;
  }

  .pie__lettera > span {
    display: inline-block;
    transition: transform var(--t-4) var(--ease-out) calc(var(--i) * 50ms);
  }

  /* Il reveal dell'intero contenitore (data-reveal) non sfuma né solleva il blocco: salgono solo le lettere. */
  .js .pie__marchio[data-reveal]:not(.visibile) {
    opacity: 1;
    transform: none;
  }

  .js .pie__marchio:not(.visibile) .pie__lettera > span {
    transform: translate3d(0, 100%, 0);
  }

  /* ---------- Breakpoint 640px: due colonne ---------- */
  @media (min-width: 640px) {
    .pie__griglia {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .pie__presentazione {
      grid-column: 1 / -1;
    }

    .pie__contatti {
      grid-column: 1 / span 3;
    }

    .pie__nav {
      grid-column: 4 / span 3;
    }

    .pie__legali {
      grid-column: 1 / -1;
    }
  }

  /* ---------- Breakpoint 960px: 12 colonne, presentazione 5, navigazione 3, contatti 3 ---------- */
  @media (min-width: 960px) {
    .pie__griglia {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .pie__presentazione {
      grid-column: 1 / span 5;
      grid-row: 1;
    }

    .pie__nav {
      grid-column: 6 / span 3;
      grid-row: 1;
    }

    .pie__destra {
      display: flex;
      flex-direction: column;
      gap: var(--s-7);
      grid-column: 10 / span 3;
      grid-row: 1;
    }

    .pie__destra .pie__bloc {
      order: 0;
    }

    .pie__voci-grandi a:hover {
      color: var(--mattone);
    }
  }

  /* ---------- Hover (solo con puntatore) ---------- */
  @media (hover: hover) {
    .pie__elenco a:hover {
      transform: translate3d(6px, 0, 0);
    }

    .pie__elenco a:hover::after {
      transform: scaleX(1);
    }

    .pie__torna:hover .pie__torna-icona {
      background-color: var(--carta);
      color: var(--inchiostro);
    }

    .pie__voci-grandi a:hover {
      color: var(--mattone);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pie__voci-grandi a:hover {
      transform: translate3d(6px, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .pie__marchio:not(.visibile) .pie__lettera > span {
      transform: none;
    }
  }
</style>

<script is:inline>
  // is:inline: poche righe di JS puro, senza chunk nel grafo di caricamento.
  (function () {
    document.getElementById('torna-su')?.addEventListener('click', (e) => {
      e.preventDefault();
      const ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: ridotto ? 'auto' : 'smooth' });
    });
  })();
</script>
