---
// Piede del sito: fascia grafite con griglia (presentazione, contatti, pagine, note legali),
// e riga finale con copyright e "Torna su". Nessun wordmark: il piede è compatto.
// I link con data-* sono riempiti da ContattiDinamici: gli attributi restano come sono.
const adesso = new Date();
const anno = adesso.getFullYear();
const aggiornato = adesso.toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });

const path = Astro.url.pathname;
const active = (href: string) => (path.startsWith(href) ? 'page' : undefined);

// Stesse voci della nav dell'header: se cambiano, cambiano in entrambi i componenti.
const voci = [
  { href: '/servizi/', testo: 'Servizi' },
  { href: '/metodo/', testo: 'Metodo' },
  { href: '/prezzi/', testo: 'Prezzi' },
  { href: '/chi-siamo/', testo: 'Chi siamo' },
  { href: '/faq/', testo: 'Domande' },
  { href: '/contatti/', testo: 'Contatti' },
];
---

<footer class="pie fascia-grafite">
  <div class="contenitore">
    <div class="pie__griglia">
      <div class="pie__bloc pie__presentazione">
        <h3 class="pie__etichetta">Studio</h3>
        <p class="pie__lead">Studio indipendente ad Asti.<br />Siti web per piccole attività.</p>
      </div>

      <nav class="pie__bloc pie__nav" aria-labelledby="pie-nav">
        <h3 class="pie__etichetta" id="pie-nav">Pagine</h3>
        <ul class="pie__voci-grandi">
          {
            voci.map((v) => (
              <li>
                <a href={v.href} aria-current={active(v.href)}>{v.testo}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="pie__destra">
        <div class="pie__bloc pie__contatti">
          <h3 class="pie__etichetta">Contatti</h3>
          <ul class="pie__elenco">
            <li><a data-wa="Ciao Trebla! Vorrei un sito per la mia attività, parliamone." target="_blank" rel="noopener noreferrer" href="#">Scrivici su WhatsApp</a></li>
            <li><a data-tel data-mostra href="#">Chiama</a></li>
            <li><a data-mail data-mostra href="#">Scrivi un'email</a></li>
          </ul>
          <p class="pie__nota">Asti, su appuntamento.</p>
        </div>

        <nav class="pie__bloc pie__legali" aria-labelledby="pie-legali">
          <h3 class="pie__etichetta" id="pie-legali">Note legali</h3>
          <ul class="pie__elenco pie__elenco--piccolo">
            <li><a href="/accessibilita/">Accessibilità</a></li>
            <li><a href="/note-legali/#privacy">Privacy</a></li>
            <li><a href="/note-legali/#cookie">Cookie</a></li>
            <li><a href="/note-legali/#termini">Termini</a></li>
          </ul>
        </nav>
      </div>
    </div>

    <div class="pie__fondo">
      <p class="pie__copia">
        <span>© {anno} Trebla, Asti</span>
        <span>Aggiornato a {aggiornato}</span>
      </p>
      <a class="pie__torna" id="torna-su" href="#cima">Torna su</a>
    </div>
  </div>
</footer>

<style>
  .pie {
    padding-block: var(--s-7) var(--s-5);
  }

  /* ---------- Griglia: 2 colonne su mobile (presentazione intera; contatti e note legali
     affiancati; pagine intere), 6 colonne da 640px, 4 blocchi da 3 colonne da 960px ---------- */
  .pie__griglia {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--gap);
    align-items: start;
  }

  /* Su mobile il wrapper dei contatti sparisce: i suoi blocchi entrano nella griglia. */
  .pie__destra {
    display: contents;
  }

  .pie__bloc {
    min-inline-size: 0;
  }

  .pie__presentazione {
    grid-column: 1 / -1;
    grid-row: 1;
  }

  .pie__contatti {
    grid-column: 1;
    grid-row: 2;
  }

  .pie__legali {
    grid-column: 2;
    grid-row: 2;
  }

  .pie__nav {
    grid-column: 1 / -1;
    grid-row: 3;
  }

  /* Intestazione di blocco: Archivo 600, frase normale. */
  .pie__etichetta {
    margin: 0 0 var(--s-3);
    font: 600 var(--fs-ui) / 1.4 var(--font-ui);
    letter-spacing: 0;
    text-transform: none;
    color: var(--morbido-scuro);
  }

  .pie__lead {
    max-inline-size: 36ch;
    font: 400 var(--fs-lead) / 1.45 var(--font-testo);
    color: var(--carta);
  }

  .pie__nota {
    margin-block-start: var(--s-2);
    font: 400 var(--fs-small) / 1.45 var(--font-testo);
    color: var(--morbido-scuro);
  }

  /* ---------- Link del piede ----------
     Un solo hover per link: una sottolineatura che entra da sinistra (::after, solo scaleX).
     La voce corrente ha la stessa sottolineatura a riposo. */
  .pie a {
    position: relative;
    color: var(--carta);
    text-decoration: none;
  }

  .pie a::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 10px;
    block-size: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--t-2) var(--ease-expo);
  }

  .pie a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  @media (hover: hover) {
    .pie a:hover::after {
      transform: scaleX(1);
    }
  }

  /* ---------- Navigazione: Archivo 600, a dimensione di testo; su mobile due colonne ---------- */
  .pie__voci-grandi {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--linea);
  }

  .pie__voci-grandi li {
    border-block-end: 1px solid var(--linea);
  }

  .pie__voci-grandi a {
    display: inline-block;
    padding-block: var(--s-2);
    font: 600 var(--fs-body) / 1.3 var(--font-ui);
    letter-spacing: 0;
    text-transform: none;
  }

  .pie__voci-grandi a::after {
    inset-block-end: 6px;
  }

  .pie__voci-grandi a[aria-current="page"] {
    color: var(--morbido-scuro);
  }

  /* ---------- Contatti e note legali ---------- */
  .pie__elenco {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pie__elenco a {
    display: inline-flex;
    align-items: center;
    min-block-size: 40px;
    overflow-wrap: anywhere;
    font: 400 var(--fs-body) / 1.3 var(--font-testo);
  }

  .pie__elenco--piccolo a {
    font-size: var(--fs-small);
  }

  .pie__elenco a::after {
    inset-block-end: 10px;
  }

  /* ---------- Riga finale: copyright e "Torna su" ---------- */
  .pie__fondo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    margin-block: var(--s-5) 0;
    font: 400 var(--fs-small) / 1.5 var(--font-ui);
    letter-spacing: 0;
    text-transform: none;
    color: var(--morbido-scuro);
  }

  .pie__copia span {
    display: block;
  }

  .pie__torna {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    font: 600 var(--fs-small) / 1.2 var(--font-ui);
    color: var(--carta);
    text-decoration: none;
  }

  .pie__torna::after {
    inset-block-end: 12px;
  }

  /* ---------- Breakpoint 640px: sei colonne; navigazione in colonna, note legali in riga ---------- */
  @media (min-width: 640px) {
    .pie__griglia {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .pie__voci-grandi {
      display: block;
    }

    .pie__contatti {
      grid-column: 1 / span 3;
      grid-row: 2;
    }

    .pie__nav {
      grid-column: 4 / span 3;
      grid-row: 2;
    }

    .pie__legali {
      grid-column: 1 / -1;
      grid-row: 3;
    }

    .pie__legali .pie__elenco {
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--s-5);
    }
  }

  /* ---------- Breakpoint 960px: quattro blocchi da tre colonne, una riga ---------- */
  @media (min-width: 960px) {
    .pie__griglia {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .pie__presentazione {
      grid-column: 1 / span 3;
      grid-row: 1;
    }

    .pie__nav {
      grid-column: 4 / span 3;
      grid-row: 1;
    }

    .pie__contatti {
      grid-column: 7 / span 3;
      grid-row: 1;
    }

    .pie__legali {
      grid-column: 10 / span 3;
      grid-row: 1;
    }

    .pie__legali .pie__elenco {
      display: block;
    }
  }
</style>

<script is:inline>
  // is:inline: poche righe di JS puro, senza chunk nel grafo di caricamento.
  (function () {
    document.getElementById('torna-su')?.addEventListener('click', (e) => {
      e.preventDefault();
      const ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: ridotto ? 'auto' : 'smooth' });
    });
  })();
</script>
