---
// Hero della home. H1 display a tutta larghezza; l'ultima parola cambia in un ciclo di settori
// (CSS puro, quindi funziona anche senza JS). Il ciclo è nascosto ai lettori di schermo;
// lo sr-only dentro l'H1 porta la frase intera.
// Il ciclo è l'unico gesto in mattone del sito. Durate solo da token.
import Bottone from '../ui/Bottone.astro';

// Parole del ciclo: ognuna sale, resta, esce. Il ciclo chiude su ATTIVITÀ.
const ciclo = ['PIZZERIA.', 'OFFICINA.', 'TRATTORIA.', 'BOTTEGA.', 'ATTIVITÀ.'];

// Garanzie: una riga di testo semplice, frasi già presenti nel sito.
const garanzie = 'Il sito è tuo. Nessun canone obbligatorio. Due revisioni incluse. Asti, su appuntamento.';
---

<section class="hero contenitore" aria-labelledby="titolo">
  <h1 id="titolo" class="hero__titolo titolo-rivelato titolo-rivelato--hero titolo-rivelato--immediato display"><span class="parola"><span class="parola__in" style="--i: 0">Un</span></span> <span class="parola"><span class="parola__in" style="--i: 1">sito</span></span> <span class="parola"><span class="parola__in" style="--i: 2">chiaro</span></span> <br /><span class="parola"><span class="parola__in" style="--i: 3">per</span></span> <span class="parola"><span class="parola__in" style="--i: 4">far</span></span> <span class="parola"><span class="parola__in" style="--i: 5">scegliere</span></span> <br /><span class="parola"><span class="parola__in" style="--i: 6">la</span></span> <span class="parola"><span class="parola__in" style="--i: 7">tua</span></span> <span class="hero__ciclo" aria-hidden="true">{ciclo.map((parola, i) => (<span class="hero__parola" style={`--i: ${i}`} data-p={parola}></span>))}</span><span class="hero__solo-lettori">attività.</span></h1>

  <div class="hero__sotto">
    <p class="hero__lead">Siti web completi e veloci per attività locali ad Asti e dintorni: prezzi chiari, un referente diretto e i contatti sempre a portata di mano.</p>
    <div class="hero__azioni entra" style="--d: var(--t-3)">
      <Bottone href="/preventivo/" testo="Fai il preventivo" />
      <Bottone href="/servizi/" variante="secondario" testo="Vedi i servizi" />
    </div>
  </div>

  <p class="hero__garanzie entra" style="--d: calc(var(--t-3) + var(--stagger-elemento))">{garanzie}</p>
</section>

<style>
  /* ---------- Contenitore: altezza piena da 960px, contenuto in colonna.
     Il padding in basso è --sezione, come ogni sezione: la fascia successiva ha lo stesso ritmo. ---------- */
  .hero {
    display: flex;
    flex-direction: column;
    padding-block: var(--s-7) var(--sezione);
  }

  @media (min-width: 960px) {
    .hero {
      min-block-size: calc(100svh - var(--hh));
    }
  }

  /* ---------- H1 display a tutta larghezza ---------- */
  .hero__titolo {
    margin-block: var(--s-6) 0;
    max-inline-size: none;
    color: var(--inchiostro);
  }

  @media (min-width: 960px) {
    .hero__titolo {
      margin-block: auto 0;
    }
  }

  /* ---------- Parola che cambia ----------
     Una cella di inline-grid: tutte le parole stanno in 1/1, la cella prende la larghezza
     della più lunga e ritaglia (overflow clip). Ogni parola: sale da 130% a 0, sta ferma,
     esce a -130%. Periodo di cinque parole: 10 volte --t-5 (11 s), 2 volte --t-5 a parola.
     Inizio dopo l'ingresso dell'H1: --t-5 più --t-2. */
  .hero__ciclo {
    display: inline-grid;
    vertical-align: top;
    /* Ritaglio: sopra abbastanza per gli accenti (À), sotto zero: le parole in attesa restano sotto il bordo. */
    margin-block: -0.25em 0;
    padding-block: 0.25em 0;
    overflow: clip;
    color: var(--mattone);
  }

  .hero__parola {
    grid-area: 1 / 1;
    display: block;
    white-space: nowrap;
    animation: hero-ciclo calc(var(--t-5) * 10) linear infinite both;
    animation-delay: calc(var(--t-5) + var(--t-2) + var(--i) * 2 * var(--t-5));
  }

  .hero__parola::before {
    content: attr(data-p);
  }

  @keyframes hero-ciclo {
    0% {
      transform: translate3d(0, 130%, 0);
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    }
    5.45% {
      transform: translate3d(0, 0, 0);
    }
    14.55% {
      transform: translate3d(0, 0, 0);
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    }
    20% {
      transform: translate3d(0, -130%, 0);
    }
    100% {
      transform: translate3d(0, -130%, 0);
    }
  }

  /* Testo per screen reader e SEO: la frase intera resta nel DOM, nascosta a vista. */
  .hero__solo-lettori {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- Sotto l'H1: lead a sinistra, CTA a destra ---------- */
  .hero__sotto {
    display: grid;
    gap: var(--s-5);
    margin-block-start: var(--s-7);
  }

  .hero__lead {
    max-inline-size: 52ch;
    font: 400 var(--fs-lead) / 1.45 var(--font-testo);
    color: var(--morbido);
  }

  .hero__azioni {
    display: grid;
    gap: var(--s-3);
  }

  .hero__azioni :global(.btn) {
    inline-size: 100%;
  }

  @media (min-width: 640px) {
    .hero__azioni {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-3);
    }

    .hero__azioni :global(.btn) {
      inline-size: auto;
    }
  }

  @media (min-width: 960px) {
    .hero__sotto {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }

    .hero__lead {
      grid-column: 1 / span 6;
    }

    .hero__azioni {
      grid-column: 7 / -1;
      justify-content: flex-end;
    }
  }

  /* ---------- Garanzie: una riga di testo semplice, sotto le CTA ---------- */
  .hero__garanzie {
    max-inline-size: none;
    margin: var(--s-7) 0 0;
    font: 400 var(--fs-body) / 1.55 var(--font-testo);
    color: var(--morbido);
  }

  /* ---------- Movimento ridotto: solo ATTIVITÀ., ferma ---------- */
  @media (prefers-reduced-motion: reduce) {
    .hero__parola {
      animation: none;
    }

    .hero__parola:not(:last-child) {
      visibility: hidden;
    }
  }
</style>
