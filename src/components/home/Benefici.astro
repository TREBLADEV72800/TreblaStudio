---
import TestataSezione from '../TestataSezione.astro';

// Benefici: quattro punti concreti. Non sono una sequenza: nessun numero.
const benefici = [
  { t: 'Si trova subito l’essenziale', d: 'Chi sei, dove sei, quando sei aperto. Senza scavare nei menu.' },
  { t: 'Menu e servizi leggibili', d: 'Prezzi chiari dal telefono, senza scaricare PDF. Anche con poco campo.' },
  { t: 'Contatti in un tocco', d: 'Telefono, WhatsApp, mappa e prenotazioni sempre in vista.' },
  { t: 'Ordine anche fuori dal sito', d: 'Google Business e mappe sistemati: orari e indicazioni giusti ovunque.' },
];
---

<section class="home-benefici sezione" aria-labelledby="t-benefici">
  <div class="contenitore">
    <TestataSezione
      id="t-benefici"
      titolo="Cosa cambia in pratica"
      nota="Niente promesse: quattro cose concrete che il sito fa per te."
    />
    <ul class="home-benefici__lista">
      {
        benefici.map((b) => (
          <li class="home-benefici__voce">
            <h3>{b.t}</h3>
            <p>{b.d}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Una colonna sotto 960px, griglia 2 × 2 da 960px. Un filetto per voce, nessun altro ornamento. */
  .home-benefici__lista {
    display: grid;
    gap: var(--s-6) var(--gap);
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 960px) {
    .home-benefici__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-7) var(--gap);
    }
  }

  .home-benefici__voce {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding-block-start: var(--s-5);
    border-block-start: 1px solid var(--linea);
  }

  .home-benefici__voce h3 {
    color: var(--inchiostro);
  }

  .home-benefici__voce p {
    max-inline-size: 40ch;
    font-size: var(--fs-body);
    color: var(--morbido);
  }
</style>
