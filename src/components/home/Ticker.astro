---
// Ticker dei settori: una sola riga che scorre lenta e lineare, da destra a sinistra.
// L'elenco è ripetuto una volta per il loop: la copia è nascosta ai lettori di schermo.
// Con movimento ridotto la riga resta ferma. Niente skew, niente JS legato allo scroll.
const settori = [
  'Ristoranti', 'Bar', 'Pizzerie', 'B&B', 'Barbieri', 'Saloni', 'Centri estetici',
  'Negozi', 'Artigiani', 'Officine', 'Professionisti', 'Associazioni',
];
---

<section class="fascia-scura ticker" aria-label="Per chi lavoriamo">
  <div class="ticker__finestra">
    <div class="ticker__pista">
      <ul class="ticker__lista">
        {settori.map((s) => <li>{s}</li>)}
      </ul>
      <ul class="ticker__lista ticker__copia" aria-hidden="true">
        {settori.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Fascia di passaggio, non una sezione: padding proporzionato, non il ritmo delle sezioni. */
  .ticker {
    padding-block: var(--s-6);
  }

  .ticker__finestra {
    overflow: hidden;
  }

  .ticker__pista {
    display: flex;
    inline-size: max-content;
    will-change: transform;
    animation: ticker var(--t-scorrimento) linear infinite;
  }

  /* Pausa al passaggio del mouse: il movimento resta sotto controllo di chi legge. */
  @media (hover: hover) {
    .ticker__finestra:hover .ticker__pista {
      animation-play-state: paused;
    }
  }

  .ticker__lista {
    display: flex;
    flex: none;
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
    font: 600 var(--fs-h2-xs) / 1.2 var(--font-ui);
    letter-spacing: -0.01em;
    color: var(--carta);
  }

  .ticker__lista li {
    display: flex;
    align-items: center;
  }

  /* Separatore neutro: un filetto morbido, nessun colore di accento. */
  .ticker__lista li::after {
    content: '';
    flex: none;
    inline-size: 1px;
    block-size: 0.8em;
    margin-inline: 0.7em;
    background: var(--morbido);
  }

  @keyframes ticker {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Movimento ridotto: la riga resta ferma e sempre su una sola linea, tagliata a destra. */
  @media (prefers-reduced-motion: reduce) {
    .ticker__pista {
      animation: none;
    }

    .ticker__copia {
      display: none;
    }
  }
</style>
