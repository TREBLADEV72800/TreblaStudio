---
import TestataSezione from '../TestataSezione.astro';
---

<section class="home-studio sezione" aria-labelledby="t-studio">
  <div class="contenitore">
    <div class="home-studio__testata">
      <TestataSezione
        id="t-studio"
        titolo="Due persone,|niente call center"
        nota="Parli sempre con chi costruisce il tuo sito."
      />
    </div>

    <div class="home-studio__persone" id="h-studio">
      <article class="home-studio__persona">
        <div class="home-studio__chi">
          <h3 class="home-studio__nome">Albert</h3>
          <p class="home-studio__ruolo">Sviluppo e progetto</p>
        </div>
        <p class="home-studio__testo">Segue ogni progetto dall’inizio alla fine: costruisce il sito, lo pubblica e resta il tuo referente.</p>
      </article>

      <article class="home-studio__persona">
        <div class="home-studio__chi">
          <h3 class="home-studio__nome">Gabriel</h3>
          <p class="home-studio__ruolo">Design e social</p>
        </div>
        <p class="home-studio__testo">Cura l’aspetto e i contenuti: grafiche, foto e social. Quello che si vede, lo ha visto lui prima di te.</p>
      </article>
    </div>
  </div>
</section>

<style>
  /* Persone: righe con filetto, una per persona. Da 960px nome e ruolo stanno nelle colonne 1-6,
     il testo nelle colonne 8-12. */
  .home-studio__persone {
    display: grid;
    margin: 0;
  }

  .home-studio__persona {
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-6);
    border-block-start: 1px solid var(--linea);
  }

  .home-studio__nome {
    font: 600 var(--fs-h2-xs) / 1.1 var(--font-ui);
    letter-spacing: -0.02em;
    color: var(--inchiostro);
  }

  .home-studio__ruolo {
    max-inline-size: none;
    margin: var(--s-2) 0 0;
    font: 600 var(--fs-body) / 1.4 var(--font-ui);
    color: var(--morbido);
  }

  .home-studio__testo {
    max-inline-size: 48ch;
    font: 400 var(--fs-body) / 1.55 var(--font-testo);
    color: var(--inchiostro);
  }

  @media (min-width: 960px) {
    .home-studio__persona {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: start;
      padding-block: var(--s-7);
    }

    .home-studio__chi {
      grid-column: 1 / span 6;
    }

    .home-studio__testo {
      grid-column: 9 / span 4;
      max-inline-size: 44ch;
    }
  }
</style>
