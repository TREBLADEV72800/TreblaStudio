---
import TestataSezione from '../TestataSezione.astro';
import Freccia from '../ui/Freccia.astro';
import { ANTICIPO, BASE_PRICES, OFFERTA_SITO } from '../../data/prezzi';
---

<!-- 04 · PREZZI -->
<section class="home-prezzi" aria-labelledby="t-prezzi">
  <div class="contenitore">
    <TestataSezione
      id="t-prezzi"
      numero="04 · Prezzi"
      titolo="Scegli da <em>dove partire</em>"
    />

    <div class="home-prezzi__griglia" id="h-prezzi" data-reveal-gruppo>
      <article class="home-prezzi__card" data-reveal>
        <div class="home-prezzi__cima">
          <span class="home-prezzi__num">01</span>
          <span class="home-prezzi__kicker">Per iniziare</span>
          <span class="puntino puntino--inchiostro" aria-hidden="true"></span>
        </div>
        <h3 class="home-prezzi__nome">Pagina singola</h3>
        <p class="home-prezzi__cifra">{BASE_PRICES.singola}<span class="home-prezzi__euro">€</span></p>
        <p class="home-prezzi__per">Per artigiani, professionisti e botteghe che devono farsi trovare e contattare.</p>
        <ul class="home-prezzi__voci">
          <li>Tutto l’essenziale in una pagina che scorre</li>
          <li>Telefono, WhatsApp e mappa in vista</li>
          <li>Privacy e cookie inclusi</li>
        </ul>
        <a class="link-sottolineato home-prezzi__cta" href="/preventivo/">Configura la singola<Freccia /></a>
      </article>

      <article class="home-prezzi__card" data-reveal>
        <div class="home-prezzi__cima">
          <span class="home-prezzi__num">02</span>
          <span class="home-prezzi__kicker">Il completo</span>
          <span class="puntino puntino--inchiostro" aria-hidden="true"></span>
        </div>
        <h3 class="home-prezzi__nome">Sito a più pagine</h3>
        <p class="home-prezzi__cifra">{BASE_PRICES.multi}<span class="home-prezzi__euro">€</span></p>
        <p class="home-prezzi__per">Per ristoranti, B&amp;B, saloni e negozi con tanto da mostrare.</p>
        <ul class="home-prezzi__voci">
          <li>Storia, servizi, galleria, contatti: ognuno al suo posto</li>
          <li>Menu, prenotazioni, eventi se ti servono</li>
          <li>Telefono, WhatsApp e mappa in vista</li>
        </ul>
        <a class="link-sottolineato home-prezzi__cta" href="/preventivo/">Configura il multipagina<Freccia /></a>
      </article>

      <article class="home-prezzi__card home-prezzi__card--evidenza" data-reveal>
        <div class="home-prezzi__cima">
          <span class="home-prezzi__num">03</span>
          <span class="chip home-prezzi__chip">Tutto incluso</span>
          <span class="puntino puntino--mattone" aria-hidden="true"></span>
        </div>
        <h3 class="home-prezzi__nome">Offerta</h3>
        <p class="home-prezzi__cifra">{OFFERTA_SITO.prezzo}<span class="home-prezzi__euro">€</span></p>
        <p class="home-prezzi__per">Sito completo, foto e logo con prezzo definito prima.</p>
        <ul class="home-prezzi__voci">
          <li>Sito a più pagine con funzioni incluse e pagine concordate</li>
          <li>Foto scattate da noi ad Asti</li>
          <li>Logo nuovo o rinnovato</li>
          <li>{OFFERTA_SITO.revisioni} modifiche gratuite invece di due</li>
        </ul>
        <a class="link-sottolineato home-prezzi__cta" href="/preventivo/?offerta=1">Prendi l’offerta<Freccia /></a>
      </article>
    </div>

    <div class="home-prezzi__finale" data-reveal>
      <p class="home-prezzi__nota">Hosting completamente gratuito, configurazione del dominio gratis. A noi, nessun canone obbligatorio, {ANTICIPO}€ di acconto compresi.</p>
      <a class="link-sottolineato" href="/prezzi/">Tutti i dettagli in Prezzi<Freccia /></a>
    </div>
  </div>
</section>

<style>
  /* Prezzi: fascia carta. Filetto a tutta larghezza del contenitore sopra, poi padding var(--sezione). */
  .home-prezzi {
    position: relative;
    padding-block: var(--sezione);
  }

  .home-prezzi::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: var(--pad);
    block-size: 1px;
    background: var(--linea);
  }

  /* 1 colonna su mobile, 3 da 960px, con altezza uguale. */
  .home-prezzi__griglia {
    display: grid;
    gap: var(--gap);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 960px) {
    .home-prezzi__griglia {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Card con bordo da 1px e angoli vivi. Non usa .scheda: quella classe è del CSS legacy
     (ombra dura e display:none sotto 999px). */
  .home-prezzi__card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 2.6vw, 36px);
    border: 1px solid var(--linea);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    transition: border-color var(--t-2) var(--ease-std);
  }

  .home-prezzi__card--evidenza {
    border-color: var(--mattone);
  }

  .home-prezzi__cima {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font: 500 var(--fs-label) / 1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--morbido);
  }

  .home-prezzi__num {
    color: var(--inchiostro);
  }

  .home-prezzi__kicker,
  .home-prezzi__chip {
    margin-inline-start: auto;
  }

  .home-prezzi__chip {
    border-color: var(--mattone);
    color: var(--mattone-testo);
  }

  .home-prezzi__nome {
    margin-block-start: var(--s-6);
    color: var(--inchiostro);
  }

  /* Il prezzo è display gigante; il simbolo € è più piccolo e sta in alto. */
  .home-prezzi__cifra {
    max-inline-size: none;
    margin: var(--s-4) 0 0;
    font: 800 clamp(64px, 7vw, 112px) / 0.86 var(--font-display);
    font-stretch: 64%;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--inchiostro);
  }

  .home-prezzi__euro {
    display: inline-block;
    margin-inline-start: 0.04em;
    font-size: 0.5em;
    line-height: 1;
    vertical-align: top;
  }

  .home-prezzi__per {
    max-inline-size: 40ch;
    margin: var(--s-5) 0 0;
    font: 400 var(--fs-small) / 1.5 var(--font-mono);
    color: var(--morbido);
  }

  /* Voci con filetti tra le righe e un trattino mattone come marcatore. */
  .home-prezzi__voci {
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--linea);
  }

  .home-prezzi__voci li {
    display: grid;
    grid-template-columns: 10px minmax(0, 1fr);
    gap: var(--s-3);
    align-items: start;
    padding-block: var(--s-3);
    border-block-end: 1px solid var(--linea);
    font: 400 var(--fs-body) / 1.45 var(--font-testo);
    color: var(--inchiostro);
  }

  .home-prezzi__voci li::before {
    content: '';
    inline-size: 10px;
    block-size: 2px;
    margin-block-start: calc(0.725em - 1px);
    background: var(--mattone);
  }

  /* CTA in fondo alla card. */
  .home-prezzi__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    align-self: flex-start;
    margin-block-start: auto;
    padding-block-start: var(--s-6);
    color: var(--inchiostro);
  }

  .home-prezzi__cta :global(.icona-freccia) {
    transition: transform var(--t-2) var(--ease-std);
  }

  @media (hover: hover) {
    .home-prezzi__card:hover {
      border-color: var(--mattone);
    }

    .home-prezzi__card:hover .home-prezzi__cta :global(.icona-freccia) {
      transform: translate3d(4px, 0, 0);
    }
  }

  /* Riga finale: mono, filetto sopra. */
  .home-prezzi__finale {
    display: grid;
    gap: var(--s-4);
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-5);
    border-block-start: 1px solid var(--linea);
  }

  .home-prezzi__nota {
    max-inline-size: 72ch;
    margin: 0;
    font: 400 var(--fs-small) / 1.5 var(--font-mono);
    color: var(--morbido);
  }

  .home-prezzi__finale > a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    justify-self: start;
    color: var(--inchiostro);
  }

  @media (min-width: 640px) {
    .home-prezzi__finale {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--s-6);
    }

    .home-prezzi__finale > a {
      justify-self: end;
    }
  }
</style>
