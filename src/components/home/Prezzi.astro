---
import TestataSezione from '../TestataSezione.astro';
import Bottone from '../ui/Bottone.astro';
import { ANTICIPO, BASE_PRICES, OFFERTA_SITO } from '../../data/prezzi';
---

<section class="home-prezzi sezione" aria-labelledby="t-prezzi">
  <div class="contenitore">
    <TestataSezione id="t-prezzi" titolo="Scegli da dove partire" />

    <div class="home-prezzi__griglia" id="h-prezzi">
      <article class="home-prezzi__colonna">
        <h3 class="home-prezzi__nome">Pagina singola</h3>
        <p class="home-prezzi__cifra display display--prezzo">{BASE_PRICES.singola}<span class="home-prezzi__euro">€</span></p>
        <p class="home-prezzi__per">Per artigiani, professionisti e botteghe che devono farsi trovare e contattare.</p>
        <ul class="home-prezzi__voci">
          <li>Tutto l’essenziale in una pagina che scorre</li>
          <li>Telefono, WhatsApp e mappa in vista</li>
          <li>Privacy e cookie inclusi</li>
        </ul>
        <div class="home-prezzi__accesso">
          <Bottone
            href="/preventivo/?struttura=singola"
            variante="secondario"
            testo="Scegli la pagina singola"
            data-cursore="Scegli"
          />
        </div>
      </article>

      <article class="home-prezzi__colonna">
        <h3 class="home-prezzi__nome">Sito a più pagine</h3>
        <p class="home-prezzi__cifra display display--prezzo">{BASE_PRICES.multi}<span class="home-prezzi__euro">€</span></p>
        <p class="home-prezzi__per">Per ristoranti, B&amp;B, saloni e negozi con tanto da mostrare.</p>
        <ul class="home-prezzi__voci">
          <li>Storia, servizi, galleria, contatti: ognuno al suo posto</li>
          <li>Menu, prenotazioni, eventi se ti servono</li>
          <li>Telefono, WhatsApp e mappa in vista</li>
        </ul>
        <div class="home-prezzi__accesso">
          <Bottone
            href="/preventivo/?struttura=multi"
            variante="secondario"
            testo="Scegli il sito a più pagine"
            data-cursore="Scegli"
          />
        </div>
      </article>

      <article class="home-prezzi__colonna home-prezzi__colonna--evidenza fascia-scura">
        <h3 class="home-prezzi__nome">{OFFERTA_SITO.nome}</h3>
        <p class="home-prezzi__cifra display display--prezzo">{OFFERTA_SITO.prezzo}<span class="home-prezzi__euro">€</span></p>
        <p class="home-prezzi__per">Sito completo, foto e logo con prezzo definito prima.</p>
        <ul class="home-prezzi__voci">
          <li>Sito a più pagine con funzioni incluse e pagine concordate</li>
          <li>Foto scattate da noi ad Asti</li>
          <li>Logo nuovo o rinnovato</li>
          <li>{OFFERTA_SITO.revisioni} modifiche gratuite invece di due</li>
        </ul>
        <div class="home-prezzi__accesso">
          <Bottone
            href="/preventivo/?offerta=1"
            variante="chiaro"
            testo="Prendi l’offerta"
            data-cursore="Scegli"
          />
        </div>
      </article>
    </div>

    <div class="home-prezzi__finale">
      <p class="home-prezzi__nota">Hosting completamente gratuito, configurazione del dominio gratis. A noi, nessun canone obbligatorio, {ANTICIPO}€ di acconto compresi.</p>
      <a class="link-sottolineato" href="/prezzi/">Vedi i prezzi</a>
    </div>
  </div>
</section>

<style>
  /* Tre colonne da 960px, una sotto. Le colonne non sono card: niente bordo intorno.
     Ogni colonna ha lo stesso margine alto, così nome e prezzo si leggono alla stessa altezza.
     L'unico segnale di evidenza è il fondo inchiostro dell'offerta (.fascia-scura). */
  .home-prezzi__griglia {
    display: grid;
    gap: var(--s-7);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 960px) {
    .home-prezzi__griglia {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--gap);
      align-items: stretch;
    }
  }

  .home-prezzi__colonna {
    display: flex;
    flex-direction: column;
    padding-block: var(--s-6);
    border-block-start: 1px solid var(--linea);
  }

  /* L'offerta: un blocco pieno, con lo stesso margine alto delle altre colonne dentro il blocco. */
  .home-prezzi__colonna--evidenza {
    padding: var(--s-6);
    border-block-start: 0;
  }

  .home-prezzi__nome {
    font: 600 var(--fs-h3) / 1.2 var(--font-ui);
    letter-spacing: -0.02em;
    text-transform: none;
  }

  /* Il prezzo è un oggetto tipografico: display gigante, cifre allineate. Il simbolo € è più piccolo. */
  .home-prezzi__cifra {
    max-inline-size: none;
    margin: var(--s-4) 0 0;
    white-space: nowrap;
  }

  .home-prezzi__euro {
    display: inline-block;
    margin-inline-start: 0.04em;
    font-size: 0.5em;
    line-height: 1;
    vertical-align: top;
  }

  .home-prezzi__per {
    max-inline-size: 36ch;
    margin: var(--s-5) 0 0;
    font: 400 var(--fs-body) / 1.55 var(--font-testo);
    color: var(--morbido);
  }

  /* Elenco con trattino morbido, filetti tra le voci. */
  .home-prezzi__voci {
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--linea);
  }

  .home-prezzi__voci li {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    gap: var(--s-3);
    align-items: start;
    padding-block: var(--s-3);
    border-block-end: 1px solid var(--linea);
    font: 400 var(--fs-body) / 1.45 var(--font-testo);
  }

  .home-prezzi__voci li::before {
    content: '';
    inline-size: 12px;
    block-size: 1px;
    margin-block-start: 0.72em;
    background: var(--morbido);
  }

  /* CTA in fondo alla colonna: il contenitore porta lo spazio, il bottone resta com'è.
     Da 960px le CTA stanno sulla stessa altezza in tutte le colonne. */
  .home-prezzi__accesso {
    align-self: flex-start;
    margin-block: auto 0;
    padding-block-start: var(--s-6);
  }

  /* Riga finale: nota e link. */
  .home-prezzi__finale {
    display: grid;
    gap: var(--s-4);
    margin-block-start: var(--s-7);
  }

  .home-prezzi__nota {
    max-inline-size: 72ch;
    margin: 0;
    font: 400 var(--fs-body) / 1.55 var(--font-testo);
    color: var(--morbido);
  }

  .home-prezzi__finale > a {
    justify-self: start;
    color: var(--inchiostro);
  }

  @media (min-width: 640px) {
    .home-prezzi__finale {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--s-6);
    }
  }
</style>
