---
// Fascia di chiusura: H2 display in un solo tono, testo e CTA. Nessun kicker.
// Testi e attributi (data-wa, target, rel) invariati: il link WhatsApp lo riempie ContattiDinamici.
import Bottone from '../ui/Bottone.astro';
import TitoloRivelato from '../ui/TitoloRivelato.astro';
---

<section class="fascia-grafite sezione contatto" aria-labelledby="t-contatto">
  <div class="contenitore">
    <TitoloRivelato
      tag="h2"
      id="t-contatto"
      testo="Cominciamo da quello che serve alla tua attività."
      classe="contatto__titolo"
    />

    <div class="contatto__piede">
      <p class="contatto__testo">
        Raccontaci in poche righe cosa fai. Ti rispondiamo con un’indicazione chiara sui prossimi passi.
      </p>
      <div class="contatto__cta">
        <Bottone href="/preventivo/" testo="Fai il preventivo" />
        <Bottone
          href="#"
          variante="chiaro"
          testo="Scrivici su WhatsApp"
          data-wa="Ciao Trebla! Ti racconto cosa fa la mia attività."
          target="_blank"
          rel="noopener noreferrer"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .contatto__piede {
    display: grid;
    gap: var(--s-6);
    margin-block-start: var(--s-7);
  }

  .contatto__testo {
    max-inline-size: 44ch;
    font: 400 var(--fs-lead) / 1.45 var(--font-testo);
    color: var(--morbido);
  }

  .contatto__cta {
    display: grid;
    gap: var(--s-3);
  }

  .contatto__cta :global(.btn) {
    inline-size: 100%;
  }

  @media (min-width: 640px) {
    .contatto__cta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-3);
    }

    .contatto__cta :global(.btn) {
      inline-size: auto;
    }
  }

  @media (min-width: 960px) {
    .contatto__piede {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }

    .contatto__testo {
      grid-column: 1 / span 5;
    }

    .contatto__cta {
      grid-column: 7 / -1;
      justify-content: flex-end;
    }
  }
</style>
