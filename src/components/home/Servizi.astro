---
import TestataSezione from '../TestataSezione.astro';
import { BASE_PRICES } from '../../data/prezzi';
---

<section class="fascia-scura sezione home-servizi" aria-labelledby="t-servizi">
  <div class="contenitore home-servizi__griglia">
    <div class="home-servizi__testata">
      <TestataSezione
        id="t-servizi"
        scuro
        titolo="Il sito al centro, il resto intorno"
        nota="Parti da quello che ti serve ora. Il resto si aggiunge quando vuoi."
      />
    </div>

    <div class="home-servizi__lista" id="h-servizi">
      <details class="home-servizi__voce" open>
        <summary class="home-servizi__riga" data-cursore="Apri">
          <h3 class="home-servizi__nome display display--h2-s">Sito web</h3>
          <span class="home-servizi__prezzo home-servizi__prezzo--testo">{BASE_PRICES.singola}€</span>
          <span class="home-servizi__piu" aria-hidden="true"></span>
        </summary>
        <div class="home-servizi__corpo">
          <div class="home-servizi__cifre">
            <p class="home-servizi__cifra">
              <span class="home-servizi__valore display display--h2-s">{BASE_PRICES.singola}€</span>
              <span class="home-servizi__didascalia">pagina singola</span>
            </p>
            <p class="home-servizi__cifra">
              <span class="home-servizi__valore display display--h2-s">{BASE_PRICES.multi}€</span>
              <span class="home-servizi__didascalia">più pagine</span>
            </p>
          </div>
          <p class="home-servizi__testo">Il punto di partenza per farti trovare e contattare. Una pagina che spiega tutto o un sito completo.</p>
          <div class="home-servizi__liste">
            <div>
              <p class="etichetta home-servizi__titoletto">Inclusi</p>
              <ul>
                <li>Testi essenziali preparati insieme a te</li>
                <li>Telefono, WhatsApp e mappa</li>
                <li>Foto e menu sistemati</li>
                <li>Privacy e cookie inclusi</li>
              </ul>
            </div>
            <div class="home-servizi__no">
              <p class="etichetta home-servizi__titoletto">Esclusi</p>
              <ul>
                <li>Gergo tecnico</li>
                <li>Ore della tua giornata</li>
                <li>Canone obbligatorio</li>
              </ul>
            </div>
          </div>
          <a class="link-sottolineato home-servizi__link" href="/servizi/siti-web/">Il sito nel dettaglio</a>
        </div>
      </details>

      <details class="home-servizi__voce">
        <summary class="home-servizi__riga" data-cursore="Apri">
          <h3 class="home-servizi__nome display display--h2-s">Grafiche</h3>
          <span class="home-servizi__prezzo home-servizi__prezzo--testo">Su preventivo</span>
          <span class="home-servizi__piu" aria-hidden="true"></span>
        </summary>
        <div class="home-servizi__corpo">
          <div class="home-servizi__cifre">
            <p class="home-servizi__cifra">
              <span class="home-servizi__valore home-servizi__valore--testo">Su preventivo</span>
              <span class="home-servizi__didascalia">solo se ti serve</span>
            </p>
          </div>
          <p class="home-servizi__testo">La stessa faccia ovunque: dal sito al biglietto da visita, dal menu cartaceo alla vetrina.</p>
          <div class="home-servizi__liste">
            <div>
              <p class="etichetta home-servizi__titoletto">Inclusi</p>
              <ul>
                <li>Logo creato o rinnovato</li>
                <li>Biglietti da visita, volantini, menu</li>
                <li>File pronti per la stampa</li>
              </ul>
            </div>
            <div class="home-servizi__no">
              <p class="etichetta home-servizi__titoletto">Esclusi</p>
              <ul>
                <li>Restyling ogni sei mesi</li>
                <li>Stampa di qualsiasi materiale</li>
              </ul>
            </div>
          </div>
          <p class="home-servizi__nota">Solo design: non stampiamo niente, ti consegniamo i file da portare dove vuoi.</p>
          <a class="link-sottolineato home-servizi__link" href="/servizi/grafiche/">Le grafiche nel dettaglio</a>
        </div>
      </details>

      <details class="home-servizi__voce">
        <summary class="home-servizi__riga" data-cursore="Apri">
          <h3 class="home-servizi__nome display display--h2-s">Social media</h3>
          <span class="home-servizi__prezzo home-servizi__prezzo--testo">Per voce</span>
          <span class="home-servizi__piu" aria-hidden="true"></span>
        </summary>
        <div class="home-servizi__corpo">
          <div class="home-servizi__cifre">
            <p class="home-servizi__cifra">
              <span class="home-servizi__valore home-servizi__valore--testo">Per voce</span>
              <span class="home-servizi__didascalia">solo se ti serve</span>
            </p>
          </div>
          <p class="home-servizi__testo">Profili ordinati e contenuti concordati, con prezzi per singola voce e senza canone mensile implicito.</p>
          <div class="home-servizi__liste">
            <div>
              <p class="etichetta home-servizi__titoletto">Possibili</p>
              <ul>
                <li>Profili</li>
                <li>Foto e video</li>
                <li>Grafiche per contenuti</li>
              </ul>
            </div>
            <div class="home-servizi__no">
              <p class="etichetta home-servizi__titoletto">Esclusi</p>
              <ul>
                <li>Follower comprati</li>
                <li>Promesse di viralità</li>
              </ul>
            </div>
          </div>
          <a class="link-sottolineato home-servizi__link" href="/servizi/social/">I social nel dettaglio</a>
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  /* Servizi, fascia inchiostro. Da 960px la testata resta ferma a sinistra (colonne 1-5)
     e l'elenco scorre a destra (colonne 6-12). Il padding verticale è .sezione. */
  .home-servizi__griglia {
    display: grid;
    gap: var(--s-7);
  }

  .home-servizi__testata,
  .home-servizi__lista {
    min-inline-size: 0;
  }

  .home-servizi__lista {
    display: grid;
  }

  @media (min-width: 960px) {
    .home-servizi__griglia {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: start;
    }

    .home-servizi__testata {
      grid-column: 1 / span 5;
      position: sticky;
      top: calc(var(--hh) + 32px);
    }

    .home-servizi__lista {
      grid-column: 6 / span 7;
    }

    /* Nella colonna stretta il titolo occupa tutta la larghezza, senza le colonne della testata. */
    .home-servizi__testata :global(.testata) :global(.testata__titolo) {
      grid-column: 1 / -1;
    }

    .home-servizi__testata :global(.testata) :global(.testata__nota) {
      grid-column: 1 / -1;
      justify-self: start;
    }

    .home-servizi__testata :global(.testata) {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Titolo a taglia sottosezione: nella colonna laterale l'H2 pieno sarebbe troppo alto per lo sticky. */
    .home-servizi__testata :global(.testata) :global(.titolo-rivelato--h2) {
      font-size: var(--fs-h2-s);
      line-height: 0.92;
    }
  }

  /* ---------- Riga del servizio: nome e prezzo, "+" a destra ----------
     Sotto 640px il prezzo va sotto il nome. Da 640px nome, prezzo e "+" sulla stessa riga. */
  .home-servizi__voce {
    border-block-start: 1px solid var(--linea);
  }

  .home-servizi__voce:last-child {
    border-block-end: 1px solid var(--linea);
  }

  .home-servizi__riga {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'nome piu'
      'prezzo piu';
    align-items: center;
    column-gap: var(--s-4);
    row-gap: var(--s-2);
    padding-block: clamp(20px, 2.6vw, 32px);
    list-style: none;
    cursor: pointer;
  }

  .home-servizi__riga::-webkit-details-marker {
    display: none;
  }

  .home-servizi__nome {
    position: relative;
    grid-area: nome;
    min-inline-size: 0;
    margin: 0;
    color: var(--carta);
  }

  /* Hover: al massimo una sottolineatura del titolo, che entra da sinistra. Niente riempimento. */
  .home-servizi__nome::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: -0.08em;
    block-size: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform var(--t-2) var(--ease-expo);
  }

  .home-servizi__prezzo {
    grid-area: prezzo;
    justify-self: start;
    margin: 0;
    color: var(--carta);
  }

  .home-servizi__prezzo--testo {
    font: 600 var(--fs-h3) / 1.2 var(--font-ui);
    letter-spacing: -0.02em;
    text-transform: none;
    color: var(--morbido);
  }

  .home-servizi__piu {
    grid-area: piu;
    position: relative;
    flex: none;
    inline-size: 16px;
    block-size: 16px;
    margin-inline-end: var(--s-3);
    color: var(--carta);
    transition: transform var(--t-2) var(--ease-std);
  }

  .home-servizi__piu::before,
  .home-servizi__piu::after {
    content: '';
    position: absolute;
    background: currentColor;
  }

  .home-servizi__piu::before {
    inset-inline: 0;
    inset-block-start: calc(50% - 0.75px);
    block-size: 1.5px;
  }

  .home-servizi__piu::after {
    inset-block: 0;
    inset-inline-start: calc(50% - 0.75px);
    inline-size: 1.5px;
  }

  .home-servizi__voce[open] .home-servizi__piu {
    transform: rotate(45deg);
  }

  @media (min-width: 640px) {
    .home-servizi__riga {
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas: 'nome prezzo piu';
      row-gap: 0;
    }

    .home-servizi__prezzo {
      justify-self: end;
    }
  }

  @media (hover: hover) {
    .home-servizi__riga:hover .home-servizi__nome::after {
      transform: scaleX(1);
      transform-origin: left center;
    }

    .home-servizi__riga:hover .home-servizi__piu {
      transform: rotate(45deg);
    }
  }

  /* ---------- Corpo aperto ---------- */
  .home-servizi__corpo {
    padding-block: var(--s-5) clamp(40px, 5vw, 64px);
  }

  .home-servizi__voce[open] .home-servizi__corpo {
    animation: sali-corto var(--t-3) var(--ease-out) both;
  }

  /* Prezzi come oggetti: a sinistra sotto 640px, allineati a destra da 960px. */
  .home-servizi__cifre {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6) var(--s-7);
    margin: 0 0 var(--s-6);
  }

  .home-servizi__cifra {
    display: grid;
    justify-items: start;
    gap: var(--s-2);
    max-inline-size: none;
    margin: 0;
  }

  .home-servizi__valore {
    color: var(--carta);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .home-servizi__valore--testo {
    font: 600 var(--fs-h3) / 1.2 var(--font-ui);
    letter-spacing: -0.02em;
    text-transform: none;
    color: var(--carta);
  }

  .home-servizi__didascalia {
    font: 400 var(--fs-small) / 1.4 var(--font-testo);
    color: var(--morbido);
  }

  @media (min-width: 960px) {
    .home-servizi__cifre {
      justify-content: flex-end;
    }

    .home-servizi__cifra {
      justify-items: end;
      text-align: end;
    }
  }

  .home-servizi__testo {
    max-inline-size: 52ch;
    margin: 0 0 var(--s-6);
    font: 400 var(--fs-lead) / 1.45 var(--font-testo);
    color: var(--carta);
  }

  .home-servizi__liste {
    display: grid;
    gap: var(--s-6) var(--gap);
  }

  @media (min-width: 640px) {
    .home-servizi__liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .home-servizi__titoletto {
    margin: 0 0 var(--s-2);
  }

  /* Voci separate da filetti. */
  .home-servizi__liste ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--linea);
  }

  .home-servizi__liste li {
    padding-block: var(--s-3);
    border-block-end: 1px solid var(--linea);
    font: 400 var(--fs-body) / 1.45 var(--font-testo);
    color: var(--carta);
  }

  .home-servizi__no li {
    color: var(--morbido);
  }

  .home-servizi__nota {
    max-inline-size: 52ch;
    margin: var(--s-5) 0 0;
    font: 400 var(--fs-small) / 1.45 var(--font-testo);
    color: var(--morbido);
  }

  .home-servizi__link {
    display: inline-block;
    margin-block-start: var(--s-6);
    color: var(--carta);
  }
</style>
