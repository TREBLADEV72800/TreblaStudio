---
import TestataSezione from '../TestataSezione.astro';

// Metodo: cinque passi in sequenza vera, quindi i numeri restano.
const passi = [
  { t: 'Raccontaci', d: 'Due minuti col preventivo online o un messaggio su WhatsApp. Niente moduli infiniti.' },
  { t: 'Proposta chiara', d: 'Prezzo e tempi scritti nero su bianco, prima di iniziare. Se non ti torna, nessun problema.' },
  { t: 'Costruiamo', d: 'Testi insieme a te, foto tue o scattate da noi, impaginazione curata.' },
  { t: 'Rivedi due volte', d: 'Due giri di correzioni inclusi. Decidi tu quando è pronto.' },
  { t: 'Online, ed è tuo', d: 'Pubblichiamo e ti spieghiamo l’essenziale. Nessun canone obbligatorio verso di noi.' },
];
---

<section class="home-metodo sezione" aria-labelledby="t-metodo">
  <div class="contenitore">
    <TestataSezione
      id="t-metodo"
      titolo="Tu lavori, noi al resto"
      nota="Cinque passi, un solo referente, zero tempo perso."
    />
    <ol class="home-metodo__filo" id="h-metodo">
      {
        passi.map((p, i) => (
          <li class="home-metodo__passo">
            <span class="home-metodo__num">{i + 1}</span>
            <h3 class="home-metodo__titolo">{p.t}</h3>
            <p class="home-metodo__testo">{p.d}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Sequenza verticale a tutte le larghezze. Un filo continuo corre dalla prima all'ultima voce
     e i numeri stanno sopra, come nodi. Il filo è a sinistra: sotto 960px titolo e testo
     rientrano di poco, così la riga resta larga. */
  .home-metodo__filo {
    position: relative;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-metodo__filo::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: 1px;
    background: var(--linea);
  }

  .home-metodo__passo {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
  }

  .home-metodo__passo + .home-metodo__passo {
    padding-block-start: var(--s-7);
  }

  /* Il numero sta sul filo: il fondo carta lo interrompe dove c'è il numero. */
  .home-metodo__num {
    justify-self: start;
    padding-inline-end: var(--s-2);
    background: var(--carta);
    font: 800 clamp(48px, 6vw, 72px) / 0.9 var(--font-display);
    font-stretch: 64%;
    letter-spacing: -0.01em;
    font-variant-numeric: lining-nums;
    color: var(--inchiostro);
  }

  .home-metodo__titolo {
    margin-block-start: var(--s-3);
    margin-inline-start: var(--s-4);
    color: var(--inchiostro);
  }

  .home-metodo__testo {
    max-inline-size: 42ch;
    margin-block-start: var(--s-2);
    margin-inline-start: var(--s-4);
    font: 400 var(--fs-body) / 1.55 var(--font-testo);
    color: var(--morbido);
  }

  /* Da 960px: numero, titolo e testo sulla stessa riga di 12 colonne. Il filo resta a sinistra. */
  @media (min-width: 960px) {
    .home-metodo__passo {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: start;
    }

    .home-metodo__passo + .home-metodo__passo {
      padding-block-start: var(--s-7);
    }

    .home-metodo__num {
      grid-column: 1 / span 2;
      grid-row: 1;
      padding-inline-end: var(--gap);
    }

    .home-metodo__titolo {
      grid-column: 3 / span 4;
      grid-row: 1;
      margin: var(--s-2) 0 0;
    }

    .home-metodo__testo {
      grid-column: 7 / span 6;
      grid-row: 1;
      max-inline-size: 36em;
      margin: var(--s-2) 0 0;
      font-size: var(--fs-body);
    }
  }
</style>
