---
// Testata comune delle pagine interne: percorso, H1 display che si rivela, lead e contenuti extra.
// titolo: testo dell'H1. Il "|" forza un a capo (come in TitoloRivelato).
// percorso: voci del percorso. La prima è di norma { testo: 'Home', href: '/' }.
//   L'ultima è la pagina corrente: senza link, aria-current="page".
// codice: testo semplice sopra l'H1, morbido 14px (es. "Errore 404").
// etichetta: ignorata. Il design non ha più etichette sopra l'H1; usare codice.
// taglia: dimensione dell'H1 (h2 di default, oppure hero).
// Slot "lead": paragrafo introduttivo (HTML ammesso). Slot "oggetto": illustrazione o esempio della pagina.
// Da 960px sta nelle colonne 8-12, accanto al titolo; sotto 960px va sotto il lead.
// Slot default: contenuto sotto il lead (azioni, bottoni).
import TitoloRivelato from './ui/TitoloRivelato.astro';

interface Voce {
  testo: string;
  href?: string | undefined;
}

interface Props {
  titolo: string;
  percorso?: Voce[] | undefined;
  codice?: string | undefined;
  /** Ignorata: vedi nota sopra. */
  etichetta?: string | undefined;
  id?: string | undefined;
  taglia?: 'h2' | 'hero' | undefined;
}

const { titolo, percorso, codice, id } = Astro.props;
const taglia = Astro.props.taglia ?? 'h2';
const haPercorso = !!percorso && percorso.length > 0;
const ultima = haPercorso ? percorso.length - 1 : -1;
const haLead = Astro.slots.has('lead');
const haOggetto = Astro.slots.has('oggetto');
const haExtra = Astro.slots.has('default');
---

<header class:list={['tp', 'contenitore', { 'tp--oggetto': haOggetto }]}>
  {
    haPercorso && (
      <nav class="tp__percorso" aria-label="Percorso di navigazione">
        <ol>
          {percorso!.map((voce, i) => {
            const corrente = i === ultima;
            return (
              <li>
                {!corrente && voce.href ? (
                  <a href={voce.href} class="link-sottolineato">{voce.testo}</a>
                ) : (
                  <span aria-current={corrente ? 'page' : undefined}>{voce.testo}</span>
                )}
              </li>
            );
          })}
        </ol>
      </nav>
    )
  }

  {codice && <p class="tp__codice">{codice}</p>}

  <TitoloRivelato
    tag="h1"
    immediato
    testo={titolo}
    taglia={taglia}
    id={id}
    classe={taglia === 'h2' ? 'tp__titolo tp__titolo--h2' : 'tp__titolo'}
  />

  {
    haLead && (
      <div class="tp__lead entra" style="--d:calc(var(--t-1) * 2)">
        <slot name="lead" />
      </div>
    )
  }

  {
    haOggetto && (
      <div class="tp__oggetto">
        <slot name="oggetto" />
      </div>
    )
  }

  {
    haExtra && (
      <div class="tp__extra entra" style="--d:calc(var(--t-1) * 3)">
        <slot />
      </div>
    )
  }
</header>

<style>
  /* Testata pagina interna. Mobile-first: tutto in colonna. Da 960px lead e azioni stanno
     sotto il titolo, allineati a sinistra.
     Il titolo è TitoloRivelato: la sua radice riceve tp__titolo, quindi i suoi stili
     passano da :global (come in TestataSezione). */
  .tp {
    padding-block-start: clamp(48px, 8vw, 128px);
    padding-block-end: clamp(40px, 6vw, 96px);
  }

  /* Percorso di navigazione: Archivo 14px, frase normale. Ogni link ha almeno 24px di altezza di tocco. */
  .tp__percorso {
    margin: 0 0 clamp(24px, 4vw, 56px);
    font: 600 var(--fs-small) / 1.4 var(--font-ui);
    letter-spacing: 0;
    text-transform: none;
    color: var(--morbido);
  }

  .tp__percorso ol {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tp__percorso li {
    display: flex;
    align-items: center;
  }

  /* Le barre tra le voci stanno in CSS, quindi non vengono lette dagli screen reader. */
  .tp__percorso li + li::before {
    content: "/";
    padding-inline: 8px;
  }

  .tp__percorso a,
  .tp__percorso span {
    display: inline-flex;
    align-items: center;
    min-block-size: 24px;
  }

  .tp__percorso a {
    color: var(--inchiostro);
  }

  .tp__codice {
    margin: 0 0 clamp(24px, 4vw, 56px);
    font: 400 var(--fs-small) / 1.4 var(--font-testo);
    color: var(--morbido);
  }

  .tp :global(.tp__titolo) {
    margin: 0;
    inline-size: 100%;
    max-inline-size: none;
  }

  .tp :global(.tp__titolo--h2) {
    max-inline-size: 18ch;
  }

  .tp__lead {
    max-inline-size: 52ch;
    margin-block-start: clamp(24px, 3vw, 40px);
    font: 400 var(--fs-lead) / 1.45 var(--font-testo);
    color: var(--morbido);
  }

  .tp__extra {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin-block-start: var(--s-6);
  }

  /* Con oggetto le azioni hanno un solo contenitore a blocco: occupano la larghezza della colonna. */
  .tp--oggetto .tp__extra {
    display: block;
  }

  /* L'oggetto: il wrapper non ha box, così il figlio è una voce diretta della griglia. */
  .tp__oggetto {
    display: contents;
  }

  @media (min-width: 960px) {
    .tp {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
    }

    .tp__percorso,
    .tp__codice,
    .tp :global(.tp__titolo) {
      grid-column: 1 / -1;
    }

    .tp__lead,
    .tp__extra {
      grid-column: 1 / -1;
      justify-self: start;
    }

    /* Con oggetto: il titolo sta nelle colonne 1-7, l'oggetto nelle colonne 8-12 accanto al titolo.
       Lead e azioni vanno sotto, a sinistra. order fissa l'ordine di collocamento della griglia
       (la griglia sparsa non torna indietro): prima titolo e oggetto, poi lead e azioni. */
    .tp--oggetto :global(.tp__titolo) {
      grid-column: 1 / span 7;
    }

    /* L'oggetto è figlio diretto della griglia: il suo wrapper non ha box (display: contents). */
    .tp--oggetto .tp__oggetto > :global(*) {
      grid-column: 8 / -1;
      grid-row: span 2;
      justify-self: end;
      align-self: center;
    }

    .tp--oggetto .tp__lead {
      grid-column: 1 / span 6;
      justify-self: start;
      margin-block-start: var(--s-5);
      order: 1;
    }

    .tp--oggetto .tp__extra {
      grid-column: 1 / span 7;
      justify-self: stretch;
      order: 2;
    }
  }
</style>
