    const btn=document.createElement('button');
    btn.type='button';
    btn.className='choice'+(form.designNeeds.includes(d.name)?' selected':'');
    btn.textContent=d.name+' (+'+d.price+' €)';
    btn.addEventListener('click',()=>{
      if(form.designNeeds.includes(d.name)) form.designNeeds=form.designNeeds.filter(x=>x!==d.name);
      else form.designNeeds.push(d.name);
      renderDesign(); updateUI();
    });
    grid.appendChild(btn);
  });
}

function sendQuote(){
  const hasSite=form.services.includes('site');
  const hasSocial=form.services.includes('social');
  const hasDesign=form.services.includes('design');
  const isAltro=form.type==='Altro';
  if(!hasSite && !hasSocial && !hasDesign){ alert('Seleziona almeno un servizio (Sito, Social o Design).'); return; }
  const selectedServices=form.services.map(id=> id==='site'?'Sito Web':id==='social'?'Social Media':'Design e Grafiche').join(' + ');
  const lines=['*Ciao Trebla Studio!*','Vorrei richiedere un preventivo per la mia attività.','','━━━━━━━━━━━━━━━━━━━','*DATI ATTIVITÀ*','• *Nome:* '+(form.name||'Non specificato'),'• *Settore:* '+(form.type==='Altro' && form.typeOther.trim() ? 'Altro ('+form.typeOther.trim()+')' : form.type),'• *Servizi scelti:* '+selectedServices,'━━━━━━━━━━━━━━━━━━━'];
  if(hasSite){
    lines.push('','*SITO WEB*','• *Struttura:* '+form.structure);
    if(isAltro) lines.push('• *Esigenze specifiche:* da definire insieme');
    else lines.push('• *Funzioni:* '+(form.features.length?form.features.join(', '):'Standard'),'• *Pagine:* '+(form.pages.length?form.pages.join(', '):'Standard'),'• *Foto:* '+form.photos);
  }
  if(hasSocial) lines.push('','*SOCIAL MEDIA*','• *Canali:* '+(form.socialPlatforms.join(', ')||'Da decidere'),'• *Opzioni:* '+(form.socialNeeds.join(', ')||'Da decidere'));
  if(hasDesign) lines.push('','*DESIGN & GRAFICHE*','• *Materiali:* '+(form.designNeeds.join(', ')||'Da decidere'));
  lines.push('','━━━━━━━━━━━━━━━━━━━','*PIANIFICAZIONE*');
  if(!isAltro) lines.push('• *Obiettivi:* '+form.goals.join(', '));
  lines.push('• *Tempi desiderati:* '+(form.timing||'Da definire'),'','*TOTALE INDICATIVO:* '+currentTotal()+' €','━━━━━━━━━━━━━━━━━━━');
  if(form.notes && form.notes.trim()) lines.push('','*NOTE AGGIUNTIVE:*',form.notes.trim());
  if(form.bannerDiscount) lines.push('','*Sconto partner richiesto*');
  let message=lines.join('\n');
  const MAX=1800;
  if(message.length>MAX) message=message.slice(0,MAX-20)+'\n... (testo troncato)';
  window.open('https://wa.me/'+whatsapp+'?text='+encodeURIComponent(message),'_blank','noopener,noreferrer');
  document.getElementById('submitted-box').style.display='block';
}

document.addEventListener('DOMContentLoaded',()=>{
  // initial services from URL
  const params=new URLSearchParams(window.location.search);
  const svc=params.get('services')||params.get('service');
  const init=parseServices(svc);
  if(init.length) form.services=init;

  renderTypeCategories();
  renderFeatures();
  renderPages();
  renderGoals();
  renderSocial();
  renderDesign();

  // events
  document.getElementById('field-name').addEventListener('input',e=>{
    form.name=e.target.value.slice(0,80);
    updateUI();
  });
  document.getElementById('type-search').addEventListener('input',e=>{
    const q=e.target.value.trim().toLowerCase();
    const results=document.getElementById('type-results');
    const cats=document.getElementById('type-categories');
    const altro=document.getElementById('type-altro');
    if(q){
      results.style.display='flex';
      cats.style.display='none';
      altro.style.display='none';
      results.innerHTML='';
      const filtered=businessTypes.filter(t=>t.toLowerCase().includes(q));
      filtered.forEach(type=>{
        const btn=document.createElement('button');
        btn.type='button';
        btn.className='choice'+(form.type===type?' selected':'');
        btn.textContent=type;
        btn.addEventListener('click',()=>{
          form.type=type; form.features=[]; form.pages=[];
          document.getElementById('type-search').value='';
          results.style.display='none';
          cats.style.display='block';
          altro.style.display='block';
          renderTypeCategories(); renderFeatures(); updateUI();
        });
        results.appendChild(btn);
      });
      if(filtered.length===0){
        const p=document.createElement('p');
        p.className='form-help';
        p.textContent='Nessun risultato, seleziona Altro.';
        results.appendChild(p);
      }
    } else {
      results.style.display='none';
      cats.style.display='block';
      altro.style.display='block';
    }
  });
  document.getElementById('type-altro').addEventListener('click',()=>{
    form.type='Altro'; form.features=[]; form.pages=[];
    renderTypeCategories(); renderFeatures(); updateUI();
  });
  document.getElementById('type-other').addEventListener('input',e=>{
    form.typeOther=e.target.value.slice(0,80);
    updateUI();
  });
  document.querySelectorAll('.service-choice').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const id=btn.getAttribute('data-service');
      if(id==='site'){
        if(form.services.includes('site')) form.services=[];
        else form.services=['site'];
      } else {
        if(form.services.includes(id)) form.services=form.services.filter(s=>s!==id);
        else form.services.push(id);
      }
      document.querySelectorAll('.service-choice').forEach(b=>{
        const sid=b.getAttribute('data-service');
        const sel=form.services.includes(sid);
        b.classList.toggle('selected', sel);
        b.setAttribute('aria-pressed', sel);
        b.querySelector('span').textContent=sel?'✓':'+';
      });
      updateUI();
    });
  });
  document.querySelectorAll('[data-structure]').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const v=btn.getAttribute('data-structure');
      form.structure=v;
      document.querySelectorAll('[data-structure]').forEach(b=>b.classList.toggle('selected', b.getAttribute('data-structure')===v));
      updateUI();
    });
  });
  document.querySelectorAll('[data-photo]').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const v=btn.getAttribute('data-photo');
      form.photos=v;
      document.querySelectorAll('[data-photo]').forEach(b=>b.classList.toggle('selected', b.getAttribute('data-photo')===v));
      updateUI();
    });
  });
  document.querySelectorAll('[data-timing]').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const v=btn.getAttribute('data-timing');
      form.timing=v;
      document.querySelectorAll('[data-timing]').forEach(b=>{
        const sel=b.getAttribute('data-timing')===v;
        b.classList.toggle('selected', sel);
        b.setAttribute('aria-pressed', sel);
      });
      updateUI();
    });
  });
  document.getElementById('field-notes').addEventListener('input',e=>{
    form.notes=e.target.value.slice(0,800);
    updateUI();
  });
  document.getElementById('privacy-check').addEventListener('change',e=>{
    form.privacy=e.target.checked;
    updateUI();
  });
  document.getElementById('banner-discount').addEventListener('click',()=>{
    form.bannerDiscount=!form.bannerDiscount;
    updateUI();
  });
  document.getElementById('quote-form').addEventListener('submit',e=>{
    e.preventDefault();
    if(!estimateRevealed){
      const missing=getMissing();
      if(missing.length===0 && form.privacy){
        revealTime=Date.now();
        estimateRevealed=true;
        updateUI();
      }
      return;
    }
    if(Date.now()-revealTime<1000) return;
    sendQuote();
  });
  document.getElementById('estimate-cta').addEventListener('click',()=>{
    const missing=getMissing();
    if(missing.length===0 && form.privacy){
      revealTime=Date.now();
      estimateRevealed=true;
      updateUI();
    }
  });

  // init UI from URL services
  document.querySelectorAll('.service-choice').forEach(b=>{
    const sid=b.getAttribute('data-service');
    const sel=form.services.includes(sid);
    b.classList.toggle('selected', sel);
    b.setAttribute('aria-pressed', sel);
    b.querySelector('span').textContent=sel?'✓':'+';
  });
  updateUI();
});
</script>
