function getMissing(){
  const hasSite=form.services.includes('site');
  const hasSocial=form.services.includes('social');
  const hasDesign=form.services.includes('design');
  const isAltro=form.type==='Altro';
  const nomeOk=form.name.trim().length>=2;
  const tipoOk=!!form.type && (!isAltro || form.typeOther.trim().length>=2);
  const serviziOk=hasSite||hasSocial||hasDesign;
  const strutturaOk=!hasSite||isAltro||!!form.structure;
  const fotoOk=!hasSite||isAltro||!!form.photos;
  const socialOk=!hasSocial||(form.socialPlatforms.length>0 && form.socialNeeds.length>0);
  const designOk=!hasDesign||form.designNeeds.length>0;
  const obiettiviOk=isAltro||form.goals.length>0;
  const timingOk=!!form.timing;
  const missing=[];
  if(!nomeOk) missing.push('il nome della tua attività');
  if(!tipoOk) missing.push('il tipo di attività');
  if(!serviziOk) missing.push('un servizio (Sito, Social o Design)');
  if(hasSite && !isAltro && !strutturaOk) missing.push('la struttura del sito');
  if(hasSite && !isAltro && !fotoOk) missing.push('le foto');
  if(hasSocial && !socialOk) missing.push('le scelte Social Media');
  if(hasDesign && !designOk) missing.push('i materiali grafici');
  if(!isAltro && !obiettiviOk) missing.push('un obiettivo');
  if(!timingOk) missing.push('i tempi desiderati');
  return missing;
}

function updateUI(){
  const hasSite=form.services.includes('site');
  const hasSocial=form.services.includes('social');
  const hasDesign=form.services.includes('design');
  const isAltro=form.type==='Altro';
  const nomeOk=form.name.trim().length>=2;
  const tipoOk=!!form.type && (!isAltro || form.typeOther.trim().length>=2);
  const serviziOk=hasSite||hasSocial||hasDesign;
  // blocks pending
  document.getElementById('block-name').classList.toggle('pending', !nomeOk);
  document.getElementById('name-error').style.display=nomeOk?'none':'block';
  document.getElementById('block-type').classList.toggle('pending', !tipoOk);
  document.getElementById('block-services').classList.toggle('pending', !serviziOk);
  // type other
  document.getElementById('type-other-wrap').style.display=form.type==='Altro'?'block':'none';
  // site details
  document.getElementById('site-details').style.display=hasSite && form.type ? 'block' : 'none';
  if(hasSite && form.type){
    const showStructure=!isAltro;
    document.getElementById('block-structure').style.display=showStructure?'block':'none';
    document.getElementById('block-features').style.display='block';
    document.getElementById('feature-type-label').textContent=form.type;
    document.getElementById('block-pages').style.display=showStructure?'block':'none';
    document.getElementById('block-photos').style.display=showStructure?'block':'none';
    const fotoOk=!isAltro && !!form.photos;
    document.getElementById('block-photos').classList.toggle('pending', !fotoOk && !isAltro);
  }
  document.getElementById('social-details').style.display=hasSocial?'block':'none';
  if(hasSocial) document.getElementById('social-type-label').textContent=form.type||'';
  document.getElementById('design-details').style.display=hasDesign?'block':'none';
  if(hasDesign) document.getElementById('design-type-label').textContent=form.type||'';
  // goals block hidden for Altro
  document.getElementById('block-goals').style.display=isAltro?'none':'block';
  // step label
  const step=document.getElementById('step-label');
  const missingEl=document.getElementById('missing-label');
  let stepLabel='';
  if(!nomeOk || !tipoOk) stepLabel='Passo 1 di 4, attività';
  else if(!serviziOk) stepLabel='Passo 2 di 4, servizi';
  else if((!isAltro && form.goals.length===0) || !form.timing) stepLabel='Passo 3 di 4, obiettivi e tempi';
  else if(!form.privacy) stepLabel='Passo 4 di 4, privacy';
  else stepLabel='Pronto per la stima';
  step.textContent=stepLabel;
  const missing=getMissing();
  if(missing.length===0 && form.privacy) missingEl.textContent='Pronto';
  else missingEl.textContent=missing.length+' da completare';
  missingEl.style.color=missing.length? '#b35a00':'#0a7a2e';
  // banner
  const bannerBtn=document.getElementById('banner-discount');
  if(form.bannerDiscount){
    bannerBtn.classList.add('selected');
    bannerBtn.textContent='Sconto partner applicato −20 €';
  } else {
    bannerBtn.classList.remove('selected');
    bannerBtn.textContent='Applica sconto partner −20 €';
  }
  updateEstimate();
}

function renderTypeCategories(){
  const container=document.getElementById('type-categories');
  container.innerHTML='';
  Object.entries(businessCategories).forEach(([cat,types])=>{
    const details=document.createElement('details');
    details.style.borderBottom='1px solid var(--line)';
    details.style.padding='10px 0';
    const summary=document.createElement('summary');
    summary.style.cursor='pointer';
    summary.style.font='700 13px var(--mono)';
    summary.style.letterSpacing='0.04em';
    summary.style.textTransform='uppercase';
    summary.style.color='var(--ink)';
    summary.textContent=cat+', '+types.length;
    details.appendChild(summary);
    const grid=document.createElement('div');
    grid.className='choice-grid';
    grid.style.marginTop='10px';
    types.forEach(type=>{
      const btn=document.createElement('button');
      btn.type='button';
      btn.className='choice'+(form.type===type?' selected':'');
      btn.textContent=type;
      if(type==='Professionista'){
        btn.innerHTML='<span style="font-weight:700">Professionista</span><span style="font-weight:400;margin-left:6px;color:var(--muted)">, geometra, commercialista...</span>';
      }
      btn.addEventListener('click',()=>{
        form.type=type; form.features=[]; form.pages=[];
        renderTypeCategories(); renderFeatures(); updateUI();
      });
      grid.appendChild(btn);
    });
    details.appendChild(grid);
    container.appendChild(details);
  });
}

function renderFeatures(){
  const grid=document.getElementById('features-grid');
  if(!grid) return;
  grid.innerHTML='';
  const list=featuresByType[form.type]||[];
  list.forEach(feat=>{
    const btn=document.createElement('button');
    btn.type='button';
    btn.className='choice'+(form.features.includes(feat.name)?' selected':'');
    btn.textContent=feat.name;
    btn.addEventListener('click',()=>{
      if(form.features.includes(feat.name)) form.features=form.features.filter(x=>x!==feat.name);
      else form.features.push(feat.name);
      renderFeatures(); updateUI();
    });
    grid.appendChild(btn);
  });
}

