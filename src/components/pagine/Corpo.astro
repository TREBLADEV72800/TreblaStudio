---
// Corpo delle pagine interne: il testo (di norma un <Prosa>) sta nello slot.
// etichetta: testo mono con puntino mattone nella colonna laterale, sticky da 960px (colonne 1-3).
// Con l'etichetta il testo va nelle colonne 4-10. Senza, occupa le colonne 1-8.
interface Props {
  etichetta?: string | undefined;
}

const { etichetta } = Astro.props;
---

<div class:list={['corpo', 'contenitore', etichetta && 'corpo--lato']}>
  {
    etichetta && (
      <p class="etichetta corpo__lato">
        <span class="puntino puntino--mattone" aria-hidden="true"></span>
        {etichetta}
      </p>
    )
  }
  <div class="corpo__testo" data-reveal>
    <slot />
  </div>
</div>

<style>
  .corpo {
    display: grid;
    gap: var(--s-5) var(--gap);
  }

  .corpo__lato {
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--linea);
  }

  .corpo__testo {
    min-inline-size: 0;
  }

  @media (min-width: 960px) {
    .corpo {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .corpo__lato {
      grid-column: 1 / span 3;
      position: sticky;
      inset-block-start: calc(var(--hh) + 32px);
    }

    .corpo__testo {
      grid-column: 1 / span 8;
    }

    .corpo--lato .corpo__testo {
      grid-column: 4 / span 7;
    }
  }
</style>
