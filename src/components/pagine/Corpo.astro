---
// Corpo delle pagine interne: il testo (di norma un <Prosa>) sta nello slot.
// Una sola colonna: da 960px occupa le colonne 1-8. La misura del testo la dà Prosa (34em).
// etichetta: accettata per le pagine non ancora migrate, ma ignorata: il testo parte direttamente,
// senza etichette sopra i blocchi.
interface Props {
  /** Ignorata: vedi nota sopra. */
  etichetta?: string | undefined;
}
---

<div class="corpo contenitore">
  <div class="corpo__testo">
    <slot />
  </div>
</div>

<style>
  .corpo {
    display: grid;
  }

  .corpo__testo {
    min-inline-size: 0;
  }

  @media (min-width: 960px) {
    .corpo {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
    }

    .corpo__testo {
      grid-column: 1 / span 8;
    }
  }
</style>
