---
// Riga di contatto della pagina /contatti: etichetta mono del canale, valore in display, freccia.
// Con href il valore è un link che copre tutta la riga (link esteso con ::after), quindi tutta la riga è cliccabile.
// Il link contiene solo testo: ContattiDinamici può sostituirlo (data-mostra) senza rimuovere la freccia,
// che sta fuori dal link.
// Senza href è una riga di sola lettura (sede): niente hover, niente freccia.
// Gli attributi extra (data-wa, data-tel, data-mail, data-mostra, data-soggetto, target, rel) vanno sul link così come sono.
// cursore: etichetta del cursore che segue (data-cursore), es. "Scrivi" o "Chiama".
import Freccia from '../ui/Freccia.astro';

interface Props {
  canale: string;
  valore: string;
  href?: string | undefined;
  cursore?: string | undefined;
  [attr: string]: unknown;
}

const { canale, valore, href, cursore, ...resto } = Astro.props;
---

<div class:list={['contatti-riga', href && 'contatti-riga--link']} data-reveal>
  <p class="contatti-riga__canale">{canale}</p>
  {
    href ? (
      <a class="contatti-riga__valore" href={href} data-cursore={cursore} {...resto}>{valore}</a>
    ) : (
      <p class="contatti-riga__valore">{valore}</p>
    )
  }
  {
    href && (
      <span class="contatti-riga__freccia" aria-hidden="true">
        <Freccia />
      </span>
    )
  }
</div>

<style>
  /* Riga: tre aree (canale, valore, freccia). Mobile: canale sopra, valore sotto, freccia a destra.
     Da 960px: canale a sinistra, valore al centro, freccia a destra, su una riga. */
  .contatti-riga {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'canale freccia'
      'valore freccia';
    align-items: center;
    gap: var(--s-2) var(--s-4);
    padding-block: var(--s-5);
    padding-inline: var(--s-4);
    border-block-end: 1px solid var(--linea);
  }

  @media (min-width: 960px) {
    .contatti-riga {
      grid-template-columns: minmax(0, 200px) minmax(0, 1fr) auto;
      grid-template-areas: 'canale valore freccia';
      column-gap: var(--s-6);
      padding-block: clamp(24px, 3vw, 40px);
    }
  }

  .contatti-riga__canale {
    grid-area: canale;
    margin: 0;
    font: 500 var(--fs-label) / 1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--morbido);
    transition: color var(--t-2) var(--ease-std);
  }

  /* Valore: display come le sottosezioni (--fs-h2-s). Il font shorthand azzera font-stretch: va scritto dopo. */
  .contatti-riga__valore {
    grid-area: valore;
    margin: 0;
    font: 800 var(--fs-h2-s) / 0.92 var(--font-display);
    font-stretch: 64%;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--inchiostro);
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  /* Link esteso: il ::after copre la riga (la freccia non ha posizione, quindi resta cliccabile). */
  .contatti-riga--link .contatti-riga__valore::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Riempimento mattone che sale dal basso (scaleY). Sta dietro al testo (z -1, isolation sulla riga). */
  .contatti-riga--link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--mattone);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform var(--t-3) var(--ease-expo);
  }

  .contatti-riga__freccia {
    grid-area: freccia;
    display: grid;
    place-items: center;
    inline-size: 24px;
    block-size: 24px;
    color: var(--inchiostro);
    transition: transform var(--t-3) var(--ease-expo);
  }

  .contatti-riga__freccia :global(svg) {
    inline-size: 100%;
    block-size: 100%;
  }

  @media (min-width: 960px) {
    .contatti-riga__freccia {
      inline-size: 36px;
      block-size: 36px;
    }
  }

  /* Stato attivo: hover (solo dove c'è hover) o focus da tastiera sul link della riga. */
  .contatti-riga--link:has(.contatti-riga__valore:focus-visible)::before {
    transform: scaleY(1);
  }

  .contatti-riga--link:has(.contatti-riga__valore:focus-visible) .contatti-riga__canale {
    color: var(--inchiostro);
  }

  @media (hover: hover) {
    .contatti-riga--link:hover::before {
      transform: scaleY(1);
    }

    .contatti-riga--link:hover .contatti-riga__canale {
      color: var(--inchiostro);
    }

    .contatti-riga--link:hover .contatti-riga__freccia {
      transform: rotate(45deg);
    }
  }
</style>
