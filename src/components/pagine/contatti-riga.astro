---
// Riga di contatto della pagina /contatti: canale (etichetta), valore, freccia.
// Con href il valore è un link che copre tutta la riga (link esteso con ::after), quindi tutta la riga è cliccabile.
// Il link contiene solo testo: ContattiDinamici può sostituirlo (data-mostra) senza rimuovere la freccia,
// che sta fuori dal link.
// Senza href è una riga di sola lettura (sede): niente hover, niente freccia.
// taglia: "h2" (display, default) per i canali; "h3" (Archivo 600) per le righe che non sono un canale.
// Gli attributi extra (data-wa, data-tel, data-mail, data-mostra, data-soggetto, target, rel) vanno sul link così come sono.
import Freccia from '../ui/Freccia.astro';

interface Props {
  canale: string;
  valore: string;
  href?: string | undefined;
  taglia?: 'h2' | 'h3' | undefined;
  [attr: string]: unknown;
}

const { canale, valore, href, taglia = 'h2', ...resto } = Astro.props;
---

<div class:list={['contatti-riga', href && 'contatti-riga--link', `contatti-riga--${taglia}`]}>
  <p class="contatti-riga__canale">{canale}</p>
  {
    href ? (
      <a class="contatti-riga__valore" href={href} {...resto}>{valore}</a>
    ) : (
      <p class="contatti-riga__valore">{valore}</p>
    )
  }
  {
    href && (
      <span class="contatti-riga__freccia" aria-hidden="true">
        <Freccia />
      </span>
    )
  }
</div>

<style>
  /* Riga: tre aree (canale, valore, freccia). Mobile: canale sopra, valore sotto, freccia a destra.
     Da 960px: canale a sinistra, valore al centro, freccia a destra, su una riga.
     Tra testo e freccia sempre almeno --s-5. */
  .contatti-riga {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'canale freccia'
      'valore freccia';
    align-items: center;
    column-gap: var(--s-5);
    row-gap: var(--s-2);
    padding-block: var(--s-5);
    border-block-end: 1px solid var(--linea);
  }

  @media (min-width: 960px) {
    .contatti-riga {
      grid-template-columns: minmax(0, 200px) minmax(0, 1fr) auto;
      grid-template-areas: 'canale valore freccia';
      column-gap: var(--s-6);
      padding-block: clamp(24px, 3vw, 40px);
    }
  }

  /* Canale: etichetta di supporto, Archivo 600 14px, frase normale, morbido. */
  .contatti-riga__canale {
    grid-area: canale;
    margin: 0;
    font: 600 var(--fs-small) / 1.4 var(--font-ui);
    letter-spacing: 0;
    text-transform: none;
    color: var(--morbido);
    transition: color var(--t-2) var(--ease-std);
  }

  /* Valore: display come le sottosezioni (--fs-h2-s). Il font shorthand azzera font-stretch: va scritto dopo. */
  .contatti-riga__valore {
    grid-area: valore;
    margin: 0;
    font: 800 var(--fs-h2-s) / 0.92 var(--font-display);
    font-stretch: 64%;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--inchiostro);
    /* break-word: va a capo su un'@ o un punto quando può, e spezza una parola solo se non ha scelta.
       anywhere spezzerebbe l'indirizzo email a metà (GM / AIL). */
    overflow-wrap: break-word;
    text-decoration: none;
  }

  /* Variante h3: sede e righe che non sono canali. Archivo 600, frase normale. */
  .contatti-riga--h3 .contatti-riga__valore {
    font: 600 var(--fs-h3) / 1.15 var(--font-ui);
    letter-spacing: -0.02em;
    text-transform: none;
  }

  /* Link esteso: il ::after copre la riga (la freccia non ha posizione, quindi resta cliccabile). */
  .contatti-riga--link .contatti-riga__valore::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .contatti-riga__freccia {
    grid-area: freccia;
    display: grid;
    place-items: center;
    inline-size: 24px;
    block-size: 24px;
    color: var(--inchiostro);
    transition: transform var(--t-3) var(--ease-expo);
  }

  .contatti-riga__freccia :global(svg) {
    inline-size: 100%;
    block-size: 100%;
  }

  @media (min-width: 960px) {
    .contatti-riga__freccia {
      inline-size: 36px;
      block-size: 36px;
    }
  }

  /* Stato attivo: hover (solo dove c'è hover) o focus da tastiera. Nessun fondo colorato: il mattone resta
     solo sul bottone primario. La riga cambia il canale in inchiostro e la freccia si sposta. */
  .contatti-riga--link:has(.contatti-riga__valore:focus-visible) .contatti-riga__canale {
    color: var(--inchiostro);
  }

  @media (hover: hover) {
    .contatti-riga--link:hover .contatti-riga__canale {
      color: var(--inchiostro);
    }

    .contatti-riga--link:hover .contatti-riga__freccia {
      transform: translate3d(3px, -3px, 0);
    }
  }
</style>
