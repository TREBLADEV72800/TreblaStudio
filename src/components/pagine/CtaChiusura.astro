---
// Chiusura compatta delle pagine interne, su fascia grafite: titolo display (--fs-h2-s),
// testo e bottoni nello slot. Il titolo ha un solo tono e niente etichetta sopra.
// etichetta e tenue: accettate per le pagine non ancora migrate, ma ignorate.
import TitoloRivelato from '../ui/TitoloRivelato.astro';

interface Props {
  id: string;
  /** Ignorata: niente etichetta sopra il titolo. */
  etichetta?: string | undefined;
  titolo: string;
  /** Ignorata: il titolo ha un solo tono. */
  tenue?: string | undefined;
  testo: string;
}

const { id, titolo, testo } = Astro.props;
---

<section class="fascia-grafite sezione chiusura" aria-labelledby={id}>
  <div class="contenitore chiusura__griglia">
    <div class="chiusura__testo">
      <TitoloRivelato tag="h2" id={id} testo={titolo} taglia="h2-s" classe="chiusura__titolo" />
      <p class="chiusura__testo-lead">{testo}</p>
    </div>
    <div class="chiusura__azioni">
      <slot />
    </div>
  </div>
</section>

<style>
  .chiusura__griglia {
    display: grid;
    gap: var(--s-6);
  }

  .chiusura__testo {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }

  .chiusura__testo-lead {
    max-inline-size: 44ch;
    margin: 0;
    font: 400 var(--fs-lead) / 1.45 var(--font-testo);
    color: var(--morbido);
  }

  .chiusura__azioni {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  :global(.titolo-rivelato.chiusura__titolo) {
    max-inline-size: none;
  }

  @media (min-width: 960px) {
    .chiusura__griglia {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
      column-gap: var(--gap);
    }

    .chiusura__testo {
      grid-column: 1 / span 8;
    }

    .chiusura__azioni {
      grid-column: 9 / span 4;
      justify-content: flex-end;
    }
  }
</style>
