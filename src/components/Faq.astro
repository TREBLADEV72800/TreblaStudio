---
import type { Faq } from '../data/faq';

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<div class="faq" data-reveal>
  {faqs.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <div class="risposta">
        <p>{f.a}{f.cta && f.cta.map((c) => (<> <a class="link-freccia" href={c.href}>{c.label}</a></>))}</p>
      </div>
    </details>
  ))}
</div>
