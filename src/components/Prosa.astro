---
// Contenitore per i testi lunghi delle pagine interne (servizi in dettaglio, accessibilità,
// note legali, metodo). Il contenuto arriva dallo slot: per questo gli elementi annidati
// si stilano con :global().
// Misura: p e liste al massimo 34em (circa 70-75 caratteri). Le tabelle usano tutta la larghezza.
// classe: classe extra per il contenitore.
interface Props {
  classe?: string | undefined;
  /** Accettata per compatibilità, senza effetto: la misura è sempre 34em. */
  larga?: boolean | undefined;
}

const { classe } = Astro.props;
---

<div class:list={['prosa', classe]}>
  <slot />
</div>

<style>
  /* ---------- Base ---------- */
  .prosa {
    font: 400 var(--fs-body) / 1.6 var(--font-testo);
    color: var(--inchiostro);
    margin-block-start: var(--s-5);
    text-align: start;
  }

  .prosa :global(p),
  .prosa :global(ul),
  .prosa :global(ol) {
    max-inline-size: 34em;
  }

  .prosa :global(p) {
    margin: 0;
  }

  /* Paragrafi ed elenchi in morbido: il testo di lettura è secondario rispetto ai titoli. */
  .prosa :global(p),
  .prosa :global(li) {
    color: var(--morbido);
  }

  .prosa :global(p) + :global(p) {
    margin-block-start: 1em;
  }

  /* Il primo elemento non porta margine superiore: lo gestisce il contenitore della pagina. */
  .prosa > :global(:first-child) {
    margin-block-start: 0;
  }

  /* ---------- Titoli ---------- */
  /* Display (Archivo 64% larghezza, 800, maiuscolo) per l'H2; Archivo 600 per l'H3.
     I titoli arrivano dallo slot senza classe, quindi lo stile è qui. */
  .prosa :global(h2) {
    max-inline-size: none;
    margin-block: clamp(48px, 6vw, 96px) var(--s-5);
    font-family: var(--font-display);
    font-stretch: 64%;
    font-weight: 800;
    font-size: var(--fs-h2-xs);
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--inchiostro);
  }

  .prosa :global(h3) {
    margin-block: var(--s-7) var(--s-3);
    font: 600 var(--fs-h3) / 1.15 var(--font-testo);
    letter-spacing: -0.02em;
    color: var(--inchiostro);
  }

  /* ---------- Elenchi ---------- */
  .prosa :global(ul),
  .prosa :global(ol) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prosa :global(ol) {
    counter-reset: voce;
  }

  .prosa :global(li) {
    position: relative;
    padding-block: var(--s-3);
    padding-inline-start: var(--s-5);
  }

  .prosa :global(li) + :global(li) {
    border-block-start: 1px solid var(--linea);
  }

  /* Trattino prima del testo (elenchi puntati): morbido, mai mattone. */
  .prosa :global(ul) > :global(li)::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: calc(var(--s-3) + 0.75em);
    inline-size: 10px;
    block-size: 2px;
    background: var(--morbido);
  }

  /* Numeri (elenchi numerati, sequenza vera): Archivo 600, morbido. */
  .prosa :global(ol) > :global(li) {
    counter-increment: voce;
  }

  .prosa :global(ol) > :global(li)::before {
    content: counter(voce, decimal-leading-zero);
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: var(--s-3);
    font: 600 var(--fs-small) / 1.6 var(--font-ui);
    color: var(--morbido);
    font-variant-numeric: tabular-nums lining-nums;
  }

  /* ---------- Link ---------- */
  .prosa :global(a) {
    color: var(--inchiostro);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  @media (hover: hover) {
    .prosa :global(a:hover) {
      text-decoration-thickness: 2px;
    }
  }

  /* ---------- Enfasi ---------- */
  .prosa :global(strong) {
    font-weight: 600;
    color: var(--inchiostro);
  }

  /* Niente corsivo: l'enfasi con em diventa peso e tono. */
  .prosa :global(em) {
    font-style: normal;
    font-weight: 500;
    color: var(--inchiostro);
  }

  /* ---------- Separatori ---------- */
  .prosa :global(hr) {
    margin-block: var(--s-7);
    border: 0;
    border-block-start: 1px solid var(--linea);
    block-size: 0;
    background: none;
  }

  /* ---------- Tabelle ---------- */
  .prosa :global(table) {
    inline-size: 100%;
    margin-block: var(--s-6);
    border-collapse: collapse;
    /* Sotto 640px la tabella scorre dentro il proprio blocco, non nella pagina. */
    display: block;
    max-inline-size: 100%;
    overflow-x: auto;
  }

  .prosa :global(th),
  .prosa :global(td) {
    padding-block: var(--s-3);
    padding-inline-end: var(--s-4);
    border-block-end: 1px solid var(--linea);
    text-align: start;
    vertical-align: top;
  }

  .prosa :global(th) {
    font: 600 var(--fs-small) / 1.4 var(--font-ui);
    letter-spacing: 0;
    text-transform: none;
    color: var(--morbido);
  }

  .prosa :global(td) {
    font-variant-numeric: tabular-nums lining-nums;
  }

  /* Numeri: classe num su th o td, allineati a destra, cifre tabulari. */
  .prosa :global(.num) {
    text-align: end;
    font-variant-numeric: tabular-nums lining-nums;
  }

  /* Da 640px la tabella torna a layout di tabella normale. */
  @media (min-width: 640px) {
    .prosa :global(table) {
      display: table;
      max-inline-size: none;
      overflow-x: visible;
    }
  }
</style>
