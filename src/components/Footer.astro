---
const adesso = new Date();
const anno = adesso.getFullYear();
const aggiornato = adesso.toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });
---

<footer class="piede">
  <div class="involucro">
    <a class="piede-logo" href="/" aria-label="Trebla: torna alla homepage">
      <img src="/trebla-logo-transparent.png" alt="Trebla" width="1360" height="768" loading="lazy" decoding="async" />
    </a>
    <div class="piede-riga">
      <div class="piede-contatti">
        <h2>Studio</h2>
        <p style="margin:0 0 10px">Studio indipendente ad Asti.<br />Siti web per piccole attività ad Asti.</p>
      </div>
      <div class="piede-contatti">
        <h2>Contatti diretti</h2>
        <p><a data-wa="Ciao Trebla! Vorrei un sito per la mia attività, parliamone." target="_blank" rel="noopener noreferrer" href="#">WhatsApp</a></p>
        <p><a data-tel href="#">Chiamaci</a></p>
        <p><a data-mail data-mostra href="#">email</a></p>
        <p>Asti, su appuntamento.</p>
      </div>
    </div>
    <div class="piede-fondo">
      <span>© {anno} Trebla · Asti · Aggiornato a {aggiornato}</span>
        <nav aria-label="Note legali">
          <a href="/note-legali#privacy">Privacy</a>
          <a href="/note-legali#cookie">Cookie</a>
          <a href="/note-legali#termini">Termini</a>
        </nav>
      <p class="piede-torna"><a class="link-freccia" href="#cima" id="torna-su">Torna su ↑</a></p>
    </div>
  </div>
</footer>

<script>
  // Torna su garantito: l'ancora da sola a volte non basta con overflow-x: clip.
  document.getElementById('torna-su')?.addEventListener('click', (e) => {
    e.preventDefault();
    const ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: ridotto ? 'auto' : 'smooth' });
  });
</script>
