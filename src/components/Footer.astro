---
import { site } from '../data/site';

const year = new Date().getFullYear();
const email = site.email;
const whatsappUrl = `https://wa.me/${site.whatsapp}`;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <a href="/" class="site-footer__brand" aria-label="Trebla Studio — homepage">
        <strong>Trebla Studio</strong>
        <span>Siti web · Asti</span>
      </a>

      <nav class="site-footer__nav" aria-label="Navigazione footer">
        <a href="/servizi">Servizi</a>
        <a href="/prezzi">Prezzi</a>
        <a href="/chi-siamo">Chi siamo</a>
        <a href="/faq">FAQ</a>
        <a href="/contatti">Contatti</a>
      </nav>

      <div class="site-footer__contact">
        <a href={`mailto:${email}`} class="site-footer__mail">{email}</a>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="site-footer__wa">
          WhatsApp
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>© {year} Trebla Studio — Asti, Piemonte</span>
      <nav class="site-footer__legal" aria-label="Note legali">
        <a href="/privacy">Privacy</a>
        <a href="/cookie">Cookie</a>
        <a href="/termini">Termini</a>
      </nav>
      <a href="#main" class="site-footer__top-link">Torna su ↑</a>
    </div>
  </div>
</footer>
