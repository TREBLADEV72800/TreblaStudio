---
// Freccia diagonale ↗ in SVG inline. Colore da currentColor, nascosta agli screen reader.
// Classe base .icona-freccia (componenti.css); `classe` è opzionale.
interface Props {
  classe?: string | undefined;
}

const { classe } = Astro.props;
---

<svg
  class:list={['icona-freccia', classe]}
  width="16"
  height="16"
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
>
  <path d="M4 12 12 4M5.5 4H12v6.5" />
</svg>
