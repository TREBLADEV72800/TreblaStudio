---
// Testata di sezione: solo l'H2 display che si rivela e, se c'è, una nota breve.
// Da 960px la nota sta a destra del titolo. Niente numero, niente etichetta, niente filetto.
// numero ed etichetta sono accettate ma ignorate: le pagine non ancora migrate le passano ancora.
// tenue e il <em> del titolo: il titolo ha un solo tono, quindi non cambiano nulla.
// scuro: versione per fascia scura.
import TitoloRivelato from './ui/TitoloRivelato.astro';

interface Props {
  /** Ignorata: la sezione non ha più numero. */
  numero?: string | undefined;
  /** Ignorata: la sezione non ha più etichetta. */
  etichetta?: string | undefined;
  titolo: string;
  nota?: string | undefined;
  /** Id del titolo: serve a legare la sezione al suo heading (aria-labelledby). */
  id?: string | undefined;
  /** Accettata per compatibilità: il titolo ha un solo tono. */
  tenue?: string | undefined;
  /** Versione per fascia scura. */
  scuro?: boolean | undefined;
}

const { titolo, nota, id, scuro = false } = Astro.props;
const tenue = Astro.props.tenue ?? titolo.match(/<em>(.*?)<\/em>/)?.[1];
const testo = titolo.replace(/<\/?em>/g, '');
---

<div class:list={['testata', scuro && 'testata--scuro']}>
  <TitoloRivelato tag="h2" testo={testo} tenue={tenue} id={id} classe="testata__titolo" />
  {nota && <p class="testata__nota">{nota}</p>}
</div>

<style>
  .testata {
    display: grid;
    gap: var(--s-5) var(--gap);
    margin-block-end: clamp(40px, 5vw, 64px);
  }

  .testata__nota {
    max-inline-size: 48ch;
    margin: 0;
    font: 400 var(--fs-lead) / 1.45 var(--font-testo);
    color: var(--morbido);
  }

  /* Il titolo è TitoloRivelato: la sua radice riceve la classe passata, non l'attributo di questo componente. */
  .testata :global(.testata__titolo) {
    max-inline-size: none;
  }

  /* Su fascia scura: testo carta e secondo tono morbido-scuro. */
  .testata--scuro {
    color: var(--carta);
  }

  .testata--scuro .testata__nota {
    color: var(--morbido-scuro);
  }

  @media (min-width: 960px) {
    .testata {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }

    .testata :global(.testata__titolo) {
      grid-column: 1 / span 8;
    }

    .testata__nota {
      grid-column: 9 / span 4;
      justify-self: start;
    }
  }
</style>
