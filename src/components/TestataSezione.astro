---
// Testata di sezione: riga con filetto (numero e etichetta mono), H2 display che si rivela, nota opzionale.
// Props invariati rispetto alla versione precedente: numero, titolo, nota, id.
// Un <em> nel titolo diventa il secondo tono (tenue), senza corsivo.
import TitoloRivelato from './ui/TitoloRivelato.astro';

interface Props {
  numero: string;
  titolo: string;
  nota?: string | undefined;
  /** Id del titolo: serve a legare la sezione al suo heading (aria-labelledby). */
  id?: string | undefined;
  /** Sottostringa del titolo nel secondo tono. Se manca si usa il <em> del titolo. */
  tenue?: string | undefined;
  /** Versione per fascia scura. */
  scuro?: boolean | undefined;
}

const { numero, titolo, nota, id, scuro = false } = Astro.props;
const tenue = Astro.props.tenue ?? titolo.match(/<em>(.*?)<\/em>/)?.[1];
const testo = titolo.replace(/<\/?em>/g, '');
// "01 · Benefici": il numero prende il colore pieno, l'etichetta resta morbida.
const numeroParti = numero.match(/^(\d+)\s*·\s*(.+)$/);
---

<div class:list={['testata', scuro && 'testata--scuro']}>
  <p class="testata__riga">
    {
      numeroParti ? (
        <>
          <span class="testata__num">{numeroParti[1]}</span> · <span>{numeroParti[2]}</span>
        </>
      ) : (
        numero
      )
    }
  </p>
  <TitoloRivelato tag="h2" testo={testo} tenue={tenue} id={id} classe="testata__titolo" />
  {nota && <p class="testata__nota">{nota}</p>}
</div>
