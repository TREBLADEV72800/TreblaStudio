---
// Testata condivisa: LayoutPagina (pagine normali) e configuratore (a schermo intero).
// Un posto solo per meta, Open Graph, font e JSON-LD: niente copie da tenere allineate.
// `site.name` resta qui per OG/JSON-LD; nel `<title>` basta la stringa 'Trebla'.
import { site, canonicalUrl } from '../data/sito';
import archivoVariabile from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import plex400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import plex500 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  canonical: string;
  noindex?: boolean | undefined;
  preloadLogo?: boolean | undefined;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | undefined;
  ogImage?: string | undefined;
}

const { title, description, canonical, noindex = false, preloadLogo = true, jsonLd, ogImage = '/og-trebla.jpg' } = Astro.props;

const canonicalHref = canonicalUrl(canonical);
// "Trebla · Trebla" non deve esistere: se il titolo già contiene il nome, sta com'è.
const titleFull = title.includes('Trebla') ? title : `${title} · Trebla`;

const baseLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site.url}/#studio`,
    name: 'Trebla',
    url: `${site.url}/`,
    description: 'Studio indipendente ad Asti: siti web, grafiche e social media per piccole attività.',
    logo: {
      '@type': 'ImageObject',
      url: `${site.url}/trebla-logo.webp`,
      width: 1360,
      height: 768,
    },
    image: `${site.url}/og-trebla.jpg`,
    areaServed: { '@type': 'City', name: 'Asti' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${site.url}/#servizio`,
    name: 'Trebla, Studio web ad Asti',
    url: `${site.url}/`,
    image: `${site.url}/og-trebla.jpg`,
    logo: `${site.url}/trebla-logo.webp`,
    priceRange: '€€',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Asti',
      addressCountry: 'IT',
    },
    areaServed: { '@type': 'City', name: 'Asti' },
    currenciesAccepted: 'EUR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}/#sito`,
    name: 'Trebla',
    url: `${site.url}/`,
    description: site.description,
    inLanguage: 'it',
    publisher: { '@id': `${site.url}/#studio` },
  },
];

// Una WebPage per ogni pagina indicizzabile, generata dagli stessi
// title/description/canonical della testata: mai copie da tenere allineate.
const paginaLd = noindex
  ? []
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        '@id': `${canonicalHref}#pagina`,
        url: canonicalHref,
        name: titleFull,
        description,
        inLanguage: 'it',
        isPartOf: { '@id': `${site.url}/#sito` },
        about: { '@id': `${site.url}/#studio` },
        publisher: { '@id': `${site.url}/#studio` },
      },
    ];

const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// @font-face solo woff2: gli import CSS di fontsource trascinavano anche i .woff nel build.
const FONT_RANGE =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
// Archivo variabile: un solo file con gli assi wght (100-900) e wdth (62-125), così font-stretch funziona.
const fontCss = [
  `@font-face{font-family:'Archivo';font-style:normal;font-weight:100 900;font-stretch:62% 125%;font-display:swap;src:url('${archivoVariabile}') format('woff2');unicode-range:${FONT_RANGE}}`,
  `@font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:400;font-display:swap;src:url('${plex400}') format('woff2');unicode-range:${FONT_RANGE}}`,
  `@font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:500;font-display:swap;src:url('${plex500}') format('woff2');unicode-range:${FONT_RANGE}}`,
].join('');
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Metodo senza JS: lo stato nascosto dei reveal vale solo con la classe "js" su <html> (vedi movimento.css). -->
<script is:inline>document.documentElement.classList.add('js');</script>
<title>{titleFull}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalHref} />
{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow" />}
<meta property="og:type" content="website" />
<meta property="og:locale" content={site.locale} />
<meta property="og:site_name" content="Trebla" />
<meta property="og:title" content={titleFull} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalHref} />
<meta property="og:image" content={`${site.url}${ogImage}`} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Trebla, studio web ad Asti" />
<meta name="twitter:card" content={site.twitterCard} />
<meta name="twitter:image" content={`${site.url}${ogImage}`} />
<meta name="twitter:title" content={titleFull} />
<meta name="twitter:description" content={description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="preload" href={archivoVariabile} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={plex500} as="font" type="font/woff2" crossorigin />
{preloadLogo && <link rel="preload" as="image" href="/trebla-logo.webp" fetchpriority="high" />}
<style set:html={fontCss}></style>
<meta name="theme-color" content="#141210" />
<script type="application/ld+json" set:html={JSON.stringify([...baseLd, ...paginaLd, ...extraLd])} />
<slot name="head" />
