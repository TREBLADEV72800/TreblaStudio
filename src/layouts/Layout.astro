---
import '../styles.css';
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/fraunces/latin-600-italic.css';
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-500.css';
import '@fontsource/archivo/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-700.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, canonicalUrl } from '../data/site';
import archivo400 from '@fontsource/archivo/files/archivo-latin-400-normal.woff2?url';
import fraunces600 from '@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url';
import fraunces600Italic from '@fontsource/fraunces/files/fraunces-latin-600-italic.woff2?url';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Trebla: Siti web chiari per piccole attività | Asti',
  description = site.description,
  canonical = '/',
  noindex = false,
  jsonLd,
} = Astro.props;

const canonicalHref = canonicalUrl(canonical);
const titleFull = title === site.name ? title : title.includes('Trebla') ? title : `${title} · Trebla`;
const baseLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site.url}/#studio`,
    name: 'Trebla',
    url: `${site.url}/`,
    description: 'Studio indipendente ad Asti: siti web, grafiche e social media per piccole attività.',
    areaServed: { '@type': 'City', name: 'Asti' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${site.url}/#servizio`,
    name: 'Trebla, Studio web ad Asti',
    url: `${site.url}/`,
    priceRange: '€€',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Asti',
      addressCountry: 'IT',
    },
    areaServed: { '@type': 'City', name: 'Asti' },
    currenciesAccepted: 'EUR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Trebla',
    url: `${site.url}/`,
    inLanguage: 'it',
  },
];
const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleFull}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content="Trebla" />
    <meta property="og:title" content={titleFull} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={`${site.url}/og-trebla.jpg`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Trebla, studio web ad Asti" />
    <meta name="twitter:card" content={site.twitterCard} />
    <meta name="twitter:image" content={`${site.url}/og-trebla.jpg`} />
    <meta name="twitter:title" content={titleFull} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={archivo400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fraunces600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fraunces600Italic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" as="image" href="/trebla-logo.webp" fetchpriority="high" />
    <meta name="theme-color" content="#1d1712" />
    <script type="application/ld+json" set:html={JSON.stringify([...baseLd, ...extraLd])} />
    <noscript><style>[data-reveal]{opacity:1 !important;transform:none !important}</style></noscript>
    <slot name="head" />
  </head>
  <body>
    <a class="salto" href="#contenuto">Salta al contenuto</a>
    <Header />
    <main id="contenuto"><slot /></main>
    <Footer />
    <script>
      // Reveal sobrio: una sola IntersectionObserver per tutto il sito.
      const ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!ridotto && 'IntersectionObserver' in window) {
        const els = document.querySelectorAll('[data-reveal]');
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('visibile');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('visibile'));
      }
    </script>
<script>
      // Anti-scraping: numero ed email mai in chiaro nell'HTML, assemblati qui all'apertura.
      const WA_P = ['39', '351', '892', '4471'].join('');
      const MAIL_P = ['trebla', '.dev', '.simoni'].join('') + '@' + ['gmail', '.com'].join('');
      document.querySelectorAll('a[data-wa]').forEach((a) => {
        a.href = 'https://wa.me/' + WA_P + '?text=' + encodeURIComponent(a.getAttribute('data-wa') || 'Ciao Trebla!');
      });
      document.querySelectorAll('a[data-mail]').forEach((a) => {
        const s = a.getAttribute('data-soggetto');
        a.href = 'mailto:' + MAIL_P + (s ? '?subject=' + encodeURIComponent(s) : '');
        if (a.hasAttribute('data-mostra')) a.textContent = MAIL_P;
      });
      const track = (n) => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'trebla_' + n });
        window.dispatchEvent(new CustomEvent('trebla:track', { detail: n }));
      };
      document.addEventListener('click', (e) => {
        const t = e.target && e.target.closest ? e.target.closest('a[data-wa], a[data-mail]') : null;
        if (!t) return;
        track(t.hasAttribute('data-wa') ? 'whatsapp' : 'email');
      });
    </script>
  </body>
</html>
