---
import '../styles.css';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contatti from '../components/Contatti.astro';
import { site } from '../data/site';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  canonical?: string | undefined;
  noindex?: boolean | undefined;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | undefined;
}

const {
  title = 'Trebla: Siti web chiari per piccole attività | Asti',
  description = site.description,
  canonical = '/',
  noindex = false,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <Head title={title} description={description} canonical={canonical} noindex={noindex} jsonLd={jsonLd} />
  </head>
  <body>
    <a class="salto" href="#contenuto">Salta al contenuto</a>
    <Header />
    <main id="contenuto"><slot /></main>
    <Footer />
    <Contatti />
    <script is:inline>
      // Reveal sobrio: una sola IntersectionObserver per tutto il sito.
      // is:inline: JS puro, niente chunk nel grafo di caricamento.
      (function () {
        const mostraTutto = () =>
          document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('visibile'));
        try {
          const ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!ridotto && 'IntersectionObserver' in window) {
            const els = document.querySelectorAll('[data-reveal]');
            const io = new IntersectionObserver(
              (entries) => {
                for (const e of entries) {
                  if (e.isIntersecting) {
                    e.target.classList.add('visibile');
                    io.unobserve(e.target);
                  }
                }
              },
              { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
            );
            els.forEach((el) => io.observe(el));
          } else {
            mostraTutto();
          }
        } catch (e) {
          // Se qualcosa va storto, meglio tutto visibile che una pagina vuota.
          mostraTutto();
        }
      })();
    </script>
  </body>
</html>
