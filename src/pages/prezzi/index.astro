---
import LayoutPagina from '../../layouts/LayoutPagina.astro';
import TestataPagina from '../../components/TestataPagina.astro';
import TestataSezione from '../../components/TestataSezione.astro';
import Prosa from '../../components/Prosa.astro';
import Bottone from '../../components/ui/Bottone.astro';
import { ANTICIPO, BASE_PRICES, SOCIAL_OPTIONS, DESIGN_OPTIONS, OFFERTA_SITO, RATE_SALDO } from '../../data/prezzi';
import { photoPrices } from '../../data/configuratore';
import { site } from '../../data/sito';

const titolo = `Prezzi: siti web da ${BASE_PRICES.singola}€, senza canone | Trebla`;
const descrizione = `Pagina singola ${BASE_PRICES.singola}€, sito a più pagine ${BASE_PRICES.multi}€, offerta Tutto incluso ${OFFERTA_SITO.prezzo}€. Due revisioni incluse, nessun canone, il sito è tuo.`;
const urlOfferta = 'https://treblastudio.pages.dev/prezzi/#offerta';
const condivisioneOfferta = `https://wa.me/?text=${encodeURIComponent(
  `Trebla: sito completo a ${OFFERTA_SITO.prezzo}€, con foto, logo e ${OFFERTA_SITO.revisioni} modifiche gratuite ${urlOfferta}`,
)}`;

// Le tre colonne della matrice. L'ultima è quella che include tutto: è l'unica evidenziata.
const pacchetti = [
  { nome: 'Pagina singola', prezzo: BASE_PRICES.singola, href: '/preventivo/?struttura=singola', forte: false },
  { nome: 'Più pagine', prezzo: BASE_PRICES.multi, href: '/preventivo/?struttura=multi', forte: false },
  { nome: 'Tutto incluso', prezzo: OFFERTA_SITO.prezzo, href: '/preventivo/?offerta=1', forte: true },
] as const;

// Le voci in riga. true = incluso, false = non incluso, stringa = valore.
// Cosa comprende, una lista per colonna (testi del proprietario). Il "Tutto incluso" non ha una lista propria.
const comprende: string[][] = [
  [
    'Tutto l’essenziale in una pagina che scorre',
    'Chi sei, cosa fai, dove sei, come contattarti',
    'Telefono, WhatsApp e mappa in vista',
  ],
  [
    'Storia, servizi, galleria, contatti: ognuno al suo posto',
    'Menu, prenotazioni, eventi se ti servono',
    'Telefono, WhatsApp e mappa in vista',
  ],
  [],
];

const confronto: { voce: string; valori: [boolean | string, boolean | string, boolean | string] }[] = [
  { voce: 'Privacy, cookie e contatti ben visibili', valori: [true, true, true] },
  { voce: 'Sito a più pagine', valori: [false, true, true] },
  { voce: 'Revisioni incluse', valori: ['2', '2', '3'] },
  { voce: 'Foto scattate da noi ad Asti', valori: [false, false, true] },
  { voce: 'Logo nuovo o rinnovato', valori: [false, false, true] },
];
---

<LayoutPagina
  title={titolo}
  description={descrizione}
  canonical="/prezzi"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Realizzazione siti web per piccole attività, Trebla',
    url: `${site.url}/prezzi`,
    provider: { '@id': `${site.url}/#studio` },
    areaServed: { '@type': 'City', name: 'Asti' },
    offers: [
      { '@type': 'Offer', name: 'Pagina singola', price: String(BASE_PRICES.singola), priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Sito a più pagine', price: String(BASE_PRICES.multi), priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Offerta Tutto incluso', price: String(OFFERTA_SITO.prezzo), priceCurrency: 'EUR' },
    ],
  }}
>
  <TestataPagina
    titolo="Due prezzi di partenza | Niente sorprese"
    percorso={[{ testo: 'Home', href: '/' }, { testo: 'Prezzi' }]}
  >
    <p slot="lead">Tutto per andare online. Gli extra li vedi prima nel preventivo.</p>
  </TestataPagina>

  <section class="sezione" aria-labelledby="p-confronto">
    <div class="contenitore">
      <TestataSezione
        id="p-confronto"
        titolo="Cosa ricevi in ogni pacchetto"
        nota="Il contenuto cambia con il numero di pagine e gli extra scelti."
      />

      <table class="pm">
        <caption class="sr-solo">Confronto dei tre pacchetti: prezzo, anticipo e cosa include ciascuno</caption>
        <thead>
          <tr>
            <th scope="col" class="pm__voce"><span class="sr-solo">Cosa include</span></th>
            {
              pacchetti.map((p) => (
                <th scope="col" class:list={['pm__col', p.forte && 'pm--forte']}>
                  <span class="pm__nome">{p.nome}</span>
                  <span class="display display--h2-s pm__prezzo">{p.prezzo}<span class="pm__euro">€</span></span>
                  <span class="pm__anticipo">Anticipo di {ANTICIPO}€</span>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          <tr class="pm__comprende">
            <th scope="row" class="pm__voce">Cosa comprende</th>
            {
              comprende.map((voci, i) => (
                <td class:list={['pm__cella', i === 2 && 'pm--forte']}>
                  {voci.length > 0 && (
                    <ul class="pm__elenco">
                      {voci.map((voce) => <li>{voce}</li>)}
                    </ul>
                  )}
                </td>
              ))
            }
          </tr>
          {
            confronto.map((riga) => (
              <tr>
                <th scope="row" class="pm__voce">{riga.voce}</th>
                {riga.valori.map((v, i) => (
                  <td class:list={['pm__cella', i === 2 && 'pm--forte']}>
                    {v === true && (
                      <span class="pm__segno" role="img" aria-label="Incluso">
                        <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true" focusable="false">
                          <path d="M3.5 9.5 7 13 14.5 5" />
                        </svg>
                      </span>
                    )}
                    {v === false && (
                      <span class="pm__segno pm__segno--no" role="img" aria-label="Non incluso">–</span>
                    )}
                    {typeof v === 'string' && <span class="pm__valore">{v}</span>}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr>
            <td class="pm__voce"></td>
            {
              pacchetti.map((p) => (
                <td class:list={['pm__cella', p.forte && 'pm--forte']}>
                  <a
                    class="link-sottolineato pm__azione"
                    href={p.href}
                    data-cursore="Preventivo"
                    aria-label={`Fai il preventivo per ${p.nome.toLowerCase()}`}
                  >
                    Fai il preventivo
                  </a>
                </td>
              ))
            }
          </tr>
        </tfoot>
      </table>

      <div class="pm__note">
        <p>Entrambi includono testi essenziali preparati insieme a te, privacy e cookie a norma, configurazione dominio gratis, hosting gratuito, galleria fotografica e due revisioni. Le sezioni e il numero di pagine si definiscono nella proposta. Per le foto puoi usare le tue, farle scattare a noi ad Asti (+{photoPrices['Servono le foto (le scattate voi)']}€) o scegliere l’opzione “Parto da zero” (+{photoPrices['Parto da zero']}€), da precisare insieme prima dell’avvio.</p>
        <p>Perfetta per: artigiani, professionisti, piccole botteghe che devono farsi trovare e contattare. Se ti servono sezioni separate, serve il multipagina.</p>
        <p>Perfetto per: ristoranti, B&amp;B, saloni, negozi con tanto da mostrare.</p>
        <p>Anticipo di {ANTICIPO}€ compreso nella stima, come sempre. La scegli nel preventivo alla voce struttura del sito.</p>
        <p>
          <a class="link-sottolineato" href={condivisioneOfferta} target="_blank" rel="noopener noreferrer">Condividi su WhatsApp</a>
        </p>
      </div>
    </div>
  </section>

  <section class="sezione" aria-labelledby="p-condizioni">
    <div class="contenitore">
      <TestataSezione id="p-condizioni" titolo="Le regole, in chiaro" />
      <ul class="pr-righe">
        <li>
          <h3>Il sito è tuo</h3>
          <p>Nessun canone obbligatorio verso di noi. Hosting completamente gratuito, configurazione del dominio gratis.</p>
        </li>
        <li>
          <h3>Due revisioni incluse</h3>
          <p>Guardi, correggi, riguardate: due giri completi prima della pubblicazione.</p>
        </li>
        <li>
          <h3>Tempi concordati</h3>
          <p>Dopo aver visto i materiali ti diciamo una data. In genere una decina di giorni.</p>
        </li>
        <li>
          <h3>Modifiche dopo</h3>
          <p>Le piccole correzioni te le facciamo noi su richiesta. Prima ti diciamo se e quanto costano.</p>
        </li>
      </ul>
      <div class="pr-azioni">
        <Bottone href="/preventivo/" testo="Fai il preventivo" />
        <Bottone href="/faq/" variante="secondario" testo="Leggi le domande frequenti" />
      </div>
      <p class="pr-nota-stima">Nessun pagamento e nessun obbligo per chiedere la stima. Il prezzo multipagina copre le pagine e le sezioni concordate nella proposta.</p>
    </div>
  </section>

  <section class="sezione" aria-label="Esclusioni e pagamento">
    <div class="contenitore">
      <Prosa>
        <h2>Cosa non è incluso</h2>
        <p>La stampa e la produzione fisica dei materiali grafici, domini o servizi esterni a pagamento, campagne pubblicitarie, accessi utente, pagamenti online, manutenzione continuativa e modifiche non comprese. Grafiche e contenuti social si pagano per voce selezionata, non sono inclusi nell’Offerta Tutto incluso né sono un canone mensile. Le voci aggiuntive sono elencate nel preventivo prima dell’avvio.</p>
        <h2>Pagamento e fatturazione</h2>
        <p>Per iniziare è previsto un anticipo di {ANTICIPO}€, compreso nel totale. Il saldo si paga alla consegna o in {RATE_SALDO} rate concordate. Modalità e dati di fatturazione vengono indicati nella proposta prima della conferma.</p>
      </Prosa>
    </div>
  </section>

  <section class="sezione" aria-labelledby="p-extra">
    <div class="contenitore">
      <TestataSezione
        id="p-extra"
        titolo="Solo quello che ti serve"
        nota="Grafiche, social e foto hanno un prezzo a parte. Le funzioni del sito sono incluse."
      />
      <h3 class="pr-sotto">Per le grafiche</h3>
      <p class="pr-extra__nota">I prezzi sono per singola voce. Prepariamo il progetto grafico e i file, non stampiamo né produciamo gli oggetti.</p>
      <ul class="pr-elenco">
        {DESIGN_OPTIONS.map((e) => (
          <li><span>{e.name}</span><span class="pr-prezzo">+{e.price}€</span></li>
        ))}
      </ul>
      <h3 class="pr-sotto">Per i social media</h3>
      <p class="pr-extra__nota">Prezzi per singola voce selezionata, non per un piano mensile. Quantità, materiali e calendario sono definiti nella proposta.</p>
      <ul class="pr-elenco">
        {SOCIAL_OPTIONS.map((e) => (
          <li><span>{e.name}</span><span class="pr-prezzo">+{e.price}€</span></li>
        ))}
      </ul>
    </div>
  </section>
</LayoutPagina>

<style>
  /* ---------- Matrice di confronto: tre pacchetti in colonna, voci in riga.
     Su 390px le colonne sono strette ma la tabella sta nel contenitore, senza scroll. ---------- */
  .pm {
    inline-size: 100%;
    margin: 0;
    border-collapse: collapse;
    table-layout: fixed;
    color: var(--inchiostro);
    font: 400 var(--fs-body) / 1.45 var(--font-testo);
  }

  .pm th,
  .pm td {
    padding: var(--s-4) var(--s-2);
    border-block-end: 1px solid var(--linea);
    text-align: start;
    vertical-align: middle;
  }

  .pm thead th {
    padding-block: var(--s-5) var(--s-4);
    vertical-align: bottom;
    font-weight: 400;
  }

  .pm tfoot td {
    padding-block: var(--s-4) var(--s-2);
    border-block-end: 0;
  }

  .pm__voce {
    inline-size: 26%;
    font: 600 var(--fs-ui) / 1.3 var(--font-ui);
    letter-spacing: 0;
    color: var(--inchiostro);
  }

  .pm__col {
    inline-size: 24.666%;
  }

  .pm__nome {
    display: block;
    font: 600 var(--fs-ui) / 1.25 var(--font-ui);
    letter-spacing: 0;
    color: inherit;
  }

  .pm__prezzo {
    display: block;
    margin-block-start: var(--s-3);
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
    color: inherit;
  }

  .pm__euro {
    margin-inline-start: 0.04em;
    font-size: 0.5em;
    line-height: 1;
    vertical-align: top;
  }

  .pm__anticipo {
    display: block;
    margin-block-start: var(--s-2);
    font: 400 var(--fs-small) / 1.4 var(--font-testo);
    color: var(--morbido);
  }

  /* L'unico segnale della tabella: la colonna che include tutto, su fondo inchiostro. */
  .pm--forte {
    background: var(--inchiostro);
    color: var(--carta);
    --morbido: var(--morbido-scuro);
    --linea: var(--linea-scura);
  }

  .pm__segno {
    display: inline-flex;
    align-items: center;
    min-block-size: 24px;
    color: inherit;
  }

  .pm__segno svg {
    display: block;
    inline-size: 18px;
    block-size: 18px;
  }

  .pm__segno--no {
    font: 400 var(--fs-h3) / 1 var(--font-testo);
    color: var(--morbido);
  }

  /* Cosa comprende: elenco breve sotto l'intestazione di colonna, testo piccolo. */
  .pm__elenco {
    margin: 0;
    padding: 0;
    list-style: none;
    font: 400 var(--fs-small) / 1.4 var(--font-testo);
    text-align: left;
  }

  .pm__elenco li + li {
    margin-block-start: var(--s-2);
  }

  .pm__valore {
    font: 600 var(--fs-h3) / 1 var(--font-testo);
    font-variant-numeric: tabular-nums lining-nums;
    color: inherit;
  }

  .pm__azione {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    font: 600 var(--fs-small) / 1.2 var(--font-ui);
    color: inherit;
  }

  .pm__note {
    display: grid;
    gap: var(--s-3);
    margin-block-start: var(--s-6);
  }

  .pm__note p {
    font: 400 var(--fs-small) / 1.5 var(--font-testo);
    color: var(--morbido);
  }

  @media (min-width: 640px) {
    .pm th,
    .pm td {
      padding: var(--s-5) var(--s-4);
    }
  }

  @media (min-width: 960px) {
    .pm__voce {
      inline-size: 40%;
      font-size: var(--fs-ui);
    }

    .pm__col {
      inline-size: 20%;
    }
  }

  /* ---------- Condizioni: quattro voci parallele, senza numeri. ---------- */
  .pr-righe {
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .pr-righe li {
    display: grid;
    gap: var(--s-3);
    padding-block: var(--s-5);
  }

  .pr-righe li + li {
    border-block-start: 1px solid var(--linea);
  }

  .pr-righe h3 {
    font: 600 var(--fs-h3) / 1.15 var(--font-testo);
    letter-spacing: -0.02em;
    color: var(--inchiostro);
  }

  .pr-righe p {
    margin: 0;
    color: var(--morbido);
  }

  @media (min-width: 960px) {
    .pr-righe li {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: baseline;
    }

    .pr-righe h3 {
      grid-column: 1 / span 5;
    }

    .pr-righe p {
      grid-column: 7 / span 6;
    }
  }

  .pr-azioni {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-block-start: var(--s-7);
  }

  .pr-nota-stima {
    margin: var(--s-5) 0 0;
    font: 400 var(--fs-small) / 1.5 var(--font-testo);
    color: var(--morbido);
  }

  /* ---------- Extra: nome a sinistra, prezzo a destra in cifre tabulari. ---------- */
  .pr-sotto {
    margin: var(--s-7) 0 var(--s-2);
    font: 600 var(--fs-h3) / 1.15 var(--font-testo);
    letter-spacing: -0.02em;
    color: var(--inchiostro);
  }

  .pr-extra__nota {
    margin: 0;
    font: 400 var(--fs-small) / 1.5 var(--font-testo);
    color: var(--morbido);
  }

  .pr-elenco {
    margin: var(--s-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .pr-elenco li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--gap);
    padding-block: var(--s-4);
    font: 400 var(--fs-body) / 1.45 var(--font-testo);
    color: var(--inchiostro);
  }

  .pr-elenco li + li {
    border-block-start: 1px solid var(--linea);
  }

  .pr-prezzo {
    flex: none;
    font: 600 var(--fs-body) / 1.45 var(--font-testo);
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
  }
</style>
