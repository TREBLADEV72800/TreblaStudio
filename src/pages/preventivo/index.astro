---
import '../../styles/tokens.css';
import '../../styles/base.css';
import '../../styles/layout.css';
import '../../styles/componenti.css';
import '../../styles/movimento.css';
import '../../styles/configuratore.css';
import MetaDocumento from '../../components/MetaDocumento.astro';

const title = 'Preventivo sito web in 2 minuti | Trebla';
const description =
  'Configura il sito della tua attività e vedi subito la stima: tipo di attività, funzioni, pagine, foto e social. Senza impegno.';
---

<!doctype html>
<html lang="it" class="cfg-lock">
  <head>
    <MetaDocumento title={title} description={description} canonical="/preventivo" preloadLogo={false} />
  </head>
  <body>
    <a class="salto" href="#contenuto">Salta al contenuto</a>
    <!-- main è il contenitore flex dello schermo (.cfg-schermo): al posto di div.involucro, non dentro, così il layout non cambia. -->
    <main id="contenuto" class="involucro wizard cfg-schermo" aria-labelledby="w-domanda">
      <div class="wizard-testa">
        <a class="wizard-casa link-sottolineato" href="/" aria-label="Torna al sito">Torna al sito</a>
      </div>

      <div class="wizard-barra" id="w-barra" role="progressbar" aria-label="Avanzamento preventivo" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="wizard-riempimento" id="w-riempimento"></div></div>

      <h1 class="wizard-domanda" id="w-domanda" tabindex="-1">Come si chiama la tua attività?</h1>
      <p class="wizard-sotto" id="w-sotto"></p>
      <p class="wizard-errore" id="w-errore" role="alert" hidden></p>

      <noscript>
        <p class="wizard-noscript">Il configuratore funziona con JavaScript attivo. Intanto puoi vedere i <a href="/prezzi/">prezzi</a> o scriverci dalla pagina <a href="/contatti/">Contatti</a>.</p>
      </noscript>

      <div class="wizard-corpo" id="w-corpo"></div>
    </main>

    <div class="wizard-barra-fissa">
      <div class="wizard-barra-interna">
        <button type="button" class="wizard-indietro" id="w-indietro" hidden>Indietro</button>
        <button type="button" class="wizard-avanti" id="w-avanti">Avanti</button>
      </div>
    </div>
    <script>
      import '../../scripts/configuratore-preventivo';
    </script>
  </body>
</html>
