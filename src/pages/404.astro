---
import LayoutPagina from '../layouts/LayoutPagina.astro';
import TestataPagina from '../components/TestataPagina.astro';
import Bottone from '../components/ui/Bottone.astro';
---

<LayoutPagina
  title="Pagina non trovata | Trebla"
  description="Questa pagina non esiste. Torna alla homepage o fai il preventivo in 2 minuti."
  canonical={null}
  noindex={true}
>
  <TestataPagina titolo="Qui non c’è niente" tenue="niente" etichetta="Errore 404" taglia="hero">
    <p slot="lead">La pagina che cercavi non esiste o è stata spostata. Succede. Torniamo dove serve.</p>
    <Bottone href="/" variante="primario" testo="Torna alla homepage" />
    <Bottone href="/preventivo/" variante="secondario" testo="Fai il preventivo" />
    <Bottone href="/prezzi/" variante="secondario" testo="Prezzi" />
    <Bottone href="/faq/" variante="secondario" testo="FAQ" />
    <Bottone
      href="#"
      variante="wa"
      testo="WhatsApp"
      data-wa="Ciao Trebla, cercavo una pagina del sito."
      target="_blank"
      rel="noopener noreferrer"
      data-cursore="Scrivi"
    />
  </TestataPagina>
</LayoutPagina>
