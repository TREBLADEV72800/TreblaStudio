---
import DemoLayout from '../../../layouts/DemoLayout.astro';

const lavori = [
  { tag: 'Bagno', titolo: 'Rifacimento completo 8 mq', testo: 'Demolizione, rifacimento impianti, piastrelle grandi formati e sanitari sospesi. Consegna in 18 giorni lavorativi, bagno di cortesia con box doccia da cantiere per non restare mai senza.' },
  { tag: 'Esterni', titolo: 'Facciata e tetto villetta', testo: 'Cappotto termico, rifacimento gronde e lattoneria, ponteggio e pratiche comunali incluse nel prezzo concordato.' },
  { tag: 'Cucina', titolo: 'Cucina abitabile open space', testo: 'Abbattimento tramezzo con porta a scomparsa, predisposizioni nuove, parquet e tinteggiatura finale.' },
  { tag: 'Interni', titolo: 'Pareti e controsoffitti ufficio', testo: 'Cartongesso fonoassorbente, nuove linee elettriche e tinteggiatura in due weekend, senza fermare il lavoro.' },
  { tag: 'Esterni', titolo: 'Vialetto e recinzione', testo: 'Massetto, autobloccanti drenanti e recinzione in ferro su misura, con cancello carrabile predisposto.' },
  { tag: 'Manutenzione', titolo: 'Riparazioni condominiali', testo: 'Piccoli interventi programmati: guaine, pluviali, ripristini intonaco e imbiancature vani scala.' },
];
---

<DemoLayout
  title="Lavori · Officina Nord (demo)"
  description="Demo concept: portfolio lavori di impresa edile. Interventi dimostrativi, attività fittizia."
>
  <style>
    .im { background: #eceff1; color: #1c2126; font-family: Archivo, system-ui, sans-serif; padding-block-end: 56px; }
    .im-involucro { inline-size: min(1080px, 100% - 40px); margin-inline: auto; }
    .im-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 0; border-block-end: 2px solid #1c2126; }
    .im-marchio { font-weight: 800; text-decoration: none; color: inherit; font-size: 1.15rem; }
    .im-torna { color: #c8641a; font-weight: 700; font-size: 0.92rem; }
    .im-titolo { padding: clamp(32px, 5vw, 56px) 0 8px; }
    .im-kicker { font: 500 0.75rem/1.5 ui-monospace, Menlo, monospace; letter-spacing: 0.2em; text-transform: uppercase; color: #c8641a; margin: 0 0 12px; }
    .im-titolo h1 { font-size: clamp(2.2rem, 6vw, 4rem); letter-spacing: -0.02em; margin: 0; font-weight: 800; }
    .im-titolo p { color: #5a646c; max-inline-size: 56ch; }
    .im-portfolio { display: grid; gap: 12px; grid-template-columns: 1fr; margin-block-start: 28px; }
    @media (min-width: 760px) { .im-portfolio { grid-template-columns: 1fr 1fr; } }
    .im-lavoro { background: #fff; border: 1px solid #cfd6db; border-radius: 4px; padding: 22px; }
    .im-lavoro .tag { font: 500 0.7rem ui-monospace, Menlo, monospace; letter-spacing: 0.14em; text-transform: uppercase; color: #c8641a; margin: 0 0 8px; }
    .im-lavoro h2 { margin: 0 0 8px; font-size: 1.25rem; }
    .im-lavoro p { margin: 0; color: #5a646c; font-size: 0.95rem; line-height: 1.6; }
    .im-portfolio { counter-reset: scheda; }
    .im-lavoro { counter-increment: scheda; position: relative; }
    .im-lavoro::before { content: "SCHEDA 0" counter(scheda); display: block; font: 500 0.7rem ui-monospace, Menlo, monospace; letter-spacing: 0.14em; color: #c8641a; margin-block-end: 8px; }
    .im-lavoro::after { content: ""; display: block; block-size: 3px; background: #1c2126; margin-block-start: 16px; }
    @media (min-width: 760px) {
      .im-lavoro:first-child { grid-column: 1 / -1; }
      .im-lavoro:first-child p { max-inline-size: 62ch; }
    }
    .os-nota { margin-block-start: 32px; color: #5a646c; font-size: 0.92rem; }
    .im-piede { margin-block-start: 40px; border-block-start: 2px solid #1c2126; padding-block-start: 20px; font-size: 0.85rem; color: #5a646c; display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; }
    .im-piede a { color: inherit; }
  </style>

  <div class="im">
    <div class="im-involucro">
      <header class="im-top">
        <a class="im-marchio" href="/demo/impresa">OFFICINA NORD</a>
        <a class="im-torna" href="/demo/impresa">← Torna al sito</a>
      </header>

      <section class="im-titolo" aria-labelledby="lavori-titolo">
        <p class="im-kicker">Officina Nord · Lavori</p>
        <h1 id="lavori-titolo">Interventi tipo</h1>
        <p>Esempi dimostrativi del nostro modo di lavorare: tempi scritti, voci chiare, cantiere pulito.</p>
      </section>

      <div class="im-portfolio">
        {lavori.map((l) => (
          <div class="im-lavoro">
            <p class="tag">{l.tag}</p>
            <h2>{l.titolo}</h2>
            <p>{l.testo}</p>
          </div>
        ))}
      </div>

      <p class="os-nota">Interventi dimostrativi a scopo illustrativo. Per un preventivo vero: <a href="tel:+390141222222" style="color:#c8641a;font-weight:700">+39 0141 222 222</a>.</p>

      <footer class="im-piede">
        <span>Officina Nord · attività fittizia a scopo dimostrativo</span>
        <span>Demo concept by Trebla Studio · <a href="/demo">Tutte le demo</a></span>
      </footer>
    </div>
  </div>
</DemoLayout>
