---
import DemoLayout from '../../layouts/DemoLayout.astro';

const tel = '+39 0141 555 555';
const telHref = 'tel:+390141555555';
const email = 'casa-verde@example.com';

const camere = [
  { nome: 'Doppia Gelsomino', prezzo: '€ 90', testo: 'Letto matrimoniale, bagno privato, affaccio sul cortile interno.' },
  { nome: 'Superior Lavanda', prezzo: '€ 120', testo: 'Vasca freestanding, macchina espresso, terrazza privata al tramonto.' },
  { nome: 'Familiare Salvia', prezzo: '€ 140', testo: 'Due ambienti comunicanti, fino a 4 ospiti, angolo giochi per bimbi.' },
];
---

<DemoLayout
  title="B&B Casa Verde · Bed and Breakfast (demo)"
  description="Demo concept di sito per bed and breakfast: camere, prezzi, territorio. Attività fittizia."
>
  <style>
    .bb { background: #f4f1e6; color: #2a2b24; font-family: Archivo, system-ui, sans-serif; }
    .bb-involucro { inline-size: min(1080px, 100% - 40px); margin-inline: auto; }
    .bb-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 0; border-block-end: 1px solid #2a2b24; }
    .bb-marchio { font: 600 1.3rem/1 Fraunces, Georgia, serif; text-decoration: none; color: inherit; }
    .bb-marchio small { display: block; font: 500 0.65rem/1.4 ui-monospace, Menlo, monospace; letter-spacing: 0.2em; text-transform: uppercase; color: #5d7351; }
    .bb-nav { display: none; gap: 20px; }
    @media (min-width: 860px) { .bb-nav { display: flex; } }
    .bb-nav a { color: inherit; text-decoration: none; font-size: 0.92rem; font-weight: 500; }
    .bb-subnav { display: flex; gap: 18px; padding: 12px 0 14px; border-block-end: 1px solid #2a2b24; font-size: 0.88rem; }
    .bb-subnav a { color: inherit; font-weight: 600; padding: 10px 0; display: inline-block; }
    @media (min-width: 860px) { .bb-subnav { display: none; } }
    .bb-cta { display: inline-block; background: #5d7351; color: #fff; font-weight: 700; text-decoration: none; padding: 13px 24px; border-radius: 8px; }
    .bb-hero { display: grid; gap: 32px; grid-template-columns: 1fr; align-items: center; padding: clamp(40px, 7vw, 88px) 0 clamp(32px, 5vw, 56px); }
    @media (min-width: 900px) { .bb-hero { grid-template-columns: 1.15fr 0.85fr; gap: 48px; } }
    .bb-kicker { font: 500 0.75rem/1.5 ui-monospace, Menlo, monospace; letter-spacing: 0.18em; text-transform: uppercase; color: #5d7351; margin: 0 0 14px; }
    .bb-hero h1 { font: 600 clamp(2.6rem, 7vw, 4.8rem)/0.98 Fraunces, Georgia, serif; letter-spacing: -0.02em; margin: 0; }
    .bb-hero h1 em { font-style: italic; font-weight: 500; color: #5d7351; }
    .bb-hero p { font-size: 1.1rem; line-height: 1.65; color: #5c5d52; max-inline-size: 46ch; }
    .bb-hero-riga { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-block-start: 24px; }
    .bb-tel { font-weight: 700; color: #2a2b24; }
    .bb-meta { margin: 18px 0 0; font: 500 0.78rem/1.6 ui-monospace, Menlo, monospace; color: #8a8b7e; }
    .bb-arco { border-radius: 999px 999px 14px 14px; background: #5d7351; color: #f4f1e6; padding: 30px 26px 26px; display: grid; gap: 10px; align-content: end; min-block-size: 380px; }
    .bb-arco .a-titolo { display: block; block-size: 20px; inline-size: 58%; border-radius: 4px; background: #e8e4d2; }
    .bb-arco .a-riga { display: block; block-size: 10px; border-radius: 4px; background: #f4f1e6; opacity: 0.35; }
    .bb-arco .a-riga.corta { inline-size: 66%; }
    .bb-arco p { margin: 8px 0 0; font: 500 0.72rem/1.5 ui-monospace, Menlo, monospace; letter-spacing: 0.14em; text-transform: uppercase; color: #dfe3d2; }
    .bb-sezione { padding: clamp(36px, 5vw, 60px) 0; }
    .bb-num { font: 500 0.75rem/1.5 ui-monospace, Menlo, monospace; letter-spacing: 0.2em; color: #5d7351; margin: 0 0 10px; }
    .bb-sezione h2 { font: 600 clamp(1.8rem, 4vw, 2.8rem)/1.05 Fraunces, Georgia, serif; margin: 0 0 8px; }
    .bb-sotto { color: #5c5d52; margin: 0 0 28px; max-inline-size: 56ch; }
    .bb-camere { display: grid; gap: 14px; grid-template-columns: 1fr; }
    @media (min-width: 860px) { .bb-camere { grid-template-columns: repeat(3, 1fr); } }
    .bb-camera { background: #fffdf7; border: 1px solid #2a2b24; border-radius: 12px; padding: 24px; display: grid; gap: 8px; align-content: start; }
    .bb-camera h3 { font: 600 1.4rem/1.1 Fraunces, Georgia, serif; margin: 0; }
    .bb-camera .pr { font: 600 1.6rem/1 Fraunces, Georgia, serif; color: #5d7351; }
    .bb-camera .pr small { font: 500 0.8rem Archivo, sans-serif; color: #5c5d52; }
    .bb-camere .bb-camera:nth-child(1) { border-width: 2px; }
    .bb-camere .bb-camera:nth-child(2) { border-block-start: 6px solid #5d7351; }
    .bb-camere .bb-camera:nth-child(3) { background: #fff; }
    .bb-camera p { margin: 0; color: #5c5d52; font-size: 0.95rem; }
    .bb-link { display: inline-block; margin-block-start: 22px; font-weight: 700; color: #5d7351; }
    .bb-vigne { display: block; margin-block-end: 8px; }
    .bb-sfondo { position: relative; }
    .bb-parola { position: absolute; top: -8px; right: 0; font: 600 clamp(3.4rem, 10vw, 7rem)/1 Fraunces, Georgia, serif; font-style: italic; color: transparent; -webkit-text-stroke: 1px #b3b8a1; opacity: 0.6; pointer-events: none; }
    .bb-due { display: grid; gap: 14px; grid-template-columns: 1fr; }
    @media (min-width: 860px) { .bb-due { grid-template-columns: 1fr 1fr; } }
    .bb-blocco { background: #fffdf7; border: 1px solid #2a2b24; border-radius: 12px; padding: 24px; }
    .bb-blocco h3 { font: 600 1.3rem/1.2 Fraunces, Georgia, serif; margin: 0 0 8px; }
    .bb-blocco p, .bb-blocco li { color: #5c5d52; font-size: 0.95rem; }
    .bb-blocco ul { margin: 10px 0 0; padding-inline-start: 18px; }
    .bb-citazione { background: #2a2b24; color: #f4f1e6; padding: clamp(36px, 6vw, 64px) 0; }
    .bb-citazione blockquote { margin: 0; font: 500 clamp(1.4rem, 3.4vw, 2.2rem)/1.3 Fraunces, Georgia, serif; font-style: italic; max-inline-size: 28ch; }
    .bb-citazione cite { display: block; margin-block-start: 14px; font-style: normal; font: 500 0.78rem/1.5 ui-monospace, Menlo, monospace; letter-spacing: 0.1em; text-transform: uppercase; color: #b9bcae; }
    .bb-faq details { border-block-start: 1px solid #2a2b24; }
    .bb-faq summary { cursor: pointer; font: 600 1.1rem/1.3 Fraunces, Georgia, serif; padding: 14px 0; list-style: none; }
    .bb-faq summary::-webkit-details-marker { display: none; }
    .bb-faq .r { padding: 0 0 16px; color: #5c5d52; margin: 0; max-inline-size: 60ch; }
    .bb-contatti { display: grid; gap: 8px; font-size: 1.05rem; }
    .bb-contatti a { color: inherit; font-weight: 700; }
    .bb-piede { border-block-start: 1px solid #2a2b24; margin-block-start: 8px; padding: 24px 0 28px; font-size: 0.88rem; color: #5c5d52; display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; }
    .bb-piede a { color: inherit; }
  </style>

  <div class="bb">
    <div class="bb-involucro">
      <header class="bb-top">
        <a class="bb-marchio" href="/demo/beb-single">Casa Verde<small>Bed &amp; Breakfast</small></a>
        <nav class="bb-nav" aria-label="Navigazione demo">
          <a href="/demo/beb/camere">Camere</a><a href="#colazione">Colazione</a><a href="#domande">Domande</a><a href="#contatti">Contatti</a>
        </nav>
        <a class="bb-cta" href={telHref}>Verifica date</a>
      </header>
      <nav class="bb-subnav" aria-label="Sezioni"><a href="#domande">Domande</a><a href="#contatti">Contatti</a></nav>

      <section class="bb-hero" aria-labelledby="bb-titolo">
        <div>
          <p class="bb-kicker">Colline astigiane · 3 camere</p>
          <h1 id="bb-titolo">Dormi piano, <em>svegliati verde.</em></h1>
          <p>Cascina ristrutturata tra le vigne: tre camere silenziose, colazione con torta del giorno e consigli veri su dove andare.</p>
          <div class="bb-hero-riga">
            <a class="bb-cta" href={telHref}>Verifica le date</a>
            <a class="bb-tel" href={telHref}>{tel}</a>
          </div>
          <p class="bb-meta">Colazione inclusa · check-in 15:00 – 20:00 · bimbi benvenuti</p>
        </div>
        <div class="bb-arco" aria-hidden="true">
          <svg class="bb-vigne" width="120" height="70" viewBox="0 0 120 70" fill="none" stroke="#e8e4d2" stroke-width="1.5"><circle cx="92" cy="18" r="10" /><path d="M4 50 Q30 34 60 48 T116 44" /><path d="M4 58 Q30 44 60 56 T116 52" /></svg>
          <span class="a-titolo"></span>
          <span class="a-riga"></span>
          <span class="a-riga corta"></span>
          <p>La corte · vigne tutt’intorno</p>
        </div>
      </section>

      <section class="bb-sezione bb-sfondo" aria-labelledby="bb-camere-t">
        <span class="bb-parola" aria-hidden="true">camere</span>
        <p class="bb-num">01 · Le camere</p>
        <h2 id="bb-camere-t">Tre camere, tre caratteri</h2>
        <p class="bb-sotto">Prezzi a notte per due ospiti, colazione inclusa. Pulizia giornaliera sempre compresa.</p>
        <div class="bb-camere">
          {camere.map((c) => (
            <div class="bb-camera">
              <h3>{c.nome}</h3>
              <p class="pr">{c.prezzo} <small>/ notte</small></p>
              <p>{c.testo}</p>
            </div>
          ))}
        </div>
      </section>
    </div>

    <div class="bb-citazione">
      <div class="bb-involucro">
        <blockquote>“Silenzio vero, letto comodissimo e una torta che sogniamo ancora.”</blockquote>
        <cite>Anna e Luca · recensione dimostrativa</cite>
      </div>
    </div>

    <div class="bb-involucro">
      <section class="bb-sezione" id="colazione" aria-labelledby="bb-colazione-t" style="padding-block-start:0">
        <p class="bb-num">02 · Colazione e dintorni</p>
        <h2 id="bb-colazione-t">La giornata comincia bene</h2>
        <div class="bb-due" style="margin-block-start:24px">
          <div class="bb-blocco">
            <h3>Colazione inclusa</h3>
            <p>Torta del giorno, pane e marmellate, yogurt e frutta, caffè e cappuccini senza limite. Orari 8:00 – 10:00, in giardino d’estate.</p>
          </div>
          <div class="bb-blocco">
            <h3>Cosa fare intorno</h3>
            <ul>
              <li>Sentiero tra le vigne dietro casa (40 min)</li>
              <li>Cantine e degustazioni a 10 minuti</li>
              <li>Asti e il mercato del sabato a 15 minuti</li>
            </ul>
          </div>
        </div>
      </section>
    </div>

    <div class="bb-involucro">
      <section class="bb-sezione" id="domande" aria-labelledby="bb-domande-t">
        <p class="bb-num">03 · Domande</p>
        <h2 id="bb-domande-t">Prima di prenotare</h2>
        <div class="bb-faq" style="margin-block-start:20px">
          <details><summary>A che ora sono check-in e check-out?</summary><p>Check-in 15:00 – 20:00, check-out entro le 10:30. Se arrivi tardi, avvisaci e ci organizziamo.</p></details>
          <details><summary>Posso venire con il cane?</summary><p>Sì, un cane di piccola taglia per camera con supplemento di € 10 a notte. Avvisaci prima.</p></details>
          <details><summary>C’è il parcheggio?</summary><p>Sì, corte privata gratuita davanti all’ingresso.</p></details>
        </div>
      </section>

      <section class="bb-sezione" id="contatti" aria-labelledby="bb-contatti-t" style="padding-block-start:0">
        <p class="bb-num">04 · Contatti</p>
        <h2 id="bb-contatti-t">Verifica le date</h2>
        <div class="bb-contatti" style="margin-block-start:20px">
          <span>Strada delle Vigne 12, 14100 Asti <small>(indirizzo dimostrativo)</small></span>
          <a href={telHref}>{tel}</a>
          <a href={`mailto:${email}`}>{email}</a>
          <a href="https://www.google.com/maps/search/?api=1&query=Asti" target="_blank" rel="noopener noreferrer">Come arrivare →</a>
        </div>
      </section>

      <footer class="bb-piede">
        <span>Casa Verde · attività fittizia a scopo dimostrativo</span>
        <span>Demo concept by Trebla Studio · <a href="/demo">Tutte le demo</a></span>
      </footer>
    </div>
  </div>
</DemoLayout>
