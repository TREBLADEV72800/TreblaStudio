---
import DemoLayout from '../../layouts/DemoLayout.astro';

const demos = [
  {
    slug: 'ristorante',
    nome: 'Osteria del Borgo',
    settore: 'Ristorante · Pizzeria',
    testo: 'Cucina piemontese e pizza nel cuore del borgo: menu con prezzi, prenotazione tavoli, serate a tema.',
    colore: '#3a2415',
    fondo: '#f3e8d5',
    accento: '#b4551d',
  },
  {
    slug: 'parrucchiere',
    nome: 'Aura · Hair & Beauty',
    settore: 'Parrucchiere · Beauty',
    testo: 'Taglio, colore e trattamenti in un salone luminoso: listino chiaro, gallery lavori, prenotazione rapida.',
    colore: '#22201c',
    fondo: '#faf7f2',
    accento: '#8a6d3b',
  },
  {
    slug: 'impresa',
    nome: 'Officina Nord',
    settore: 'Impresa edile · Artigiani',
    testo: 'Ristrutturazioni e manutenzione con portfolio lavori, processo in 4 passi e richiesta preventivo.',
    colore: '#1c2126',
    fondo: '#eceff1',
    accento: '#c8641a',
  },
  {
    slug: 'studio',
    nome: 'Studio Forma',
    settore: 'Commercialista',
    testo: 'Fisco e contabilità per piccole imprese: servizi, metodo, FAQ e primo appuntamento senza impegno.',
    colore: '#1f2a37',
    fondo: '#f2f4f6',
    accento: '#2f5d50',
  },
  {
    slug: 'bar',
    nome: 'Caffè Lumen',
    settore: 'Bar · Caffetteria',
    testo: 'Colazioni, pranzi veloci e aperitivi in centro: menu del giorno, orari lunghi, eventi della settimana.',
    colore: '#20242b',
    fondo: '#f6efe3',
    accento: '#c22e3a',
  },
];
---

<DemoLayout
  title="Demo siti web per attività locali | Trebla Studio"
  description="Catalogo privato di concept dimostrativi realizzati da Trebla Studio. Le attività mostrate sono fittizie."
>
  <style>
    .demo-indice { background: #f7f2e8; color: #1d1712; font-family: Archivo, system-ui, sans-serif; padding-block-end: 72px; }
    .demo-involucro { inline-size: min(1160px, 100% - 40px); margin-inline: auto; }
    .demo-hero { padding: clamp(40px, 7vw, 88px) 0 clamp(28px, 4vw, 48px); max-inline-size: 62ch; }
    .demo-kicker { font: 500 0.75rem/1.5 ui-monospace, Menlo, monospace; letter-spacing: 0.16em; text-transform: uppercase; color: #b23a12; margin: 0 0 12px; }
    .demo-hero h1 { font: 600 clamp(2rem, 5vw, 3.6rem)/1.02 Fraunces, Georgia, serif; letter-spacing: -0.02em; margin: 0; }
    .demo-hero h1 em { font-style: italic; font-weight: 500; color: #b23a12; }
    .demo-hero p { font-size: 1.1rem; line-height: 1.6; color: #6c6054; margin: 16px 0 0; }
    .demo-griglia { list-style: none; margin: 32px 0 0; padding: 0; display: grid; gap: 20px; grid-template-columns: 1fr; }
    @media (min-width: 860px) { .demo-griglia { grid-template-columns: 1fr 1fr; } }
    .demo-card {
      display: grid; gap: 0; text-decoration: none; color: inherit;
      border: 1px solid #1d1712; border-radius: 12px; overflow: hidden; background: #fffdf7;
    }
    .demo-card:hover { background: #efe7d3; }
    .demo-anteprima { min-block-size: 150px; padding: 22px; display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; }
    .demo-anteprima span { display: block; border-radius: 4px; }
    .demo-corpo { padding: 20px 22px 22px; border-block-start: 1px solid #1d1712; }
    .demo-settore { font: 500 0.72rem/1.5 ui-monospace, Menlo, monospace; letter-spacing: 0.14em; text-transform: uppercase; color: #b23a12; margin: 0 0 8px; }
    .demo-corpo h2 { font: 600 1.6rem/1.1 Fraunces, Georgia, serif; margin: 0; }
    .demo-corpo p { color: #6c6054; margin: 10px 0 0; font-size: 0.98rem; }
    .demo-apri { display: inline-block; margin-block-start: 14px; font-weight: 700; font-size: 0.95rem; color: #b23a12; text-decoration: underline; text-underline-offset: 4px; }
    .demo-nota { margin: 28px 0 0; color: #6c6054; font-size: 0.92rem; max-inline-size: 62ch; }
  </style>

  <div class="demo-indice">
    <div class="demo-involucro">
      <section class="demo-hero" aria-labelledby="demo-titolo">
        <p class="demo-kicker">Trebla Studio · Catalogo privato</p>
        <h1 id="demo-titolo">Progettiamo siti che fanno venire voglia di <em>scegliere te.</em></h1>
        <p>Una selezione di concept realizzati da Trebla Studio per attività locali. Aprili e guardali con gli occhi del cliente.</p>
      </section>

      <ol class="demo-griglia">
        {demos.map((d) => (
          <li>
            <a class="demo-card" href={`/demo/${d.slug}`}>
              <div class="demo-anteprima" style={`background:${d.fondo};color:${d.colore}`} aria-hidden="true">
                <span style={`inline-size:46%;block-size:16px;background:${d.colore}`} />
                <span style={`inline-size:78%;block-size:10px;background:${d.accento};opacity:.75`} />
                <span style={`inline-size:64%;block-size:10px;background:${d.colore};opacity:.35`} />
              </div>
              <div class="demo-corpo">
                <p class="demo-settore">{d.settore}</p>
                <h2>{d.nome}</h2>
                <p>{d.testo}</p>
                <span class="demo-apri">Apri demo →</span>
              </div>
            </a>
          </li>
        ))}
      </ol>

      <p class="demo-nota">Questi progetti sono concept dimostrativi. Le attività mostrate sono fittizie: nomi, indirizzi, telefoni ed email non corrispondono a imprese reali.</p>
    </div>
  </div>
</DemoLayout>
