---
import LayoutPagina from '../../../layouts/LayoutPagina.astro';
import TestataPagina from '../../../components/TestataPagina.astro';
import Prosa from '../../../components/Prosa.astro';
import ElencoDomande from '../../../components/ElencoDomande.astro';
import Corpo from '../../../components/pagine/Corpo.astro';
import BandaPrezzo from '../../../components/pagine/BandaPrezzo.astro';
import CtaChiusura from '../../../components/pagine/CtaChiusura.astro';
import Bottone from '../../../components/ui/Bottone.astro';
import { SOCIAL_OPTIONS } from '../../../data/prezzi';
import { site } from '../../../data/sito';

const domande: [string, string][] = [
  ['Quanto costa?', `Ogni voce ha il prezzo indicato nel preventivo: profili ${SOCIAL_OPTIONS.find((e) => e.concept === 'profili')?.price}€, video ${SOCIAL_OPTIONS.find((e) => e.concept === 'video')?.price}€ ciascuno e grafiche per post e storie ${SOCIAL_OPTIONS.find((e) => e.concept === 'storie')?.price}€. Non è un canone mensile.`],
  ['Garantite nuovi follower?', 'No. Non compriamo follower e non promettiamo viralità o risultati che dipendono dalle piattaforme.'],
  ['Quali canali seguite?', 'Nel configuratore puoi selezionare Instagram, Facebook e TikTok. Definiamo insieme contenuti e cadenza.'],
  ['Devo fornire foto e video?', 'Concordiamo i materiali necessari prima del lavoro. La produzione continuativa non è compresa automaticamente.'],
];
const faqs = domande.map(([q, a]) => ({ q, a }));
const prezziSocial = SOCIAL_OPTIONS.map((e) => e.price);
---

<LayoutPagina
  title="Gestione social e contenuti ad Asti | Trebla"
  description="Profili, brevi video e grafiche social con prezzi chiari. Servizio per attività di Asti, senza promesse di follower o viralità."
  canonical="/servizi/social"
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` }, { '@type': 'ListItem', position: 2, name: 'Servizi', item: `${site.url}/servizi/` }, { '@type': 'ListItem', position: 3, name: 'Social', item: `${site.url}/servizi/social/` }] },
    { '@context': 'https://schema.org', '@type': 'Service', name: 'Contenuti per social media', provider: { '@id': `${site.url}/#studio` }, areaServed: { '@type': 'City', name: 'Asti' }, offers: SOCIAL_OPTIONS.map((e) => ({ '@type': 'Offer', name: e.name, price: String(e.price), priceCurrency: 'EUR' })) },
    { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: domande.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ]}
>
  <TestataPagina
    titolo="Social | con una direzione"
    tenue="con una direzione"
    percorso={[{ testo: 'Home', href: '/' }, { testo: 'Servizi', href: '/servizi/' }, { testo: 'Social' }]}
  >
    <p slot="lead">Sistemiamo i profili e prepariamo contenuti concordati. Senza promesse di follower o viralità.</p>
    <Bottone href="/preventivo/" testo="Scegli i contenuti" />
    <Bottone
      href="#"
      variante="secondario"
      testo="Chiedi su WhatsApp"
      data-wa="Ciao Trebla, vorrei informazioni sui social."
      target="_blank"
      rel="noopener noreferrer"
    />
  </TestataPagina>

  <section class="sezione">
    <Corpo etichetta="Servizio · 03">
      <Prosa>
        <h2>Cosa include</h2>
        <ul>
          {SOCIAL_OPTIONS.map((e) => <li>{e.name}: {e.price}€ per voce selezionata</li>)}
        </ul>
        <p>Canali disponibili nel preventivo: Instagram, Facebook e TikTok. I prezzi non sono un canone mensile. Quantità, materiali, cadenza e consegna vengono definite nella proposta.</p>
        <h2>Cosa non include</h2>
        <p>Follower acquistati, garanzie di visualizzazioni o vendite, campagne pubblicitarie a pagamento e una produzione continuativa non concordata.</p>
        <h2>Per chi è</h2>
        <p>Per attività che hanno già chiaro cosa vogliono comunicare e cercano aiuto per impostare i profili o preparare contenuti.</p>
      </Prosa>
    </Corpo>
  </section>

  <BandaPrezzo
    id="t-prezzo"
    titolo="Prezzi e tempi"
    testo={`Le voci costano da ${Math.min(...prezziSocial)}€ a ${Math.max(...prezziSocial)}€ ciascuna. La singola voce comprende il materiale concordato per quella richiesta; pacchetti o calendari ricorrenti non sono definiti dal listino attuale e vanno preventivati a parte.`}
  />

  <section class="sezione">
    <Corpo>
      <Prosa>
        <h2>Domande frequenti</h2>
      </Prosa>
      <ElencoDomande faqs={faqs} />
    </Corpo>
  </section>

  <CtaChiusura
    id="t-chiusura"
    etichetta="Prossimo passo"
    titolo="Scegli cosa ti serve davvero"
    tenue="ti serve davvero"
    testo="Costruiamo una proposta con voci e tempi concordati."
  >
    <Bottone href="/preventivo/" testo="Fai il preventivo" />
    <Bottone
      href="#"
      variante="wa"
      testo="WhatsApp"
      data-wa="Ciao Trebla, vorrei un preventivo per i social."
      target="_blank"
      rel="noopener noreferrer"
    />
  </CtaChiusura>
</LayoutPagina>
