---
import LayoutPagina from '../../../layouts/LayoutPagina.astro';
import TestataPagina from '../../../components/TestataPagina.astro';
import Prosa from '../../../components/Prosa.astro';
import ElencoDomande from '../../../components/ElencoDomande.astro';
import Corpo from '../../../components/pagine/Corpo.astro';
import BandaPrezzo from '../../../components/pagine/BandaPrezzo.astro';
import CtaChiusura from '../../../components/pagine/CtaChiusura.astro';
import Bottone from '../../../components/ui/Bottone.astro';
import { BASE_PRICES, OFFERTA_SITO } from '../../../data/prezzi';
import { site } from '../../../data/sito';

const domande: [string, string][] = [
  ['Quanto costa?', `Una pagina costa ${BASE_PRICES.singola}€, un sito a più pagine ${BASE_PRICES.multi}€. L’Offerta Tutto incluso costa ${OFFERTA_SITO.prezzo}€.`],
  ['Quanto tempo serve?', 'Dopo aver visto i materiali concordiamo una data. In genere il lavoro richiede una decina di giorni.'],
  ['Posso aggiornare i contenuti?', 'Al momento gli aggiornamenti vengono gestiti insieme a noi. Se vuoi cambiare un testo o una foto, concordiamo prima il lavoro e il costo.'],
  ['Il sito rimane mio?', 'Sì. A saldo completo il sito è tuo e non paghi un canone obbligatorio a Trebla.'],
];
const faqs = domande.map(([q, a]) => ({ q, a }));
const prezzi = [
  { valore: `${BASE_PRICES.singola}€`, etichetta: 'pagina singola' },
  { valore: `${BASE_PRICES.multi}€`, etichetta: 'più pagine' },
  { valore: `${OFFERTA_SITO.prezzo}€`, etichetta: OFFERTA_SITO.nome },
];
---

<LayoutPagina
  title="Realizzazione siti web ad Asti: prezzi chiari | Trebla"
  description={`Siti vetrina per attività di Asti: testi, contatti, mappe, privacy e hosting inclusi. Prezzi da ${BASE_PRICES.singola}€, tempi concordati e nessun canone Trebla.`}
  canonical="/servizi/siti-web"
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` }, { '@type': 'ListItem', position: 2, name: 'Servizi', item: `${site.url}/servizi/` }, { '@type': 'ListItem', position: 3, name: 'Siti web', item: `${site.url}/servizi/siti-web/` }] },
    { '@context': 'https://schema.org', '@type': 'Service', name: 'Realizzazione siti web', provider: { '@id': `${site.url}/#studio` }, areaServed: { '@type': 'City', name: 'Asti' }, offers: [{ '@type': 'Offer', name: 'Pagina singola', price: String(BASE_PRICES.singola), priceCurrency: 'EUR' }, { '@type': 'Offer', name: 'Sito a più pagine', price: String(BASE_PRICES.multi), priceCurrency: 'EUR' }, { '@type': 'Offer', name: OFFERTA_SITO.nome, price: String(OFFERTA_SITO.prezzo), priceCurrency: 'EUR' }] },
    { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: domande.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ]}
>
  <div class="sv-testata">
    <TestataPagina
      titolo="Un sito web | chiaro e tuo"
      percorso={[{ testo: 'Home', href: '/' }, { testo: 'Servizi', href: '/servizi/' }, { testo: 'Siti web' }]}
    >
      <p slot="lead">Una pagina singola da {BASE_PRICES.singola}€ o un sito a più pagine da {BASE_PRICES.multi}€. Per farti trovare, spiegare cosa fai e rendere semplici i contatti.</p>

      <!-- Oggetto: il telefono con la home di un'attività di esempio. Mostra cosa riceve il cliente. -->
      <div
        class="sv-oggetto sv-sito"
        role="img"
        aria-label="Esempio di home per un'attività locale: nome, orari di oggi, i bottoni Chiama, WhatsApp e Indicazioni, e il menu."
      >
        <div class="sv-sito__telefono">
          <div class="sv-sito__schermo">
            <p class="display sv-sito__nome">La tua attività</p>
            <p class="sv-sito__orari">Oggi 12:00–14:30 e 19:00–23:00</p>
            <div class="sv-sito__azioni">
              <span class="sv-sito__btn">Chiama</span>
              <span class="sv-sito__btn sv-sito__btn--wa">WhatsApp</span>
              <span class="sv-sito__btn">Indicazioni</span>
            </div>
            <p class="etichetta sv-sito__menu-titolo">Menu</p>
            <ul class="sv-sito__menu">
              <li><span>Antipasto</span><span>8€</span></li>
              <li><span>Primo</span><span>12€</span></li>
              <li><span>Secondo</span><span>14€</span></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="sv-azioni entra" style="--d:calc(var(--t-1) * 3)">
        <Bottone href="/preventivo/?servizi=sito" testo="Fai il preventivo" />
        <Bottone
          href="#"
          variante="secondario"
          testo="Scrivici su WhatsApp"
          data-wa="Ciao Trebla, vorrei informazioni sul servizio siti web."
          target="_blank"
          rel="noopener noreferrer"
        />
      </div>
    </TestataPagina>
  </div>

  <section class="sezione">
    <Corpo>
      <Prosa>
        <h2>Cosa include</h2>
        <ul>
          <li>Testi essenziali preparati insieme a te</li>
          <li>Telefono, WhatsApp, mappa e informazioni utili</li>
          <li>Privacy, cookie, hosting gratuito e configurazione dominio</li>
          <li>Due revisioni prima della pubblicazione</li>
          <li>Prenotazioni WhatsApp, versione inglese essenziale e SEO locale disponibili senza sovrapprezzo</li>
        </ul>
        <h2>Cosa resta fuori</h2>
        <p>Domini a pagamento e servizi di terze parti, funzionalità con login o pagamenti online, manutenzione continuativa e modifiche dopo la pubblicazione. Ogni eventuale costo esterno viene chiarito prima.</p>
        <h2>Per chi è</h2>
        <p>Per attività locali che vogliono presentarsi bene da telefono e ricevere richieste senza costringere le persone a cercare le informazioni.</p>
      </Prosa>
    </Corpo>
  </section>

  <BandaPrezzo
    id="t-prezzo"
    prezzi={prezzi}
    testo={`La pagina singola costa ${BASE_PRICES.singola}€, il sito a più pagine ${BASE_PRICES.multi}€. L’Offerta Tutto incluso costa ${OFFERTA_SITO.prezzo}€. In genere una decina di giorni dalla raccolta dei materiali; la data viene concordata prima.`}
  />

  <section class="sezione">
    <Corpo>
      <Prosa>
        <h2>Domande frequenti</h2>
      </Prosa>
      <ElencoDomande faqs={faqs} />
    </Corpo>
  </section>

  <CtaChiusura
    id="t-chiusura"
    titolo="Mettiamo in chiaro costi e tempi"
    testo="Compila il preventivo o raccontaci il progetto su WhatsApp."
  >
    <Bottone href="/preventivo/?servizi=sito" testo="Fai il preventivo" />
    <Bottone
      href="#"
      variante="wa"
      testo="Scrivici su WhatsApp"
      data-wa="Ciao Trebla, vorrei un preventivo per un sito web."
      target="_blank"
      rel="noopener noreferrer"
    />
  </CtaChiusura>
</LayoutPagina>

<style>
  /* Testata con oggetto. TestataPagina non ha uno slot per l'oggetto: il suo slot di default
     (bottoni e oggetto) va in display: contents, così da 960px le voci diventano figli della sua
     griglia e l'oggetto sta accanto all'H1. Sotto 960px tutto è in colonna: lead, oggetto, bottoni. */
  .sv-testata > :global(.tp) > :global(.tp__extra) {
    display: contents;
  }

  .sv-oggetto {
    justify-self: start;
    margin-block-start: var(--s-6);
  }

  .sv-azioni {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-block-start: var(--s-6);
  }

  @media (min-width: 960px) {
    .sv-testata > :global(.tp) > :global(.tp__titolo) {
      grid-column: 1 / span 7;
      grid-row: 2;
    }

    .sv-testata > :global(.tp) > :global(.tp__lead) {
      grid-column: 1 / span 6;
      grid-row: 3;
      justify-self: start;
      margin-block-start: var(--s-5);
    }

    .sv-oggetto {
      grid-column: 8 / -1;
      grid-row: 2 / span 2;
      justify-self: end;
      align-self: center;
      margin-block-start: 0;
    }

    .sv-azioni {
      grid-column: 1 / span 7;
      grid-row: 4;
      margin-block-start: var(--s-6);
    }
  }

  /* Oggetto: telefono stilizzato in tipografia. Inchiostro per la scocca, carta per lo schermo. */
  .sv-sito__telefono {
    inline-size: min(220px, 100%);
    padding: 8px;
    border-radius: 28px;
    background: var(--inchiostro);
  }

  .sv-sito__schermo {
    block-size: 100%;
    padding: 16px 12px;
    border-radius: 20px;
    background: var(--carta);
    overflow: hidden;
  }

  .sv-sito__nome {
    margin: 0;
    max-inline-size: none;
    font-size: 24px;
    line-height: 0.92;
    color: var(--inchiostro);
  }

  .sv-sito__orari {
    margin: var(--s-2) 0 0;
    max-inline-size: none;
    font: 400 12px / 1.4 var(--font-testo);
    color: var(--morbido);
  }

  .sv-sito__azioni {
    display: grid;
    gap: 6px;
    margin-block-start: var(--s-3);
  }

  .sv-sito__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 30px;
    border: 1px solid var(--inchiostro);
    border-radius: 999px;
    font: 600 12px / 1 var(--font-ui);
    color: var(--inchiostro);
  }

  .sv-sito__btn--wa {
    border-color: var(--verde);
    background: var(--verde);
    color: var(--su-verde);
  }

  .sv-sito__menu-titolo {
    margin: var(--s-4) 0 0;
    max-inline-size: none;
  }

  .sv-sito__menu {
    margin: var(--s-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .sv-sito__menu li {
    display: flex;
    justify-content: space-between;
    gap: var(--s-2);
    padding-block: 6px;
    border-block-start: 1px solid var(--linea);
    font: 400 12px / 1.3 var(--font-testo);
    color: var(--inchiostro);
    font-variant-numeric: tabular-nums lining-nums;
  }
</style>
