---
import LayoutPagina from '../../../layouts/LayoutPagina.astro';
import TestataPagina from '../../../components/TestataPagina.astro';
import Prosa from '../../../components/Prosa.astro';
import ElencoDomande from '../../../components/ElencoDomande.astro';
import Corpo from '../../../components/pagine/Corpo.astro';
import BandaPrezzo from '../../../components/pagine/BandaPrezzo.astro';
import CtaChiusura from '../../../components/pagine/CtaChiusura.astro';
import Bottone from '../../../components/ui/Bottone.astro';
import { DESIGN_OPTIONS } from '../../../data/prezzi';
import { site } from '../../../data/sito';

const prezzi = DESIGN_OPTIONS.map((e) => e.price);
const prezzoMin = Math.min(...prezzi);
const prezzoMax = Math.max(...prezzi);
const domande: [string, string][] = [
  ['Quanto costano le grafiche?', `Le singole voci vanno da ${prezzoMin}€ a ${prezzoMax}€, secondo il materiale scelto. Il prezzo esatto appare nel preventivo.`],
  ['Stampate i materiali?', 'No. Prepariamo i file grafici pronti per la stampa, poi scegli tu dove stamparli.'],
  ['Posso chiedere solo un logo?', 'Sì, puoi scegliere le singole voci nel preventivo senza acquistare un sito.'],
  ['Quando ricevo i file?', 'Definiamo tempi e consegna nella proposta, dopo aver chiarito i materiali e cosa serve.'],
];
const faqs = domande.map(([q, a]) => ({ q, a }));
const prezziBanda = [
  { valore: `${prezzoMin}€`, etichetta: 'la voce più economica' },
  { valore: `${prezzoMax}€`, etichetta: 'la voce più costosa' },
];
---

<LayoutPagina
  title="Grafiche e identità visiva ad Asti | Trebla"
  description="Logo, biglietti, volantini e menu: prezzi chiari per materiali grafici coordinati. Trebla lavora ad Asti e consegna file pronti per la stampa."
  canonical="/servizi/grafiche"
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` }, { '@type': 'ListItem', position: 2, name: 'Servizi', item: `${site.url}/servizi/` }, { '@type': 'ListItem', position: 3, name: 'Grafiche', item: `${site.url}/servizi/grafiche/` }] },
    { '@context': 'https://schema.org', '@type': 'Service', name: 'Design grafico', provider: { '@id': `${site.url}/#studio` }, areaServed: { '@type': 'City', name: 'Asti' }, offers: DESIGN_OPTIONS.map((e) => ({ '@type': 'Offer', name: e.name, price: String(e.price), priceCurrency: 'EUR' })) },
    { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: domande.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ]}
>
  <div class="sv-testata">
    <TestataPagina
      titolo="Grafiche | per farti riconoscere"
      percorso={[{ testo: 'Home', href: '/' }, { testo: 'Servizi', href: '/servizi/' }, { testo: 'Grafiche' }]}
    >
      <p slot="lead">Logo, biglietti e materiali coordinati con il sito. Scegli le voci che servono, senza pacchetti obbligatori.</p>

      <!-- Oggetto: un menù cartaceo in tipografia. Mostra il tipo di file che il cliente riceve. -->
      <div
        class="sv-oggetto sv-menu"
        role="img"
        aria-label="Esempio di menù cartaceo: titolo, tre voci con il prezzo allineato e un piccolo logo tipografico."
      >
        <div class="sv-menu__foglio">
          <p class="display sv-menu__logo">La tua<br />attività</p>
          <p class="display sv-menu__titolo">Menù</p>
          <ul class="sv-menu__voci">
            <li><span>Primo del giorno</span><span class="display sv-menu__prezzo">9€</span></li>
            <li><span>Secondo del giorno</span><span class="display sv-menu__prezzo">12€</span></li>
            <li><span>Dolce della casa</span><span class="display sv-menu__prezzo">5€</span></li>
          </ul>
        </div>
      </div>

      <div class="sv-azioni entra" style="--d:calc(var(--t-1) * 3)">
        <Bottone href="/preventivo/?servizi=grafiche" testo="Fai il preventivo" />
        <Bottone
          href="#"
          variante="secondario"
          testo="Scrivici su WhatsApp"
          data-wa="Ciao Trebla, vorrei informazioni sulle grafiche."
          target="_blank"
          rel="noopener noreferrer"
        />
      </div>
    </TestataPagina>
  </div>

  <section class="sezione">
    <Corpo>
      <Prosa>
        <h2>Cosa possiamo preparare</h2>
        <ul>
          {DESIGN_OPTIONS.map((e) => <li>{e.name}: {e.price}€</li>)}
        </ul>
        <p>Consegniamo i file grafici. La stampa non è inclusa.</p>
        <h2>Cosa non include</h2>
        <p>Stampa, produzione di materiali fisici e revisioni senza limite. Definiamo i file e le correzioni comprese prima di iniziare.</p>
        <h2>Per chi è</h2>
        <p>Per attività che vogliono mantenere lo stesso aspetto su sito, biglietti, menu o materiali promozionali.</p>
      </Prosa>
    </Corpo>
  </section>

  <BandaPrezzo
    id="t-prezzo"
    prezzi={prezziBanda}
    testo={`Le voci costano da ${prezzoMin}€ a ${prezzoMax}€, in base al materiale. Tempi e consegna sono concordati nella proposta.`}
  />

  <section class="sezione">
    <Corpo>
      <Prosa>
        <h2>Domande frequenti</h2>
      </Prosa>
      <ElencoDomande faqs={faqs} />
    </Corpo>
  </section>

  <CtaChiusura
    id="t-chiusura"
    titolo="Partiamo dal materiale che ti serve"
    testo="Seleziona le grafiche nel preventivo oppure scrivici."
  >
    <Bottone href="/preventivo/?servizi=grafiche" testo="Fai il preventivo" />
    <Bottone
      href="#"
      variante="wa"
      testo="Scrivici su WhatsApp"
      data-wa="Ciao Trebla, vorrei un preventivo per delle grafiche."
      target="_blank"
      rel="noopener noreferrer"
    />
  </CtaChiusura>
</LayoutPagina>

<style>
  /* Testata con oggetto: vedi la nota in siti-web. TestataPagina non ha uno slot per l'oggetto,
     quindi lo slot di default va in display: contents e le voci si collocano sulla sua griglia. */
  .sv-testata > :global(.tp) > :global(.tp__extra) {
    display: contents;
  }

  .sv-oggetto {
    justify-self: start;
    margin-block-start: var(--s-6);
  }

  .sv-azioni {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-block-start: var(--s-6);
  }

  @media (min-width: 960px) {
    .sv-testata > :global(.tp) > :global(.tp__titolo) {
      grid-column: 1 / span 7;
      grid-row: 2;
    }

    .sv-testata > :global(.tp) > :global(.tp__lead) {
      grid-column: 1 / span 6;
      grid-row: 3;
      justify-self: start;
      margin-block-start: var(--s-5);
    }

    .sv-oggetto {
      grid-column: 8 / -1;
      grid-row: 2 / span 2;
      justify-self: end;
      align-self: center;
      margin-block-start: 0;
    }

    .sv-azioni {
      grid-column: 1 / span 7;
      grid-row: 4;
      margin-block-start: var(--s-6);
    }
  }

  /* Oggetto: foglio di menù. Carta-2 su carta, un filetto di contorno, voci separate da filetti. */
  .sv-menu__foglio {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    inline-size: min(280px, 100%);
    aspect-ratio: 3 / 4;
    padding: var(--s-6) var(--s-5);
    border: 1px solid var(--linea);
    background: var(--carta-2);
    color: var(--inchiostro);
  }

  .sv-menu__logo {
    align-self: flex-start;
    margin: 0;
    max-inline-size: none;
    padding-block-end: var(--s-2);
    border-block-end: 1px solid var(--inchiostro);
    font-size: 16px;
    line-height: 0.92;
    color: var(--inchiostro);
  }

  .sv-menu__titolo {
    margin: 0;
    max-inline-size: none;
    font-size: 72px;
    line-height: 0.88;
    color: var(--inchiostro);
  }

  .sv-menu__voci {
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  .sv-menu__voci li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    padding-block: var(--s-3);
    border-block-start: 1px solid var(--linea);
    font: 600 15px / 1.3 var(--font-ui);
    color: var(--inchiostro);
  }

  .sv-menu__prezzo {
    font-size: 22px;
    line-height: 1;
    font-variant-numeric: tabular-nums lining-nums;
  }
</style>
