---
import Layout from '../../layouts/Layout.astro';
import Faq from '../../components/Faq.astro';
import { FAQS } from '../../data/faq';
---

<Layout
  title="Domande frequenti | Trebla"
  description="Quanto costa, in quanto tempo, serve un canone, cosa serve per iniziare: le risposte oneste alle domande che ci fanno sempre."
  canonical="/faq"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }}
>
  <div class="involucro">
    <section class="pagina-titolo" style="padding-block-start:clamp(20px,4vw,36px)" aria-labelledby="titolo">
      <h1 id="titolo" style="white-space:nowrap;max-inline-size:none;font-size:clamp(2rem,9vw,5.6rem);margin:0">Domande <em>frequenti</em></h1>
    </section>

    <section class="sezione" style="padding-block-start:0" aria-label="Tutte le domande">
      <Faq faqs={FAQS} />
      <div class="hero-azioni">
        <a class="btn btn-mattone" href="/preventivo">Fai il preventivo in 2 minuti</a>
        <a class="btn btn-fantasma" href="/contatti">Oppure parliamone</a>
      </div>
    </section>
  </div>
</Layout>
