---
import LayoutPagina from '../../layouts/LayoutPagina.astro';
import ElencoDomande from '../../components/ElencoDomande.astro';
import { FAQS } from '../../data/domande-frequenti';
---

<LayoutPagina
  title="Domande frequenti sui siti web | Trebla"
  description="Quanto costa un sito, in quanto tempo è online, serve un canone, cosa serve per iniziare: risposte chiare alle domande più comuni."
  canonical="/faq"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }}
>
  <div class="involucro">
    <section class="pagina-titolo" style="padding-block-start:clamp(10px,2vw,20px)" aria-labelledby="titolo">
      <div class="faq-titolo-riga">
      <h1 id="titolo" style="white-space:nowrap;max-inline-size:none;font-size:calc(clamp(1.9rem,8.5vw,5.2rem) - 5px);margin:0">Domande <em>frequenti</em></h1>
      <a class="btn btn-fantasma solo-pc" href="/contatti">Oppure parliamone</a>
      </div>
    </section>

    <section class="sezione sezione-flush" aria-label="Tutte le domande">
      <ElencoDomande faqs={FAQS} />
      <div class="hero-azioni">
        <a class="btn btn-mattone" href="/preventivo">Fai il preventivo in 2 minuti</a>
      </div>
    </section>
  </div>
</LayoutPagina>
