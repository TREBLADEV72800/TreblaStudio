---
import LayoutPagina from '../../layouts/LayoutPagina.astro';
import TestataPagina from '../../components/TestataPagina.astro';
import ElencoDomande from '../../components/ElencoDomande.astro';
import Bottone from '../../components/ui/Bottone.astro';
import { FAQS } from '../../data/domande-frequenti';
---

<LayoutPagina
  title="Domande frequenti sui siti web ad Asti | Trebla"
  description="Prezzi, tempi, dominio, revisioni, aggiornamenti e privacy: risposte alle domande sui siti web e servizi Trebla ad Asti."
  canonical="/faq"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }}
>
  <TestataPagina
    titolo="Domande frequenti"
    tenue="frequenti"
    percorso={[{ testo: 'Home', href: '/' }, { testo: 'FAQ' }]}
  >
    <Bottone href="/contatti/" variante="secondario" testo="Oppure parliamone" />
  </TestataPagina>

  <section class="faq-sez" aria-label="Tutte le domande">
    <div class="contenitore faq-corpo">
      <div class="faq-corpo__etichetta">
        <p class="etichetta">{FAQS.length} domande</p>
      </div>
      <div class="faq-corpo__lista">
        <ElencoDomande faqs={FAQS} />
      </div>
    </div>
  </section>

  <section class="fascia-grafite faq-chiusura">
    <div class="contenitore">
      <Bottone href="/preventivo/" variante="primario" testo="Fai il preventivo in 2 minuti" />
    </div>
  </section>
</LayoutPagina>

<style>
  /* Padding con il token --sezione (la .sezione condivisa è azzerata dal CSS legacy per le sezioni adiacenti). */
  .faq-sez {
    padding-block: var(--sezione);
  }

  /* Mobile: etichetta sopra, elenco sotto. Da 960px: etichetta sticky nelle colonne 1-4, elenco nelle colonne 5-12. */
  .faq-corpo {
    display: grid;
    gap: var(--s-5);
  }

  .faq-corpo__etichetta {
    align-self: start;
  }

  @media (min-width: 960px) {
    .faq-corpo {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: start;
    }

    .faq-corpo__etichetta {
      grid-column: 1 / span 4;
      position: sticky;
      top: calc(var(--hh) + 32px);
    }

    .faq-corpo__lista {
      grid-column: 5 / -1;
    }
  }

  .faq-chiusura {
    padding-block: clamp(40px, 5vw, 72px);
  }
</style>
