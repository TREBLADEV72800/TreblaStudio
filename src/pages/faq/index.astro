---
import LayoutPagina from '../../layouts/LayoutPagina.astro';
import TestataPagina from '../../components/TestataPagina.astro';
import ElencoDomande from '../../components/ElencoDomande.astro';
import TitoloRivelato from '../../components/ui/TitoloRivelato.astro';
import Bottone from '../../components/ui/Bottone.astro';
import { FAQS, GRUPPI_FAQ } from '../../data/domande-frequenti';

const gruppi = GRUPPI_FAQ.map((g) => ({ ...g, faqs: FAQS.filter((f) => f.gruppo === g.id) }));
---

<LayoutPagina
  title="Domande frequenti sui siti web ad Asti | Trebla"
  description="Prezzi, tempi, dominio, revisioni, aggiornamenti e privacy: risposte alle domande sui siti web e servizi Trebla ad Asti."
  canonical="/faq"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }}
>
  <TestataPagina titolo="Domande frequenti" percorso={[{ testo: 'Home', href: '/' }, { testo: 'FAQ' }]}>
    <Bottone href="/contatti/" variante="secondario" testo="Scrivici" />
  </TestataPagina>

  <section class="sezione" aria-label="Tutte le domande">
    <div class="contenitore faq-corpo">
      <nav class="faq-indice" aria-label="Gruppi di domande">
        <ul>
          {gruppi.map((g) => (
            <li><a class="link-sottolineato" href={`#${g.id}`}>{g.titolo}</a></li>
          ))}
        </ul>
      </nav>

      <div class="faq-corpo__lista">
        {
          gruppi.map((g) => (
            <div class="faq-gruppo">
              <TitoloRivelato tag="h2" testo={g.titolo} id={g.id} classe="faq-gruppo__titolo" />
              <ElencoDomande faqs={g.faqs} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="fascia-grafite sezione">
    <div class="contenitore">
      <Bottone href="/preventivo/" variante="primario" testo="Fai il preventivo" />
    </div>
  </section>
</LayoutPagina>

<style>
  /* Mobile: indice in linea sopra, gruppi sotto. Da 960px: indice sticky nelle colonne 1-4,
     gruppi nelle colonne 5-12. L'indice sta dove prima c'era "24 domande". */
  .faq-corpo {
    display: grid;
    gap: var(--s-7);
  }

  .faq-indice ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .faq-indice a {
    display: inline-flex;
    align-items: center;
    min-block-size: 24px;
    font: 600 var(--fs-ui) / 1.4 var(--font-ui);
    color: var(--inchiostro);
  }

  /* Ogni gruppo: il titolo in display a --fs-h2-xs; l'ancora sta sotto l'header. */
  .faq-gruppo {
    scroll-margin-top: calc(var(--hh) + 24px);
  }

  .faq-gruppo + .faq-gruppo {
    margin-block-start: clamp(56px, 6vw, 96px);
  }

  .faq-gruppo :global(.faq-gruppo__titolo) {
    margin: 0 0 var(--s-5);
    font-size: var(--fs-h2-xs);
    line-height: 0.92;
  }

  @media (min-width: 960px) {
    .faq-corpo {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: start;
    }

    .faq-indice {
      grid-column: 1 / span 4;
      position: sticky;
      top: calc(var(--hh) + 32px);
    }

    .faq-indice ul {
      flex-direction: column;
      gap: 0;
    }

    .faq-indice li {
      border-block-end: 1px solid var(--linea);
    }

    .faq-indice li:first-child {
      border-block-start: 1px solid var(--linea);
    }

    .faq-indice a {
      display: flex;
      padding-block: var(--s-4);
    }

    .faq-corpo__lista {
      grid-column: 5 / -1;
    }
  }
</style>
