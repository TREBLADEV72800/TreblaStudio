---
import LayoutPagina from '../../layouts/LayoutPagina.astro';
import TestataPagina from '../../components/TestataPagina.astro';
import Prosa from '../../components/Prosa.astro';
import ContattiRiga from '../../components/pagine/contatti-riga.astro';
---

<LayoutPagina
  title="Contatti Trebla: WhatsApp, email e telefono ad Asti"
  description="Scrivici su WhatsApp o via email. Ti risponde una persona, in genere entro la giornata. Studio ad Asti, su appuntamento."
  canonical="/contatti"
>
  <TestataPagina titolo="Parliamone davvero" percorso={[{ testo: 'Home', href: '/' }, { testo: 'Contatti' }]}>
    <p slot="lead">Niente form che finiscono nel vuoto. Ci scrivi, ti risponde una persona, in genere entro la giornata.</p>
  </TestataPagina>

  <section class="sezione" aria-label="Canali di contatto">
    <div class="contenitore contatti-canali">
      <div class="contatti-gruppo">
        <p class="etichetta">Il modo più veloce</p>
        <ContattiRiga
          canale="WhatsApp"
          valore="Scrivici su WhatsApp"
          href="#"
          data-wa="Ciao Trebla! Vorrei un sito per la mia attività, parliamone."
          target="_blank"
          rel="noopener noreferrer"
        />
        <p class="contatti-gruppo__nota">Raccontaci in due righe che attività hai. Ti rispondiamo noi, non un bot.</p>
      </div>

      <div class="contatti-gruppo">
        <p class="etichetta">Se preferisci scrivere</p>
        <ContattiRiga
          canale="Email"
          valore="Scrivi un’email"
          href="#"
          data-mail=""
          data-mostra=""
          data-soggetto="Vorrei un sito per la mia attività"
        />
        <p class="contatti-gruppo__nota">Mandaci foto, menu, idee: tutto quello che hai già va benissimo.</p>
      </div>
    </div>
  </section>

  <section class="sezione" aria-label="Telefono e sede">
    <div class="contenitore contatti-diretti">
      <ContattiRiga canale="Telefono" valore="Chiama" href="#" data-tel="" data-mostra="" />
      <ContattiRiga canale="Sede" valore="Asti, su appuntamento." taglia="h3" />
    </div>
  </section>

  <section class="sezione">
    <div class="contenitore contatti-prosa">
      <div class="contatti-prosa__colonna">
        <Prosa>
          <h2>Da dove vuoi partire?</h2>
          <p>Puoi <a href="/preventivo/">preparare una stima</a> o dare un’occhiata ai <a href="/prezzi/">prezzi</a>. Il modulo non è disponibile senza un servizio di invio esterno: WhatsApp, email e telefono sono i canali diretti.</p>
          <h2>Domanda veloce</h2>
          <p>Non sai quali materiali servono? Va bene scriverci anche solo il nome dell’attività e cosa vorresti sistemare.</p>
        </Prosa>
      </div>
      <div class="contatti-prosa__colonna">
        <Prosa>
          <h2>Prima di scriverci</h2>
          <p>Se vuoi arrivare con le idee chiare, <a href="/preventivo/">fai il preventivo in 2 minuti</a>: rispondi a poche domande e arrivi da noi con già un prezzo indicativo in mano. Altrimenti raccontaci tutto a voce: va bene lo stesso.</p>
          <h2>Dove siamo</h2>
          <p>Asti, su appuntamento. Veniamo sul posto, in città. Preferisci chiamare? <a data-tel href="#">Chiama</a>.</p>
        </Prosa>
      </div>
    </div>
  </section>
</LayoutPagina>

<style>
  /* Canali: due gruppi affiancati da 960px, impilati sotto. */
  .contatti-canali {
    display: grid;
    gap: var(--s-8) var(--gap);
  }

  .contatti-gruppo {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .contatti-gruppo__nota {
    max-inline-size: 44ch;
    margin: 0;
    font: 400 var(--fs-body) / 1.55 var(--font-testo);
    color: var(--morbido);
  }

  /* Nei gruppi a metà pagina la riga è impilata: canale sopra, valore sotto, freccia a destra.
     Su tre colonne restano solo le righe a tutta larghezza (telefono, sede). */
  .contatti-gruppo :global(.contatti-riga) {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'canale freccia'
      'valore freccia';
    /* Il padding alto stretto: l'etichetta del gruppo sta vicina alla riga che introduce. */
    padding-block: var(--s-4) var(--s-6);
  }

  .contatti-diretti {
    display: grid;
  }

  @media (min-width: 960px) {
    .contatti-canali {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-9) var(--s-8);
    }
  }

  /* Prosa su due colonne da 960px. Questa pagina vuole testo inchiostro e nessun margine di contenitore. */
  .contatti-prosa {
    display: grid;
    gap: var(--s-7) var(--gap);
  }

  .contatti-prosa :global(.prosa) {
    margin-block-start: 0;
  }

  .contatti-prosa :global(.prosa p),
  .contatti-prosa :global(.prosa li) {
    color: var(--inchiostro);
  }

  @media (min-width: 960px) {
    .contatti-prosa {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-8) var(--gap);
    }
  }
</style>
