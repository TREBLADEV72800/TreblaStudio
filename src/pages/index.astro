---
import Layout from '../layouts/Layout.astro';
import Capitolo from '../components/Capitolo.astro';
import Faq from '../components/Faq.astro';
import { FAQS } from '../data/faq';

const settori = [
  'Ristoranti', 'Bar', 'Pizzerie', 'B&B', 'Barbieri', 'Saloni', 'Centri estetici',
  'Negozi', 'Artigiani', 'Officine', 'Professionisti', 'Associazioni',
];

const benefici = [
  { t: 'Si trova subito l’essenziale', d: 'Chi sei, dove sei, quando sei aperto. Senza scavare nei menu.' },
  { t: 'Menu e servizi leggibili', d: 'Prezzi chiari dal telefono, senza scaricare PDF. Anche con poco campo.' },
  { t: 'Contatti in un tocco', d: 'Telefono, WhatsApp, mappa e prenotazioni sempre in vista.' },
  { t: 'Ordine anche fuori dal sito', d: 'Google Business e mappe sistemati: orari e indicazioni giusti ovunque.' },
];

const HOME_FAQS = [
  'Quanto costa un sito?',
  'In quanto tempo è online?',
  'Non ho foto né testi. È un problema?',
  'Devo pagare un canone ogni anno?',
  'Come funziona, in pratica?',
];
const homeFaqs = FAQS.filter((f) => HOME_FAQS.includes(f.q)).sort((a, b) => HOME_FAQS.indexOf(a.q) - HOME_FAQS.indexOf(b.q));
---

<Layout
  title="Trebla: un sito chiaro per la tua attività | Asti"
  description="Trebla, studio indipendente ad Asti. Siti web semplici e veloci per ristoranti, negozi, artigiani e professionisti: prezzi chiari da 300 €, contatti sempre a portata di mano."
  canonical="/"
>
  <!-- HERO -->
  <div class="involucro">
    <section class="hero" aria-labelledby="titolo">
      <div class="hero-griglia">
        <div>
          <h1 id="titolo">Un sito chiaro<br />per far scegliere<br /><em>la tua attività.</em></h1>
          <p class="hero-lead">
            Siti web semplici e veloci per <strong>attività locali ad Asti e dintorni</strong>:
            prezzi chiari, un referente diretto e i contatti sempre a portata di mano.
          </p>
          <div class="hero-azioni">
            <a class="btn btn-mattone" href="/preventivo">Fai il preventivo in 2 minuti</a>
            <a class="btn btn-fantasma" href="/servizi">Scopri i servizi</a>
          </div>
        </div>

        <aside class="scheda" aria-label="Esempio: come ti vede un cliente con un sito Trebla">
          <div class="scheda-barra" aria-hidden="true"><i></i><i></i><i></i><span>trattoria-rossi.it</span></div>
          <div class="scheda-corpo">
            <p class="scheda-tipo">Trattoria · Asti</p>
            <h2 class="scheda-nome">Trattoria Rossi</h2>
            <ul class="scheda-righe">
              <li><span class="ok" aria-hidden="true">✓</span><span>Menù del giorno leggibile<small>Prezzi chiari, niente PDF da scaricare</small></span></li>
              <li><span class="ok" aria-hidden="true">✓</span><span>Aperto ora · fino alle 22:30<small>Via Cavour 12 · 3 min dal centro</small></span></li>
              <li><span class="ok" aria-hidden="true">✓</span><span>Prenota in un tocco<small>WhatsApp o telefono, a scelta tua</small></span></li>
            </ul>
            <div class="scheda-tasti" aria-hidden="true"><span class="solid">Prenota</span><span>Menù</span><span>Come arrivare</span></div>
          </div>
          <p class="scheda-nota">Esempio illustrativo, non un cliente reale.</p>
        </aside>
      </div>
    </section>
  </div>

  <div class="ticker" aria-label="Per chi lavoriamo">
    <div class="ticker-pista">
      {settori.map((s) => <span>{s}</span>)}
      {settori.map((s) => <span aria-hidden="true">{s}</span>)}
    </div>
  </div>

  <!-- 01 BENEFICI -->
  <section class="sezione" aria-labelledby="h-benefici">
    <div class="involucro">
      <Capitolo
        numero="01 · Benefici"
        titolo="Cosa cambia <em>in pratica</em>"
        nota="Niente promesse: quattro cose concrete che il sito fa per te."
      />
      <ol class="righe" id="h-benefici">
        {benefici.map((b, i) => (
          <li data-reveal>
            <span class="righe-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{b.t}</h3>
            <p>{b.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 03 SERVIZI -->
  <section class="sezione" aria-labelledby="h-servizi">
    <div class="involucro">
      <Capitolo
        numero="02 · Cosa facciamo"
        titolo="Il sito al centro, <em>il resto intorno</em>"
        nota="Parti da quello che ti serve ora. Il resto si aggiunge quando vuoi."
      />
      <div id="h-servizi">
        <article class="indice" data-reveal>
          <div class="indice-corpo">
            <h3>Sito web</h3>
            <p class="indice-meta">da <b>300 €</b> · pagina singola · <b>400 €</b> · più pagine</p>
            <p class="indice-testo">Il punto di partenza per farti trovare e contattare. <strong>Una pagina che spiega tutto</strong> o un sito completo.</p>
            <p class="indice-lista"><span class="indice-k">Inclusi</span>Testi essenziali preparati insieme a te · Telefono, WhatsApp e mappa · Foto e menu sistemati · Privacy e cookie inclusi</p>
            <p class="indice-lista indice-no"><span class="indice-k">Esclusi</span>Gergo tecnico · Ore della tua giornata · Canone obbligatorio</p>
            <a class="link-freccia" href="/servizi#sito">Il sito nel dettaglio <span class="freccia" aria-hidden="true">→</span></a>
          </div>
          <span class="indice-freccia" aria-hidden="true">→</span>
        </article>
        <article class="indice" data-reveal>
          <div class="indice-corpo">
            <h3>Grafiche</h3>
            <p class="indice-meta">solo se ti serve · <b>su preventivo</b></p>
            <p class="indice-testo"><strong>La stessa faccia ovunque</strong>: dal sito al biglietto da visita, dal menu cartaceo alla vetrina.</p>
            <p class="indice-lista"><span class="indice-k">Inclusi</span>Logo creato o rinnovato · Biglietti da visita, volantini, menu · File pronti per la stampa</p>
            <p class="indice-lista indice-no"><span class="indice-k">Esclusi</span>Restyling ogni sei mesi · Stampa di qualsiasi materiale</p>
            <p class="indice-nota">Solo design: non stampiamo niente, ti consegniamo i file da portare dove vuoi.</p>
            <a class="link-freccia" href="/servizi#grafiche">Le grafiche nel dettaglio <span class="freccia" aria-hidden="true">→</span></a>
          </div>
          <span class="indice-freccia" aria-hidden="true">→</span>
        </article>
        <article class="indice" data-reveal>
          <div class="indice-corpo">
            <h3>Social media</h3>
            <p class="indice-meta">solo se ti serve · <b>su preventivo</b></p>
            <p class="indice-testo"><strong>Profili in ordine e contenuti regolari</strong>, senza che tu debba pensarci ogni sera dopo la chiusura.</p>
            <p class="indice-lista"><span class="indice-k">Inclusi</span>Profili sistemati da zero · Foto, video e grafiche · Pubblicazioni regolari</p>
            <p class="indice-lista indice-no"><span class="indice-k">Esclusi</span>Follower comprati · Promesse di viralità</p>
            <a class="link-freccia" href="/servizi#social">I social nel dettaglio <span class="freccia" aria-hidden="true">→</span></a>
          </div>
          <span class="indice-freccia" aria-hidden="true">→</span>
        </article>
      </div>
    </div>
  </section>

  <!-- 05 METODO -->
  <section class="sezione" aria-labelledby="h-metodo">
    <div class="involucro">
      <Capitolo
        numero="04 · Come funziona"
        titolo="Tu lavori, <em>noi al resto</em>"
        nota="Cinque passi, un solo referente, zero tempo perso."
      />
      <ol class="metodo" id="h-metodo">
        <li data-reveal><h3>Raccontaci</h3><p>Due minuti col preventivo online o un messaggio su WhatsApp. Niente moduli infiniti.</p></li>
        <li data-reveal><h3>Proposta chiara</h3><p>Prezzo e tempi scritti nero su bianco, prima di iniziare. Se non ti torna, nessun problema.</p></li>
        <li data-reveal><h3>Costruiamo</h3><p>Testi insieme a te, foto tue o scattate da noi, impaginazione curata.</p></li>
        <li data-reveal><h3>Rivedi due volte</h3><p>Due giri di correzioni inclusi. Decidi tu quando è pronto.</p></li>
        <li data-reveal><h3>Online, ed è tuo</h3><p>Pubblichiamo e ti spieghiamo l’essenziale. Nessun canone obbligatorio verso di noi.</p></li>
      </ol>
    </div>
  </section>

  <!-- 04 PREZZI -->
  <section class="sezione" aria-labelledby="h-prezzi">
    <div class="involucro">
      <Capitolo
        numero="03 · Prezzi"
        titolo="Scegli da <em>dove partire</em>"
        nota="Tre modi, un solo principio: sai prima quanto spendi. Il sito resta tuo."
      />
      <div class="prezzi-griglia" id="h-prezzi" data-reveal>
        <div class="prezzo">
          <p class="prezzo-kicker">Per iniziare</p>
          <h3>Pagina singola</h3>
          <p class="prezzo-cifra">da 300 €</p>
          <p class="piano-per">Per artigiani, professionisti e botteghe che devono farsi trovare e contattare.</p>
          <ul>
            <li>Tutto l’essenziale in una pagina che scorre</li>
            <li>Telefono, WhatsApp e mappa in vista</li>
            <li>Privacy e cookie inclusi</li>
          </ul>
          <a class="link-freccia" href="/preventivo">Configura la singola →</a>
        </div>
        <div class="prezzo">
          <p class="prezzo-kicker">Il più scelto</p>
          <h3>Sito a più pagine</h3>
          <p class="prezzo-cifra">da 400 €</p>
          <p class="piano-per">Per ristoranti, B&amp;B, saloni e negozi con tanto da mostrare.</p>
          <ul>
            <li>Storia, servizi, galleria, contatti: ognuno al suo posto</li>
            <li>Menu, prenotazioni, eventi se ti servono</li>
            <li>Telefono, WhatsApp e mappa in vista</li>
          </ul>
          <a class="link-freccia" href="/preventivo">Configura il multipagina →</a>
        </div>
        <div class="prezzo prezzo-evidenza">
          <p class="prezzo-kicker">Tutto incluso</p>
          <h3>Offerta</h3>
          <p class="prezzo-cifra">590 €</p>
          <p class="piano-per">Per chi vuole tutto senza pensarci.</p>
          <ul>
            <li>Sito a più pagine completo, tutti gli extra</li>
            <li>Foto scattate da noi ad Asti</li>
            <li>Logo nuovo o rinnovato</li>
            <li>5 revisioni invece di due</li>
          </ul>
          <p class="piano-no">Social e grafiche extra a parte.</p>
          <a class="link-freccia" href="/preventivo">Prendi l’offerta →</a>
        </div>
      </div>
      <div class="prezzi-riga-finale" data-reveal>
        <p class="prezzo-nota" style="margin:0">Dominio e hosting si pagano ai fornitori, al prezzo loro. A noi, nessun canone obbligatorio.</p>
        <a class="link-freccia" href="/prezzi">Tutti i dettagli in Prezzi →</a>
      </div>
    </div>
  </section>

  <!-- 06 STUDIO -->
  <section class="sezione" aria-labelledby="h-studio">
    <div class="involucro">
      <Capitolo
        numero="05 · Lo studio"
        titolo="Due persone, <em>niente call center</em>"
        nota="Parli sempre con chi costruisce il tuo sito."
      />
      <div class="persone" id="h-studio">
        <div class="persona" data-reveal>
          <h3>Albert</h3>
          <p class="persona-ruolo">Sviluppo · progetto</p>
          <p>Segue ogni progetto dall’inizio alla fine: costruisce il sito, lo pubblica e resta il tuo referente.</p>
        </div>
        <div class="persona" data-reveal>
          <h3>Gabriel</h3>
          <p class="persona-ruolo">Design · social</p>
          <p>Cura l’aspetto e i contenuti: grafiche, foto e social. Quello che si vede, lo ha visto lui prima di te.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 LAVORI -->
  <section class="sezione" id="lavori" aria-label="Lavori pubblicati">
    <div class="involucro">
      <Capitolo
        numero="06 · Lavori"
        titolo="Quello che abbiamo <em>pubblicato</em>"
        nota="Un lavoro vero e visitabile: giudichi tu."
      />
      <a class="lavoro" href="https://piketelabel.vercel.app" target="_blank" rel="noopener noreferrer" data-reveal>
        <div class="lavoro-testo">
          <p class="lavoro-kicker">Un lavoro pubblicato · etichetta musicale</p>
          <h3>Pikete Label</h3>
          <p>Sito vetrina con catalogo artisti per un’etichetta astigiana. Design, sviluppo e gestione, tutto nostro.</p>
          <span class="link-freccia">Visita il sito →</span>
        </div>
        <div class="lavoro-mock" aria-hidden="true">
          <div class="lavoro-mock-barra"><i></i><i></i><i></i><span>piketelabel.vercel.app</span></div>
          <div class="lavoro-mock-corpo">
            <span class="lm-titolo"></span>
            <span class="lm-riga"><i></i><b></b></span>
            <span class="lm-riga"><i></i><b></b></span>
            <span class="lm-riga"><i></i><b></b></span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- 07 DOMANDE -->
  <section class="sezione" aria-labelledby="h-domande">
    <div class="involucro">
      <Capitolo
        numero="07 · Domande"
        titolo="Quelle che ci fanno <em>sempre</em>"
        nota="Le risposte oneste, prima ancora di sentirci. Se ti torna, dimmi come si chiama la tua attività: al resto pensiamo noi."
      />
      <div id="h-domande"><Faq faqs={homeFaqs} /></div>
      <p style="margin:16px 0 0" data-reveal><a class="link-freccia" href="/faq">Tutte le domande →</a></p>
    </div>
  </section>

  <!-- 08 CONTATTO -->
  <section class="sezione" aria-labelledby="h-contatto">
    <div class="involucro">
      <div class="cta-finale" id="h-contatto" data-reveal>
        <p class="prezzo-kicker">Iniziamo</p>
        <h2>Cominciamo da quello che serve <em>alla tua attività.</em></h2>
        <p>Raccontaci in poche righe cosa fai. Ti rispondiamo con un’indicazione chiara sui prossimi passi.</p>
        <div class="cta-azioni">
          <a class="btn btn-mattone" href="/preventivo">Fai il preventivo</a>
          <a class="btn btn-wa" data-wa="Ciao Trebla! Ti racconto cosa fa la mia attività." target="_blank" rel="noopener noreferrer" href="#">Scrivici su WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
