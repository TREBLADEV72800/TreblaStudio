---
import LayoutPagina from '../layouts/LayoutPagina.astro';
import Hero from '../components/home/Hero.astro';
import Ticker from '../components/home/Ticker.astro';
import Benefici from '../components/home/Benefici.astro';
import Servizi from '../components/home/Servizi.astro';
import Metodo from '../components/home/Metodo.astro';
import Prezzi from '../components/home/Prezzi.astro';
import Studio from '../components/home/Studio.astro';
import Domande from '../components/home/Domande.astro';
import Contatto from '../components/home/Contatto.astro';
import { BASE_PRICES } from '../data/prezzi';

const descrizioneHome = `Studio web ad Asti: siti chiari e veloci per ristoranti, negozi e artigiani. Prezzi da ${BASE_PRICES.singola}€, senza canone obbligatorio. Preventivo in 2 minuti.`;
---

<LayoutPagina
  title="Siti web chiari per attività locali ad Asti | Trebla"
  description={descrizioneHome}
  canonical="/"
>
  <Hero />
  <Ticker />
  <Benefici />
  <Servizi />
  <Metodo />
  <Prezzi />
  <Studio />
  <Domande />
  <Contatto />
</LayoutPagina>
