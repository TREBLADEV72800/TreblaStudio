---
import { site, whatsappUrl } from '../data/site';
---

<footer class="piede">
  <div class="involucro">
    <p class="piede-marchio" aria-label="Trebla">Trebla<i>.</i></p>
    <div class="piede-riga">
      <div class="piede-contatti">
        <h2>Studio</h2>
        <p style="margin:0 0 10px">Studio indipendente ad Asti.<br />Siti web per piccole attività in Piemonte e in tutta Italia.</p>
      </div>
      <nav aria-label="Navigazione footer">
        <h2>Esplora</h2>
        <a href="/servizi">Servizi</a>
        <a href="/prezzi">Prezzi</a>
        <a href="/preventivo">Preventivo in 2 minuti</a>
        <a href="/chi-siamo">Lo studio</a>
        <a href="/faq">Domande frequenti</a>
      </nav>
      <div class="piede-contatti">
        <h2>Contatti diretti</h2>
        <p><a href={whatsappUrl('Ciao Trebla! Vorrei un sito per la mia attività, parliamone.')} target="_blank" rel="noopener noreferrer">WhatsApp · {site.phoneDisplay}</a></p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p>Asti, su appuntamento.</p>
      </div>
    </div>
    <div class="piede-fondo">
      <span>© 2026 Trebla · Asti, Piemonte</span>
      <nav aria-label="Note legali">
        <a href="/privacy">Privacy</a>
        <a href="/cookie">Cookie</a>
        <a href="/termini">Termini</a>
      </nav>
    </div>
  </div>
</footer>
